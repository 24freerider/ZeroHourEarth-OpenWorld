+/** One per-cell array of the map, slid by (dx, dy) in place. Rows and columns are walked in the order that
+never reads a cell already overwritten; cells with no source take the nearest cell that has one. */
+template <typename T>
+static void streamScrollArray(T *a, Int width, Int height, Int dx, Int dy)
+{
+	if (a == nullptr || (dx == 0 && dy == 0)) {
+		return;
+	}
+	const Int yStart = dy >= 0 ? 0 : height - 1;
+	const Int yEnd = dy >= 0 ? height : -1;
+	const Int yStep = dy >= 0 ? 1 : -1;
+	for (Int y = yStart; y != yEnd; y += yStep) {
+		Int sy = y + dy;
+		if (sy < 0) sy = 0;
+		if (sy > height - 1) sy = height - 1;
+		// a clamped source row that lies "behind" y in walk order has already been overwritten with the very
+		// value wanted (the nearest valid row), so copying from it is still right
+		T *dst = a + (size_t)y * width;
+		const T *src = a + (size_t)sy * width;
+		if (dx >= 0) {
+			for (Int x = 0; x < width; x++) {
+				Int sx = x + dx;
+				if (sx > width - 1) sx = width - 1;
+				dst[x] = src[sx];
+			}
+		} else {
+			for (Int x = width - 1; x >= 0; x--) {
+				Int sx = x + dx;
+				if (sx < 0) sx = 0;
+				dst[x] = src[sx];
+			}
+		}
+	}
+}
+
+void WorldHeightMap::streamScroll(Int dx, Int dy)
+{
+	if (m_data == nullptr || (dx == 0 && dy == 0)) {
+		return;
+	}
+	streamScrollArray(m_data, m_width, m_height, dx, dy);
+	streamScrollArray(m_tileNdxes, m_width, m_height, dx, dy);
+	streamScrollArray(m_blendTileNdxes, m_width, m_height, dx, dy);
+	streamScrollArray(m_extraBlendTileNdxes, m_width, m_height, dx, dy);
+	streamScrollArray(m_cliffInfoNdxes, m_width, m_height, dx, dy);
+	// The flip and cliff flags are bit-packed: rebuilt rather than slid. Streamed ground is never flipped.
+	clearFlipStates();
+	if (m_cellCliffState != nullptr) {
+		initCliffFlagsFromHeights();
+	}
+	recomputeSampleRange();
+}
