+//=============================================================================
+// BaseHeightMapRenderObjClass::streamTerrainChanged
+//=============================================================================
+/** GeneralsX @feature ZeroHourEarth 13/11/2026 World Exploration rewrote the height map (GXWorldStream.cpp): the
+window scrolled by a chunk, or a streamed chunk was written into it. The height range every box around "all of the
+terrain" is built from follows the map, pending dirty rectangles describe cells that have moved, and the drawn
+terrain is rebuilt whole on the next frame (the draw window is a few hundred cells a side: one frame's work). */
+//=============================================================================
+void BaseHeightMapRenderObjClass::streamTerrainChanged()
+{
+	if (m_map == nullptr) {
+		return;
+	}
+	m_minHeight = m_map->getMinSample() * MAP_HEIGHT_SCALE;
+	m_maxHeight = m_map->getMaxSample() * MAP_HEIGHT_SCALE;
+	m_numDirtyRegions = 0;
+	staticLightingChanged();
+	if (TheTacticalView) {
+		TheTacticalView->onHeightMapChanged();
+	}
+}
+
+/** GeneralsX @feature ZeroHourEarth 13/11/2026 The streamed water areas were made again (a shift, a chunk that
+came): the terrain tiles that blend softly into the water are found again - only under the water areas (`boxes`:
+x0 y0 x1 y1 world units each), a whole-map scan is ~330,000 tiles. */
+void BaseHeightMapRenderObjClass::streamWaterChanged(const Int *boxes, Int count)
+{
+	if (m_map == nullptr) {
+		return;
+	}
+	m_numShoreLineTiles = 0;
+	if (!m_shoreLineTilePositions) {
+		m_shoreLineTilePositions = NEW shoreLineTileInfo[DEFAULT_MAX_MAP_SHORELINE_TILES];
+		m_shoreLineTilePositionsSize = DEFAULT_MAX_MAP_SHORELINE_TILES;
+	}
+	if (count > 0 && TheWaterTransparency->m_transparentWaterDepth != 0 && TheGlobalData->m_showSoftWaterEdge) {
+		// every tile under a box once (boxes of neighbouring brooks overlap), then one sort, as a full scan leaves them
+		const Int border = m_map->getBorderSizeInline();
+		const Int w = m_map->getXExtent() - 1, h = m_map->getYExtent() - 1;
+		std::vector<UnsignedByte> seen((size_t)(w * h), 0);
+		for (Int k = 0; k < count; k++) {
+			const Int *b = boxes + 4 * k;
+			const Int i0 = std::max((Int)(b[0] / MAP_XY_FACTOR) + border - 1, 0), i1 = std::min((Int)(b[2] / MAP_XY_FACTOR) + border + 2, w);
+			const Int j0 = std::max((Int)(b[1] / MAP_XY_FACTOR) + border - 1, 0), j1 = std::min((Int)(b[3] / MAP_XY_FACTOR) + border + 2, h);
+			for (Int j = j0; j < j1; j++) {
+				for (Int i = i0; i < i1; i++) {
+					UnsignedByte &s = seen[(size_t)(j * w + i)];
+					if (s) continue;
+					s = 1;
+					updateShorelineTile(i, j, border, m_map);
+				}
+			}
+		}
+		const Bool xMajor = (m_map->getXExtent() - 1) > (m_map->getYExtent() - 1);
+		if (xMajor)
+			std::sort(m_shoreLineTilePositions, m_shoreLineTilePositions + m_numShoreLineTiles,
+				[](const shoreLineTileInfo &a, const shoreLineTileInfo &b) {
+					const UnsignedInt ka = ((a.m_xy & 0xffff) << 16) | ((UnsignedInt)a.m_xy >> 16);
+					const UnsignedInt kb = ((b.m_xy & 0xffff) << 16) | ((UnsignedInt)b.m_xy >> 16);
+					return ka < kb;
+				});
+		else
+			std::sort(m_shoreLineTilePositions, m_shoreLineTilePositions + m_numShoreLineTiles,
+				[](const shoreLineTileInfo &a, const shoreLineTileInfo &b) { return (UnsignedInt)a.m_xy < (UnsignedInt)b.m_xy; });
+	}
+	recordShoreLineSortInfos();
+}
+
+#if RTS_ZEROHOUR
+//=============================================================================
+// BaseHeightMapRenderObjClass::streamSetRoads
+//=============================================================================
+Int BaseHeightMapRenderObjClass::streamSetRoads(const W3DRoadStreamSegment *segments, Int count)
+{
+	if (m_roadBuffer == nullptr) {
+		return 0;
+	}
+	if (count < 0) {
+		m_roadBuffer->clearStreamRoads();
+		return 0;
+	}
+	m_roadBuffer->loadStreamRoads(segments, count);
+	return m_roadBuffer->getNumRoadSegments();
+}
+
+void BaseHeightMapRenderObjClass::streamTranslateRoads(Real dx, Real dy)
+{
+	if (m_roadBuffer != nullptr) {
+		m_roadBuffer->translateStreamRoads(dx, dy);
+	}
+}
+
+Int BaseHeightMapRenderObjClass::streamSetBridges(const W3DStreamBridge *bridges, Int count)
+{
+	if (m_bridgeBuffer == nullptr || TheTerrainLogic == nullptr || TheAI == nullptr || TheAI->pathfinder() == nullptr) {
+		return 0;
+	}
+	// the old ones: logic (and its GenericBridge object), pathfinder layer, model
+	for (Bridge *bridge = TheTerrainLogic->getFirstBridge(); bridge != nullptr; bridge = TheTerrainLogic->getFirstBridge()) {
+		const PathfindLayerEnum layer = bridge->getLayer();
+		TheTerrainLogic->deleteBridge(bridge);
+		TheAI->pathfinder()->releaseBridgeLayer(layer);
+	}
+	m_bridgeBuffer->clearAllBridges();
+	Dict props;
+	for (Int i = 0; i < count; i++) {
+		const W3DStreamBridge &b = bridges[i];
+		m_bridgeBuffer->addBridge(Vector3(b.x1, b.y1, b.z1), Vector3(b.x2, b.y2, b.z2), AsciiString(b.name),
+			(W3DTerrainLogic *)TheTerrainLogic, &props, b.width);
+	}
+	Int standing = 0;
+	for (Bridge *bridge = TheTerrainLogic->getFirstBridge(); bridge != nullptr; bridge = bridge->getNext()) {
+		++standing;
+	}
+	return standing;
+}
+#endif
