+/** Ctrl+F9: the free camera. No ceiling on the height, no settling towards the ground, Page Up / Down tilt it
+anywhere from straight down to the horizon. Off: the game's own camera limits again. */
+void GXWorldStream::setFreeCamera(Bool on)
+{
+	if (on == m_freeCamera || TheTacticalView == nullptr) return;
+	m_freeCamera = on;
+	if (on) {
+		m_savedMaxCameraHeight = TheGlobalData->m_maxCameraHeight;
+		m_savedEnforceMaxHeight = TheGlobalData->m_enforceMaxCameraHeight;
+		m_savedZoomLimited = TheTacticalView->isZoomLimited();
+		TheWritableGlobalData->m_maxCameraHeight = kFreeCameraMaxHeight;
+		TheWritableGlobalData->m_enforceMaxCameraHeight = FALSE;
+		TheTacticalView->setZoomLimited(FALSE);
+	} else {
+		TheWritableGlobalData->m_maxCameraHeight = m_savedMaxCameraHeight;
+		TheWritableGlobalData->m_enforceMaxCameraHeight = m_savedEnforceMaxHeight;
+		TheTacticalView->setZoomLimited(m_savedZoomLimited);
+		TheTacticalView->setPitchToDefault();
+	}
+	TheTacticalView->setCameraHeightAboveGroundLimitsToDefault();
+	TheTacticalView->setFreeCamera(on);
+	// the test vehicle: the free camera stays locked on it (free height and tilt around the car); turned off, the camera
+	// is put back on the car too. (Scrolling away still lets it go: the window then follows the camera.)
+	Object *vehicle = findVehicle();
+	if (vehicle != nullptr && m_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE && m_settings.followCamera) {
+		TheTacticalView->lookAt(vehicle->getPosition());
+		TheTacticalView->setCameraLock(vehicle->getID());
+	}
+	wsLog("free camera %s", on ? "ON" : "off");
+}
+
+/** DRIVING WITH THE ARROWS (GXWorldSettings::keyDriving, the camera locked on the Humvee), relative to the car as in a
+racing game, not to the screen. The car is driven directly, frame by frame - speed along its heading, gas, brake,
+reverse, coasting to a stop, steering that bites with speed (mirrored in reverse) - and stopped by anything solid a
+bumper's length ahead. No AI orders while driving: move orders made the steering late and kept resetting the turret
+(and the command bar); this way the AI stays idle, the turret takes its own targets and fires, the shop stays. Once
+the car stands and no arrow is held, the mouse orders it again. */
+void GXWorldStream::driveWithKeys()
+{
+	Object *vehicle = findVehicle();
+	if (vehicle == nullptr || !m_settings.keyDriving || !followingVehicle() || vehicle->getAIUpdateInterface() == nullptr) {
+		m_keyDriving = m_reversing = FALSE;
+		m_driveSpeed = 0.0f;
+		return;
+	}
+	Bool up = GXWorldKeyDown(GXKEY_UP), down = GXWorldKeyDown(GXKEY_DOWN);
+	Bool left = GXWorldKeyDown(GXKEY_LEFT), right = GXWorldKeyDown(GXKEY_RIGHT);
+	// ZHE_TESTARROWS=1: a test aid - Up held from 22 s to 34 s of the game, Left too from 27 s to 29 s (nobody at the keys)
+	static const Bool s_testArrows = getenv("ZHE_TESTARROWS") != nullptr && getenv("ZHE_TESTARROWS")[0] == '1';
+	if (s_testArrows) {
+		const UnsignedInt s = TheGameLogic->getFrame() / LOGICFRAMES_PER_SECOND;
+		up = up || (s >= 22 && s < 34);
+		left = left || (s >= 27 && s < 29);
+	}
+	const Int keys = (up ? 1 : 0) | (down ? 2 : 0) | (left ? 4 : 0) | (right ? 8 : 0);
+	AIUpdateInterface *ai = vehicle->getAIUpdateInterface();
+	const UnsignedInt frame = TheGameLogic->getFrame();
+	// the car keeps the Humvee's own top speed (its locomotor's)
+	Real ownTop = 1.6f;
+	if (ai->getCurLocomotor() != nullptr) {
+		const Real s = ai->getCurLocomotor()->getMaxSpeedForCondition(BODY_PRISTINE);
+		if (s > 0.1f) ownTop = s > 10.0f ? s / LOGICFRAMES_PER_SECOND : s;		// per frame (the INI's per second, read)
+	}
+	// a car of its own: speed along the heading, gas / brake / reverse, coasting, steering that bites with speed
+	const Real kTop = ownTop;																// units per logic frame
+	const Real kReverseTop = ownTop * 0.5f;
+	const Real kGas = 0.07f, kBrake = 0.16f, kDrag = 0.035f;			// per frame
+	const Real kTurn = 0.055f;															// rad per frame at full speed
+	const Real steer = (left ? 1.0f : 0.0f) - (right ? 1.0f : 0.0f);
+	Real v = m_driveSpeed;
+	if (keys == 0 && !m_keyDriving) return;				// the mouse drives
+	if (!m_keyDriving) {
+		// the arrows take over: what the AI was doing with it stops (once - no orders while driving, so the turret
+		// keeps its own targets and the command bar stays)
+		ai->aiIdle(CMD_FROM_AI);
+		v = 0.0f;
+		m_keyDriving = TRUE;
+	}
+	if (up && !down) v = v < 0.0f ? v + kBrake : v + kGas;
+	else if (down && !up) v = v > 0.0f ? v - kBrake : v - kGas * 0.7f;
+	else v = v > 0.0f ? (v - kDrag > 0.0f ? v - kDrag : 0.0f) : (v + kDrag < 0.0f ? v + kDrag : 0.0f);
+	if (v > kTop) v = kTop;
+	if (v < -kReverseTop) v = -kReverseTop;
+	// a deselection while driving is logged (to find what does it), the selection is left alone
+	{
+		const Bool selected = vehicle->getDrawable() != nullptr && vehicle->getDrawable()->isSelected();
+		if (m_driveWasSelected && !selected) {
+			wsLog("the Humvee was deselected while driving (keys %d, speed %.2f, %d selected)", keys, v,
+				TheInGameUI != nullptr ? TheInGameUI->getSelectCount() : -1);
+		}
+		m_driveWasSelected = selected;
+	}
+	// THE TURRET: no AI order moves the car, so the Humvee is given the game's own attack order on the nearest living
+	// enemy in its weapon's reach - the order a click gives, which turns the turret and fires (a target set on the
+	// turret alone fired, but the turret was never drawn turned). The order stands while the target lives and is in
+	// reach (a new order every time would restart the aiming); out of reach or dead, the next one, or none.
+	if (frame - m_turretAimFrame >= 10 && ThePartitionManager != nullptr) {
+		m_turretAimFrame = frame;
+		const WhichTurretType tur = ai->getWhichTurretForCurWeapon();
+		const Weapon *weapon = vehicle->getCurrentWeapon();
+		if (weapon != nullptr) {
+			const Real range = weapon->getAttackRange(vehicle);
+			Object *current = TheGameLogic->findObjectByID(m_turretTarget);
+			Bool keep = FALSE;
+			if (current != nullptr && !current->isEffectivelyDead()) {
+				const Real dx = current->getPosition()->x - vehicle->getPosition()->x, dy = current->getPosition()->y - vehicle->getPosition()->y;
+				keep = dx * dx + dy * dy <= range * range;
+			}
+			if (!keep) {
+				PartitionFilterRelationship enemies(vehicle, PartitionFilterRelationship::ALLOW_ENEMIES);
+				PartitionFilterAlive living;
+				PartitionFilter *filters[] = { &enemies, &living, nullptr };
+				Object *target = ThePartitionManager->getClosestObject(vehicle, range, FROM_CENTER_2D, filters);
+				if (target != nullptr) {
+					ai->aiAttackObject(target, NO_MAX_SHOTS_LIMIT, CMD_FROM_AI);
+				} else if (m_turretTarget != INVALID_ID) {
+					ai->aiIdle(CMD_FROM_AI);		// nothing in reach: the attack is called off
+				}
+				m_turretTarget = target != nullptr ? target->getID() : INVALID_ID;
+			}
+			// [TURRET] once a second while arrow-driving: the turret in logic (W3DModelDraw's [TURRETDRAW] has it as drawn)
+			if (frame % 30 == 0) {
+				Real ta = 0.0f, tp = 0.0f;
+				Object *now = nullptr;
+				if (tur != TURRET_INVALID) {
+					ai->getTurretRotAndPitch(tur, &ta, &tp);
+					now = ai->getTurretTargetObject(tur, FALSE);
+				}
+				wsLog("[TURRET] frame %u: slot %d, ours %u, turret's %u, logic angle %.2f, hull %.2f, speed %.2f, ai state %d",
+					frame, (Int)tur, (UnsignedInt)m_turretTarget, now != nullptr ? (UnsignedInt)now->getID() : 0u, ta,
+					vehicle->getOrientation(), v, (Int)ai->getAIStateType());
+			}
+		}
+	}
+	// steering: a car turns as it rolls (reversing, the other way round); standing, a slow turn on the spot
+	const Real roll = fabsf(v) / kTop;
+	const Real bite = roll > 0.05f ? (roll < 0.35f ? roll / 0.35f : 1.0f) : 0.25f;
+	Real angle = vehicle->getOrientation() + steer * kTurn * bite * (v < -0.01f ? -1.0f : 1.0f);
+	Coord3D pos = *vehicle->getPosition();
+	Coord3D next = pos;
+	next.x += cosf(angle) * v;
+	next.y += sinf(angle) * v;
+	// whatever is a bumper's length ahead (or behind) must be passable: a wall, a house, deep water stops the car -
+	// a slope does not, however steep (the pathfinder's cliffs are hills the Humvee climbs)
+	if (fabsf(v) > 0.001f) {
+		const Real dir = v > 0.0f ? 1.0f : -1.0f;
+		Coord3D probe = next;
+		probe.x += cosf(angle) * 22.0f * dir;
+		probe.y += sinf(angle) * 22.0f * dir;
+		PathfindCell *cell = TheAI != nullptr && TheAI->pathfinder() != nullptr ? TheAI->pathfinder()->getClippedCell(LAYER_GROUND, &probe) : nullptr;
+		const Int type = cell != nullptr ? (Int)cell->getType() : -1;
+		if (type != PathfindCell::CELL_CLEAR && type != PathfindCell::CELL_RUBBLE && type != PathfindCell::CELL_CLIFF) {
+			v = 0.0f;
+			next = pos;
+		}
+	}
+	m_driveSpeed = v;
+	if (keys == 0 && v == 0.0f) {						// stopped and let go: the mouse may order it again
+		m_keyDriving = FALSE;
+		return;
+	}
+	vehicle->setOrientation(angle);
+	if (next.x != pos.x || next.y != pos.y) {
+		next.z = TheTerrainLogic->getGroundHeight(next.x, next.y);
+		vehicle->setPosition(&next);
+		if (TheAI != nullptr && TheAI->pathfinder() != nullptr) TheAI->pathfinder()->updatePos(vehicle, &next);
+	}
+}
+
+void GXWorldStream::handleKeys()
+{
+	const Bool ctrl = GXWorldKeyDown(GXKEY_CTRL);
+	const Bool f9 = ctrl && GXWorldKeyDown(GXKEY_F9);
+	const Bool f10 = ctrl && GXWorldKeyDown(GXKEY_F10);
+	if (f9 && !m_keyFreeCam) setFreeCamera(!m_freeCamera);
+	if (f10 && !m_keyOverlay) {
+		m_settings.debugOverlay = !m_settings.debugOverlay;
+		wsLog("debug overlay %s", m_settings.debugOverlay ? "ON" : "off");
+	}
+	m_keyFreeCam = f9;
+	m_keyOverlay = f10;
+	if (m_freeCamera && TheTacticalView != nullptr && !ctrl) {
+		const Real step = 1.5f * 3.14159265f / 180.0f;
+		if (GXWorldKeyDown(GXKEY_PAGE_UP)) TheTacticalView->setPitch(TheTacticalView->getPitch() + step);
+		if (GXWorldKeyDown(GXKEY_PAGE_DOWN)) TheTacticalView->setPitch(TheTacticalView->getPitch() - step);
+	}
+}
+
+void GXWorldStream::onMapLoaded()
+{
+	pump();
+	m_active = FALSE;
+	if (m_state != STATE_SESSION_READY || !m_hasSession) return;
+	if (strstr(TheGlobalData->m_mapName.str(), "WorldExploration") == nullptr &&
+			strstr(TheGlobalData->m_mapName.str(), "worldexploration") == nullptr) return;
+	WorldHeightMap *map = TheTerrainVisual != nullptr ? TheTerrainVisual->getLogicHeightMap() : nullptr;
+	if (map == nullptr || map->getXExtent() != m_window * m_n || map->getYExtent() != m_window * m_n) {
+		wsLog("the base map is %dx%d, the session needs %dx%d (run worldserver/worldmap.py --window %d)",
+			map != nullptr ? map->getXExtent() : 0, map != nullptr ? map->getYExtent() : 0, m_window * m_n, m_window * m_n, m_window);
+		return;
+	}
+	const double t0 = wsNow();
+	m_classToTexture.clear();
+	m_texturePriority.clear();
+	for (size_t i = 0; i < m_groundClasses.size(); ++i) {
+		const Int tex = map->streamFindTextureClass(m_groundClasses[i].c_str());
+		if (tex < 0) wsLog("ground texture %s is not in the base map", m_groundClasses[i].c_str());
+		m_classToTexture.push_back(tex);
+		if (tex < 0) continue;
+		// which texture softens its edge over which: living cover over bare ground over paving (each one distinct)
+		static const struct { const char *name; Int priority; } kOrder[] = {
+			{ "CliffMediumType1", 10 }, { "RocksMediumType1", 20 }, { "AsphaltType1", 30 }, { "ConcreteType1", 32 },
+			{ "CobblestoneType1", 34 }, { "Cobble01", 36 }, { "WoodType1", 38 }, { "SandMediumType1", 40 },
+			{ "DirtMediumType1", 50 }, { "GrassMediumType38a", 60 }, { "GrassMediumType1", 70 }, { "GrassMediumType11", 80 },
+		};
+		Int priority = 100 + (Int)i;
+		for (size_t k = 0; k < sizeof(kOrder) / sizeof(kOrder[0]); ++k) {
+			if (m_groundClasses[i] == kOrder[k].name) priority = kOrder[k].priority;
+		}
+		if ((Int)m_texturePriority.size() <= tex) m_texturePriority.resize((size_t)tex + 1, -1);
+		m_texturePriority[(size_t)tex] = priority;
+	}
+	m_createQueue.clear();
+	Int applied = 0;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		c->applied = FALSE;
+		c->populated = FALSE;
+		for (size_t i = 0; i < c->objects.size(); ++i) c->objects[i].created = INVALID_ID;
+		if (inWindow(c->cx, c->cy)) {
+			applyTerrain(c, map);
+			++applied;
+		}
+	}
+	map->recomputeSampleRange();
+	if (TheAI != nullptr && TheAI->pathfinder() != nullptr) TheAI->pathfinder()->invalidateTerrainCache(nullptr);
+	m_bridgeSignature.clear();
+	rebuildBridges(TRUE);		// before the pathfinder: each bridge is a layer of it
+	terrainChanged(TRUE);
+	applyWorldLook();
+	// a sandbox has no radar building: the minimap is on regardless
+	if (TheRadar != nullptr && ThePlayerList->getLocalPlayer() != nullptr) {
+		TheRadar->forceOn(ThePlayerList->getLocalPlayer()->getPlayerIndex(), TRUE);
+		// the minimap follows the camera (a window a chunk and a half smaller than the streamed one: always inside it)
+		// (the big window: about 12 chunks, ~2 km, around the camera - the whole of it would be too small to read)
+		TheRadar->setStreamView(bigWindow() ? (Real)m_window / 12.0f : (Real)m_window / ((Real)m_window - 1.4f));
+	}
+	m_active = TRUE;
+	g_gxNukeDetonated = &GXWorldStream::nukeDetonated;		// a nuke leaves a crater (addCrater)
+	m_state = STATE_RUNNING;
+	m_shifts = 0;
+	m_lastPositionFrame = 0;
+	m_haveLastFocus = FALSE;
+	m_focusHeading = m_spawnHeading;
+	const double tTerrain = wsNow();
+	rebuildRoads();
+	const double tRoads = wsNow();
+	refreshRadar();
+	const double tRadar = wsNow();
+
+	// the camera: the window moves under it, so it may go anywhere
+	if (TheTacticalView != nullptr) {
+		TheTacticalView->setCameraAreaConstraintsEnabled(FALSE);
+		if (m_settings.wireframe) TheTacticalView->set3DWireFrameMode(TRUE);
+	}
+	m_vehicleID = INVALID_ID;
+	Object *unit = nullptr;
+	if (m_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE) {
+		unit = spawnUnit(kVehicle, m_spawnHeading);
+		if (unit != nullptr) m_vehicleID = unit->getID();
+	} else {
+		unit = spawnUnit(kScout, m_spawnHeading);
+	}
+	if (TheTacticalView != nullptr && unit != nullptr) {
+		TheTacticalView->lookAt(unit->getPosition());
+		if (m_vehicleID != INVALID_ID && m_settings.followCamera) TheTacticalView->setCameraLock(m_vehicleID);
+	}
+	zombieStart();
+	// The game start puts the camera at the player's maximum height after this (thousands of units with a raised
+	// limit): a few frames into the game it is brought down to the spawn, once.
+	m_cameraFrames = 5;
+
+	// the town: nearest chunks first, all of it (the big window: all of it near the camera) before the load screen lifts
+	const Int mid = m_window / 2;
+	const Int townRing = bigWindow() ? kObjectRing : mid;
+	for (Int ring = 0; ring <= townRing; ++ring) {
+		for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+			Chunk *c = it->second;
+			const Int dx = c->cx - (m_winCx + mid), dy = c->cy - (m_winCy + mid);
+			const Int d = (dx < 0 ? -dx : dx) > (dy < 0 ? -dy : dy) ? (dx < 0 ? -dx : dx) : (dy < 0 ? -dy : dy);
+			if (d == ring && c->applied) populate(c);
+		}
+	}
+	m_focusCx = m_focusCy = mid;
+	m_pathsDirty = FALSE;
+	const Int queued = (Int)m_createQueue.size();
+	createQueued(1 << 30);
+	rebuildTrees();
+	requestAround(kPrefetchRing);
+	wsLog("world applied: %d chunks, %d objects, %d road pieces (%d in the buffer), %d/%d bridges, %d water areas (%.1f ms), "
+		"%d of %d trees (%.1f ms), %s mode, %.0f ms (terrain %.0f, roads %.0f, radar %.0f)",
+		applied, queued, m_roadPieces, m_roadSegments, m_bridges, m_bridgeCandidates, (Int)m_waterTriggers.size(), m_lastWaterMs,
+		m_treesDrawn, m_treesInWindow, m_lastTreeMs,
+		m_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE ? "vehicle" : "free camera",
+		(wsNow() - t0) * 1000.0, (tTerrain - t0) * 1000.0, (tRoads - tTerrain) * 1000.0, (tRadar - tRoads) * 1000.0);
+}
+
+/** DARKNESS. The scene's lights (terrain and objects, the map's time of day) are scaled down, from as they are at 0
+to a readable dusk at 100 - a quarter of the light, a little blue. The terrain is lit from these lights whenever it is
+drawn again, so the chunks that come later are as dark; the HUD has its own light and keeps it.
+THE FOG. Revealed: the whole map for good (the old way). Grey: every cell fogged once - the player sees units only near
+his own, the ground everywhere. Black: the game's own shroud - never seen is black, seen before is fogged; a shift
+slides what was explored with the ground (PartitionManager::gxShiftShroud). */
+void GXWorldStream::applyWorldLook()
+{
+	Player *local = ThePlayerList != nullptr ? ThePlayerList->getLocalPlayer() : nullptr;
+	if (ThePartitionManager != nullptr && local != nullptr) {
+		const Int p = local->getPlayerIndex();
+		if (m_settings.worldView == GXWorldSettings::VIEW_GREY) ThePartitionManager->revealMapForPlayer(p);
+		else if (m_settings.worldView == GXWorldSettings::VIEW_BLACK) ThePartitionManager->shroudMapForPlayer(p);
+		else ThePartitionManager->revealMapForPlayerPermanently(p);
+	}
+	m_lightSaved = FALSE;
+	// the darkness is a veil over the drawn world (drawOverlay), not the scene's lights any more: dimmed lights left
+	// the buildings black on a bright ground and went wrong when the world shifted
+	if (TheWritableGlobalData == nullptr || TRUE) return;
+	const TimeOfDay tod = TheGlobalData->m_timeOfDay;
+	const Real d = (Real)(m_settings.darkness > 100 ? 100 : m_settings.darkness) / 100.0f;
+	const Real k = 1.0f - 0.75f * d;					// 100 %: a quarter of the light
+	const Real blue = 1.0f + 0.25f * d;				// ... a little bluer (moonlight)
+	for (Int i = 0; i < MAX_GLOBAL_LIGHTS; ++i) {
+		m_savedTerrainLight[i] = TheGlobalData->m_terrainLighting[tod][i];
+		m_savedObjectLight[i] = TheGlobalData->m_terrainObjectsLighting[tod][i];
+		GlobalData::TerrainLighting *ls[2] = { &TheWritableGlobalData->m_terrainLighting[tod][i], &TheWritableGlobalData->m_terrainObjectsLighting[tod][i] };
+		for (Int j = 0; j < 2; ++j) {
+			RGBColor *cs[2] = { &ls[j]->ambient, &ls[j]->diffuse };
+			for (Int c = 0; c < 2; ++c) {
+				cs[c]->red *= k;
+				cs[c]->green *= k;
+				cs[c]->blue = cs[c]->blue * k * blue > 1.0f ? 1.0f : cs[c]->blue * k * blue;
+			}
+		}
+	}
+	m_lightSaved = TRUE;
+	if (TheDisplay != nullptr) TheDisplay->setTimeOfDay(tod);
+	wsLog("darkness %d%%: the scene's light x%.2f", m_settings.darkness, k);
+}
+
+void GXWorldStream::restoreLighting()
+{
+	if (!m_lightSaved || TheWritableGlobalData == nullptr) return;
+	m_lightSaved = FALSE;
+	const TimeOfDay tod = TheGlobalData->m_timeOfDay;
+	for (Int i = 0; i < MAX_GLOBAL_LIGHTS; ++i) {
+		TheWritableGlobalData->m_terrainLighting[tod][i] = m_savedTerrainLight[i];
+		TheWritableGlobalData->m_terrainObjectsLighting[tod][i] = m_savedObjectLight[i];
+	}
+	if (TheDisplay != nullptr) TheDisplay->setTimeOfDay(tod);
+}
+
+/* ZOMBIES. The zombie run (Zero Hour Earth's continuous zombie survival, continuous_rules.py, on the streamed world):
+	- the horde's pace: phase 0 is the preparation (11 s), then a phase every 45 s of simulation time; the gap between
+	  two zombies follows the original bands from phases 1, 3, 6, 10 and 16; the type is drawn by the phase's tier mix;
+	  Bomb Trucks are queued on entering phases 5, 10 ... 40 (1, 2, then 3) and take the same gate; infantry goes on
+	  past 40. One zombie at a time: a full limit or no place to come out of puts the gate off - it never catches up.
+	- they come out of houses: a house 40 to 120 m from the Humvee (game objects of the town, near the camera), on its
+	  side away from the Humvee, off the screen if any is; the point must be clear ground with a clear run out. A house
+	  holds 3 to 8 zombies (by its world id: always the same), and once it is empty it stays empty for the whole run -
+	  driving away and back does not fill it again. A house rests a few seconds between two zombies.
+	- every zombie has a record (house, type, alive / parked / gone): parked outside the window it still counts, and
+	  comes back as itself; one parked more than 3 km from the Humvee for a minute is taken away (no reward), and its
+	  house gets it back. The run's living zombies never pass GXWorldSettings::zombieCap.
+	- a kill is a zombie that dies by a hit of the player's (its last damage came from him): counted once, and paid -
+	  2 for an ordinary zombie (GLAInfantryTerrorist), the others by their build cost against it.
+	- the Humvee destroyed ends the run. */
+static const Real kZombieNear = 160.0f, kZombieFar = 480.0f;		// 40 to 120 m (4 units = 1 m)
+static const Real kZombieAreaRadius = 4000.0f;										// "in the area": 1 km around the Humvee
+static const Real kZombieRemoveDistance = 12000.0f;							// parked 3 km away ...
+static const UnsignedInt kZombieRemoveFrames = 60 * LOGICFRAMES_PER_SECOND;	// ... for a minute: taken away
+static const UnsignedInt kZombieHouseRest = 4 * LOGICFRAMES_PER_SECOND;
+static const UnsignedInt kZombieHuntFrames = 3 * LOGICFRAMES_PER_SECOND;	// the original TEAM_HUNT every 3 s
+static const UnsignedInt kZombieRunOut = 2 * LOGICFRAMES_PER_SECOND;			// out of the house first, then the hunt
+static const Int kZombieStartMoney = 500;
+static const char *const kZombieTypes[7] = { "Demo_GLAInfantryTerrorist", "GLAInfantryTerrorist", "Slth_GLAInfantryTerrorist",
+	"Chem_GLAInfantryTerrorist", "CINE_GLAInfantryTerrorist", "GC_Slth_GLAInfantryTerrorist", "GC_Chem_GLAInfantryTerrorist" };
+static const struct { Int phase; Int w[7]; } kZombieMix[6] = {
+	{ 1, { 100, 0, 0, 0, 0, 0, 0 } }, { 4, { 70, 30, 0, 0, 0, 0, 0 } }, { 7, { 50, 30, 20, 0, 0, 0, 0 } },
+	{ 10, { 40, 25, 20, 10, 5, 0, 0 } }, { 13, { 35, 25, 15, 12, 8, 5, 0 } }, { 16, { 30, 22, 15, 13, 10, 7, 3 } } };
+static const char *const kZombieTruck = "GLAVehicleBombTruck";
+static const char *const kZombieOrdinary = "GLAInfantryTerrorist";
+
+static Int zombiePhaseAt(Real seconds)
+{
+	const Real first = 11.0f;			// grace 10 s + the legacy first timer's second
+	return seconds < first ? 0 : 1 + (Int)((seconds - first) / 45.0f);
+}
+
+/// Logic frames between two zombies in this phase (continuous_rules.spawn_gap_ticks; 30 ticks a second, as the game).
+static UnsignedInt zombieGapFrames(Int phase)
+{
+	static const Int bands[5] = { 1, 3, 6, 10, 16 };
+	Int band = 1;
+	for (Int i = 0; i < 5; ++i) if (bands[i] <= phase) band = bands[i];
+	const Real size = 12.0f, growth = 6.0f, interval = 45.0f, rateLimit = 2.0f;
+	Real rate = (size + (band - 1) * (growth + size / 10.0f)) / interval;
+	if (rate < 0.2f) rate = 0.2f;
+	if (rate > rateLimit) rate = rateLimit;
+	return (UnsignedInt)ceilf(30.0f / rate);
+}
+
+static unsigned long long zombieHash(unsigned long long v)
+{
+	v ^= v >> 33; v *= 0xff51afd7ed558ccdULL; v ^= v >> 33; v *= 0xc4ceb9fe1a85ec53ULL; v ^= v >> 33;
+	return v;
+}
+
+GXWorldStream::HouseBudget &GXWorldStream::houseBudget(unsigned long long id)
+{
+	std::map<unsigned long long, HouseBudget>::iterator it = m_houses.find(id);
+	if (it == m_houses.end()) {
+		HouseBudget b;
+		b.left = 3 + (Int)(zombieHash(id) % 6ULL);		// 3 .. 8, the same for this house every time
+		b.lastFrame = 0;
+		it = m_houses.insert(std::make_pair(id, b)).first;
+	}
+	return it->second;
+}
+
+Int GXWorldStream::zombieReward(const std::string &tmpl)
+{
+	// 2 for the ordinary one; the others by their build cost against it (the original paid a share of the cost)
+	const ThingTemplate *t = TheThingFactory->findTemplate(AsciiString(tmpl.c_str()), FALSE);
+	const ThingTemplate *o = TheThingFactory->findTemplate(AsciiString(kZombieOrdinary), FALSE);
+	Player *zombies = ThePlayerList->findPlayerWithNameKey(NAMEKEY("Zombies"));
+	if (t == nullptr || o == nullptr || zombies == nullptr) return 2;
+	const Int ordinary = o->calcCostToBuild(zombies), cost = t->calcCostToBuild(zombies);
+	if (ordinary <= 0) return 2;
+	const Int r = (Int)floorf(2.0f * (Real)cost / (Real)ordinary + 0.5f);
+	return r < 1 ? 1 : r;
+}
+
+void GXWorldStream::zombieStart()
+{
+	m_zActive = FALSE;
+	m_zOver = FALSE;
+	m_zombies.clear();
+	m_zByObject.clear();
+	m_houses.clear();
+	m_zPhase = m_zTrucks = m_zKills = m_zMoney = m_zAlive = 0;
+	m_zNearLeft = m_zNearHouses = 0;
+	m_zEndFrame = 0;
+	if (!m_settings.zombies()) return;
+	Player *zombies = ThePlayerList->findPlayerWithNameKey(NAMEKEY("Zombies"));
+	Player *local = ThePlayerList->getLocalPlayer();
+	if (zombies == nullptr || local == nullptr) {
+		wsLog("zombie run: the base map has no Zombies side (it is not the Z variant): no zombies");
+		return;
+	}
+	// the run starts with 500 (the player buys infantry and upgrades from the Humvee)
+	Money *money = local->getMoney();
+	if (money != nullptr) {
+		money->withdraw(money->countMoney(), FALSE);
+		money->deposit(kZombieStartMoney, FALSE, FALSE);
+	}
+	m_zActive = TRUE;
+	m_zStartFrame = TheGameLogic->getFrame();
+	m_zNextFrame = m_zStartFrame;
+	m_zLastHunt = m_zLastCount = m_zStartFrame;
+	m_zRoll = (UnsignedInt)(zombieHash((unsigned long long)m_spawnX * 31ULL + (unsigned long long)m_spawnY) & 0xFFFFFFFFu);
+	wsLog("zombie run: started, limit %d alive, %d to start", m_settings.zombieCap, kZombieStartMoney);
+}
+
+/** One zombie (or a Bomb Truck) out of a house near the Humvee; FALSE when no house has a place now. */
+Bool GXWorldStream::zombieSpawn(Bool truck)
+{
+	Object *humvee = findVehicle();
+	Player *zombies = ThePlayerList->findPlayerWithNameKey(NAMEKEY("Zombies"));
+	if (humvee == nullptr || zombies == nullptr || TheAI == nullptr || TheAI->pathfinder() == nullptr) return FALSE;
+	// the type: the phase's mix (a pseudo-random roll, as the original's counter that jumps by 37 every frame)
+	std::string tmplName = truck ? kZombieTruck : kZombieOrdinary;
+	if (!truck) {
+		Int mix = 0;
+		for (Int i = 0; i < 6; ++i) if (kZombieMix[i].phase <= m_zPhase) mix = i;
+		m_zRoll = m_zRoll * 1664525u + 1013904223u;
+		Int roll = (Int)((m_zRoll >> 8) % 100u);
+		for (Int t = 0; t < 7; ++t) {
+			if (roll < kZombieMix[mix].w[t]) { tmplName = kZombieTypes[t]; break; }
+			roll -= kZombieMix[mix].w[t];
+		}
+	}
+	const ThingTemplate *tmpl = TheThingFactory->findTemplate(AsciiString(tmplName.c_str()), FALSE);
+	if (tmpl == nullptr) {
+		tmplName = kZombieOrdinary;		// a type the build does not have
+		tmpl = TheThingFactory->findTemplate(AsciiString(tmplName.c_str()), FALSE);
+		if (tmpl == nullptr) return FALSE;
+	}
+	const Coord3D hp = *humvee->getPosition();
+	const UnsignedInt frame = TheGameLogic->getFrame();
+	Pathfinder *pf = TheAI->pathfinder();
+	auto clearAt = [&](Real x, Real y) {
+		Coord3D p; p.x = x; p.y = y; p.z = 0.0f;
+		PathfindCell *cell = pf->getClippedCell(LAYER_GROUND, &p);
+		return cell != nullptr && cell->getType() == PathfindCell::CELL_CLEAR;
+	};
+	// the candidates: every face of every house in reach, scored (lower is better)
+	struct Cand { Real score; Coord3D at; Coord3D out; unsigned long long house; };
+	std::vector<Cand> cands;
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		if (!c->populated || !inWindow(c->cx, c->cy)) continue;
+		const Real ox = (c->cx - m_winCx) * chunkUnits, oy = (c->cy - m_winCy) * chunkUnits;
+		if (ox + chunkUnits < hp.x - kZombieFar || ox > hp.x + kZombieFar || oy + chunkUnits < hp.y - kZombieFar || oy > hp.y + kZombieFar) continue;
+		for (size_t i = 0; i < c->objects.size(); ++i) {
+			const ChunkObject &o = c->objects[i];
+			if (o.kind != KIND_BUILDING || o.created == INVALID_ID) continue;
+			const Real dx = ox + o.x - hp.x, dy = oy + o.y - hp.y;
+			const Real d = sqrtf(dx * dx + dy * dy);
+			if (d < kZombieNear || d > kZombieFar) continue;
+			HouseBudget &b = houseBudget(o.id);
+			if (b.left <= 0 || (b.lastFrame != 0 && frame - b.lastFrame < kZombieHouseRest)) continue;
+			Object *house = TheGameLogic->findObjectByID(o.created);
+			if (house == nullptr || house->isEffectivelyDead() || !house->isKindOf(KINDOF_STRUCTURE)) continue;
+			const GeometryInfo &g = house->getGeometryInfo();
+			const Real a = house->getOrientation(), ca = cosf(a), sa = sinf(a);
+			const Real major = g.getMajorRadius(), minor = g.getGeomType() == GEOMETRY_BOX ? g.getMinorRadius() : g.getMajorRadius();
+			const Coord3D &c0 = *house->getPosition();
+			// the four faces: the middle of each, a step outside
+			const Real fx[4] = { ca, -ca, -sa, sa }, fy[4] = { sa, -sa, ca, -ca }, half[4] = { major, major, minor, minor };
+			const Bool onScreen = [&]() {
+				ICoord2D s;
+				return TheTacticalView != nullptr && TheTacticalView->worldToScreenTriReturn(&c0, &s) == View::WTS_INSIDE_FRUSTUM;
+			}();
+			for (Int f = 0; f < 4; ++f) {
+				const Real step = truck ? 30.0f : 12.0f;
+				Coord3D at;
+				at.x = c0.x + fx[f] * (half[f] + step);
+				at.y = c0.y + fy[f] * (half[f] + step);
+				// clear ground there and on the run out (a Bomb Truck: a road's width of it)
+				Bool ok = clearAt(at.x, at.y) && clearAt(at.x + fx[f] * 30.0f, at.y + fy[f] * 30.0f) && clearAt(at.x + fx[f] * 60.0f, at.y + fy[f] * 60.0f);
+				if (ok && truck) {
+					ok = clearAt(at.x - fy[f] * 15.0f, at.y + fx[f] * 15.0f) && clearAt(at.x + fy[f] * 15.0f, at.y - fx[f] * 15.0f) &&
+						clearAt(at.x + fx[f] * 90.0f, at.y + fy[f] * 90.0f);
+				}
+				if (!ok) continue;
+				// away from the Humvee is better (out of its sight behind the house), off the screen is better still
+				const Real facing = (fx[f] * dx + fy[f] * dy) / (d > 1.0f ? d : 1.0f);		// +1: the face looks away
+				Cand cand;
+				cand.score = (onScreen ? 400.0f : 0.0f) - facing * 150.0f + fabsf(d - 300.0f) * 0.5f +
+					(Real)((zombieHash(o.id ^ (unsigned long long)frame) & 63ULL));
+				cand.at = at;
+				cand.at.z = TheTerrainLogic->getGroundHeight(at.x, at.y);
+				cand.out.x = at.x + fx[f] * 80.0f;
+				cand.out.y = at.y + fy[f] * 80.0f;
+				cand.out.z = TheTerrainLogic->getGroundHeight(cand.out.x, cand.out.y);
+				cand.house = o.id;
+				cands.push_back(cand);
+			}
+		}
+	}
+	if (cands.empty()) return FALSE;
+	size_t best = 0;
+	for (size_t i = 1; i < cands.size(); ++i) if (cands[i].score < cands[best].score) best = i;
+	const Cand &c = cands[best];
+	Object *z = TheThingFactory->newObject(tmpl, zombies->getDefaultTeam());
+	if (z == nullptr) return FALSE;
+	z->setOrientation(atan2f(c.out.y - c.at.y, c.out.x - c.at.x));
+	z->setPosition(&c.at);
+	zombies->getDefaultTeam()->setActive();
+	if (z->getAIUpdateInterface() != nullptr) z->getAIUpdateInterface()->aiMoveToPosition(&c.out, CMD_FROM_AI);
+	HouseBudget &b = houseBudget(c.house);
+	--b.left;
+	b.lastFrame = frame;
+	Zombie rec;
+	rec.obj = z->getID();
+	rec.house = c.house;
+	rec.tmpl = tmplName;
+	rec.state = Z_ALIVE;
+	rec.truck = truck;
+	rec.bornFrame = frame;
+	rec.farSince = 0;
+	m_zByObject[rec.obj] = (Int)m_zombies.size();
+	m_zombies.push_back(rec);
+	return TRUE;
+}
+
+/** The houses within kZombieAreaRadius of the Humvee that are in the window, and the zombies they still hold (a house
+not asked yet counts with its full 3 .. 8). */
+void GXWorldStream::zombieCountNear()
+{
+	m_zNearLeft = m_zNearHouses = 0;
+	Object *humvee = findVehicle();
+	if (humvee == nullptr) return;
+	const Coord3D hp = *humvee->getPosition();
+	const Real chunkUnits = m_n * MAP_XY_FACTOR, r2 = kZombieAreaRadius * kZombieAreaRadius;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		if (!c->applied || !inWindow(c->cx, c->cy)) continue;
+		const Real ox = (c->cx - m_winCx) * chunkUnits, oy = (c->cy - m_winCy) * chunkUnits;
+		if (ox + chunkUnits < hp.x - kZombieAreaRadius || ox > hp.x + kZombieAreaRadius ||
+				oy + chunkUnits < hp.y - kZombieAreaRadius || oy > hp.y + kZombieAreaRadius) continue;
+		for (size_t i = 0; i < c->objects.size(); ++i) {
+			const ChunkObject &o = c->objects[i];
+			if (o.kind != KIND_BUILDING || (o.flags & OBJECT_FLAG_DESTROYED)) continue;
+			const Real dx = ox + o.x - hp.x, dy = oy + o.y - hp.y;
+			if (dx * dx + dy * dy > r2) continue;
+			const Int left = houseBudget(o.id).left;
+			m_zNearLeft += left;
+			if (left > 0) ++m_zNearHouses;
+		}
+	}
+}
+
+Int GXWorldStream::zombiesNear(const Coord3D &at, Real radius)
+{
+	Int n = 0;
+	for (std::map<ObjectID, Int>::iterator it = m_zByObject.begin(); it != m_zByObject.end(); ++it) {
+		Object *z = TheGameLogic->findObjectByID(it->first);
+		if (z == nullptr || z->isEffectivelyDead()) continue;
+		const Real dx = z->getPosition()->x - at.x, dy = z->getPosition()->y - at.y;
+		if (dx * dx + dy * dy <= radius * radius) ++n;
+	}
+	return n;
+}
+
+void GXWorldStream::zombieUpdate()
+{
+	if (!m_zActive) return;
+	const UnsignedInt frame = TheGameLogic->getFrame();
+	Player *local = ThePlayerList->getLocalPlayer();
+	Object *humvee = findVehicle();
+	if (!m_zOver && humvee == nullptr) {
+		m_zOver = TRUE;
+		m_zEndFrame = frame;
+		wsLog("zombie run: the Humvee was destroyed - %d kills, phase %d, %.0f s", m_zKills, m_zPhase,
+			(Real)(frame - m_zStartFrame) / LOGICFRAMES_PER_SECOND);
+	}
+
+	// kills and deaths: a zombie in the game that is dead now (its death is seen before the object goes)
+	m_zAlive = 0;
+	for (size_t i = 0; i < m_zombies.size(); ++i) {
+		Zombie &z = m_zombies[i];
+		if (z.state == Z_PARKED) { ++m_zAlive; continue; }
+		if (z.state != Z_ALIVE) continue;
+		Object *obj = TheGameLogic->findObjectByID(z.obj);
+		if (obj != nullptr && !obj->isEffectivelyDead()) { ++m_zAlive; continue; }
+		Bool byPlayer = FALSE;
+		if (obj != nullptr && obj->getBodyModule() != nullptr && local != nullptr) {
+			const DamageInfo *last = obj->getBodyModule()->getLastDamageInfo();
+			if (last != nullptr) {
+				Object *src = TheGameLogic->findObjectByID(last->in.m_sourceID);
+				byPlayer = src != nullptr ? src->getControllingPlayer() == local :
+					(last->in.m_sourcePlayerMask & local->getPlayerMask()) != 0;
+			}
+		}
+		if (byPlayer && !m_zOver) {
+			++m_zKills;
+			const Int reward = zombieReward(z.tmpl);
+			m_zMoney += reward;
+			if (local->getMoney() != nullptr) local->getMoney()->deposit((UnsignedInt)reward, FALSE);
+		}
+		m_zByObject.erase(z.obj);
+		z.obj = INVALID_ID;
+		z.state = Z_GONE;
+	}
+
+	// a horde parked far behind: taken away after a minute (it would hold the limit), its house gets it back
+	if (humvee != nullptr) {
+		const Real chunkUnits = m_n * MAP_XY_FACTOR;
+		const double hx = (double)m_winCx * chunkUnits + humvee->getPosition()->x, hy = (double)m_winCy * chunkUnits + humvee->getPosition()->y;
+		for (size_t k = 0; k < m_parkedUnits.size();) {
+			const ParkedUnit &u = m_parkedUnits[k];
+			if (u.zombie < 0 || u.zombie >= (Int)m_zombies.size()) { ++k; continue; }
+			Zombie &z = m_zombies[(size_t)u.zombie];
+			const double dx = u.ax - hx, dy = u.ay - hy;
+			if (dx * dx + dy * dy < (double)kZombieRemoveDistance * kZombieRemoveDistance) { z.farSince = 0; ++k; continue; }
+			if (z.farSince == 0) z.farSince = frame;
+			if (frame - z.farSince < kZombieRemoveFrames) { ++k; continue; }
+			z.state = Z_GONE;
+			++houseBudget(z.house).left;
+			--m_zAlive;
+			m_parkedUnits[k] = m_parkedUnits.back();
+			m_parkedUnits.pop_back();
+		}
+	}
+
+	// every 3 s the zombies out of their houses hunt (the original TEAM_HUNT)
+	if (frame - m_zLastHunt >= kZombieHuntFrames) {
+		m_zLastHunt = frame;
+		for (size_t i = 0; i < m_zombies.size(); ++i) {
+			const Zombie &z = m_zombies[i];
+			if (z.state != Z_ALIVE || frame - z.bornFrame < kZombieRunOut) continue;
+			Object *obj = TheGameLogic->findObjectByID(z.obj);
+			if (obj != nullptr && obj->getAIUpdateInterface() != nullptr) obj->getAIUpdateInterface()->aiHunt(CMD_FROM_AI);
+		}
+	}
+	if (frame - m_zLastCount >= LOGICFRAMES_PER_SECOND) {
+		m_zLastCount = frame;
+		zombieCountNear();
+	}
+	if (m_zOver) return;
+
+	// the pace: the phase by simulation time, Bomb Trucks queued on entering phases 5 .. 40
+	const Int phase = zombiePhaseAt((Real)(frame - m_zStartFrame) / LOGICFRAMES_PER_SECOND);
+	while (m_zPhase < phase) {
+		++m_zPhase;
+		if (m_zPhase >= 5 && m_zPhase <= 40 && m_zPhase % 5 == 0) m_zTrucks += m_zPhase / 5 < 3 ? m_zPhase / 5 : 3;
+	}
+	if (m_zPhase < 1 || frame < m_zNextFrame) return;
+	// one through the gate, or the gate waits (a full limit, no house): no catching up later
+	if (m_zAlive >= m_settings.zombieCap) return;
+	const Bool truck = m_zTrucks > 0;
+	if (zombieSpawn(truck)) {
+		if (truck) --m_zTrucks;
+		++m_zAlive;
+		m_zNextFrame = frame + zombieGapFrames(m_zPhase);
+	} else {
+		m_zNextFrame = frame + LOGICFRAMES_PER_SECOND / 2;		// look again in half a second
+	}
+}
+
+void GXWorldStream::zombieEnd()
+{
+	m_zActive = FALSE;
+	m_zombies.clear();
+	m_zByObject.clear();
+	m_houses.clear();
+	for (size_t i = 0; i < m_hudLines.size(); ++i) {
+		if (TheDisplayStringManager != nullptr) TheDisplayStringManager->freeDisplayString(m_hudLines[i]);
+	}
+	m_hudLines.clear();
+}
+
+/** The run's numbers, top left under the overlay's place: phase, time, kills, money earned, the living zombies and
+the limit, and what the houses around still hold. */
+void GXWorldStream::drawZombieHud()
+{
+	if (!m_zActive || TheDisplayStringManager == nullptr || TheFontLibrary == nullptr || TheGameLogic == nullptr) return;
+	const UnsignedInt end = m_zOver ? m_zEndFrame : TheGameLogic->getFrame();
+	const Int seconds = (Int)((end - m_zStartFrame) / LOGICFRAMES_PER_SECOND);
+	UnicodeString text[3];
+	if (m_zPhase < 1 && !m_zOver) {
+		text[0].format(L"ZOMBIE RUN   preparation: %d s", 11 - seconds > 0 ? 11 - seconds : 0);
+	} else {
+		text[0].format(L"ZOMBIE RUN   phase %d   time %d:%02d   kills %d   earned $%d", m_zPhase, seconds / 60, seconds % 60, m_zKills, m_zMoney);
+	}
+	text[1].format(L"Zombies alive: %d / %d", m_zAlive, m_settings.zombieCap);
+	text[2].format(L"Left in the houses within 1 km: %d (in %d houses)", m_zNearLeft, m_zNearHouses);
+	if (m_zOver) text[2].format(L"THE HUMVEE IS DESTROYED - the run is over: %d kills, phase %d, %d:%02d", m_zKills, m_zPhase, seconds / 60, seconds % 60);
+	if (m_hudLines.empty()) {
+		GameFont *font = TheFontLibrary->getFont(AsciiString("Arial"), 14, TRUE);
+		for (Int i = 0; i < 3; ++i) {
+			DisplayString *s = TheDisplayStringManager->newDisplayString();
+			if (s == nullptr) break;
+			s->setFont(font);
+			m_hudLines.push_back(s);
+		}
+	}
+	Int y = m_settings.debugOverlay ? 140 : 40;
+	for (size_t i = 0; i < m_hudLines.size(); ++i) {
+		m_hudLines[i]->setText(text[i]);
+		m_hudLines[i]->draw(12, y, i == 2 && m_zOver ? 0xFFFF4040 : 0xFFFFE080, 0xFF000000);
+		y += 22;
+	}
+}
+
+void GXWorldStream::onGameEnded()
+{
+	if (!m_active) return;
+	// what the player destroyed stays destroyed: report before the objects are torn down with the game
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		for (size_t i = 0; i < c->objects.size(); ++i) {
+			ChunkObject &o = c->objects[i];
+			if (o.created == INVALID_ID) continue;
+			Object *obj = TheGameLogic->findObjectByID(o.created);
+			if ((obj == nullptr || obj->isEffectivelyDead()) && !(o.flags & OBJECT_FLAG_DESTROYED)) {
+				Writer w;
+				w.put<unsigned long long>(o.id);
+				sendMessage(M_DESTROYED, w.b);
+			}
+			o.created = INVALID_ID;
+		}
+	}
+	wsLog("world exploration ended after %d shift(s)", m_shifts);
+	setFreeCamera(FALSE);
+	if (TheRadar != nullptr && ThePlayerList != nullptr && ThePlayerList->getLocalPlayer() != nullptr) {
+		TheRadar->forceOn(ThePlayerList->getLocalPlayer()->getPlayerIndex(), FALSE);
+	}
+	if (TheRadar != nullptr) TheRadar->setStreamView(1.0f);
+	g_gxHorizonHaze = g_gxHorizonGround = 0;		// other maps keep the stock black past their edge
+	restoreLighting();
+	zombieEnd();
+	clearWater();
+	g_gxNukeDetonated = nullptr;
+	m_craters.clear();					// the chunks they were dug into go with dropChunks below
+	if (TheTacticalView != nullptr) {
+		TheTacticalView->setCameraAreaConstraintsEnabled(TRUE);
+		TheTacticalView->setStreamLimit(nullptr);
+		m_limitSet = FALSE;
+		m_edgeBlocked = FALSE;
+		if (m_settings.wireframe) TheTacticalView->set3DWireFrameMode(FALSE);
+	}
+	if (TheTerrainRenderObject != nullptr) {
+		TheTerrainRenderObject->streamSetRoads(nullptr, -1);	// the next map draws its own roads
+	}
+	for (size_t i = 0; i < m_overlayLines.size(); ++i) {
+		if (TheDisplayStringManager != nullptr) TheDisplayStringManager->freeDisplayString(m_overlayLines[i]);
+	}
+	m_overlayLines.clear();
+	m_active = FALSE;
+	m_vehicleID = INVALID_ID;
+	sendMessage(M_CLOSE, std::string());
+	m_hasSession = FALSE;
+	dropChunks();
+	m_state = m_connected ? STATE_READY : STATE_OFFLINE;
+	setStatus(m_connected ? L"Type a place and press Search." : L"The world server is not running.");
+}
+
+/** Move the window by (dcx, dcy) chunks - one in a small window, as many as bring the camera back to the middle in
+the big one - and everything in the game the opposite way, in one logic frame. */
+void GXWorldStream::shiftWorld(Int dcx, Int dcy)
+{
+	WorldHeightMap *map = TheTerrainVisual != nullptr ? TheTerrainVisual->getLogicHeightMap() : nullptr;
+	if (map == nullptr) return;
+	const double t0 = wsNow();
+	const Real dx = dcx * m_n * MAP_XY_FACTOR, dy = dcy * m_n * MAP_XY_FACTOR;
+
+	// 1. the ground: slide it, then write the strip that came in from the chunks already in memory
+	map->streamScroll(dcx * m_n, dcy * m_n);
+	if (TheAI != nullptr && TheAI->pathfinder() != nullptr) TheAI->pathfinder()->shiftTerrainCache(dcx * m_n, dcy * m_n);
+	const double tScroll = wsNow();
+	m_winCx += dcx;
+	m_winCy += dcy;
+	Int written = 0, missing = 0;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		if (!inWindow(c->cx, c->cy)) {
+			if (c->populated) depopulate(c);
+			c->applied = FALSE;
+		} else if (!c->applied) {
+			applyTerrain(c, map);
+			++written;
+		}
+	}
+	missing = m_window * m_window - windowChunksPresent();
+	const double tStrip = wsNow();
+
+	// 2. everything that has a position
+	Object *vehicle = findVehicle();
+	const Bool wasFollowing = followingVehicle();
+	// every unit on its way somewhere: its goal is a point of the window, which moves with the ground too (else it
+	// would keep heading for the old spot - the same place on screen, the middle of the camera)
+	std::vector<std::pair<ObjectID, Coord3D> > goals;
+	// (not a zombie: it hunts again after the shift; not a unit in a fight: its target moves with it, and a move order
+	// would call the attack off)
+	for (Object *obj = TheGameLogic->getFirstObject(); obj != nullptr; obj = obj->getNextObject()) {
+		AIUpdateInterface *ai = obj->getAIUpdateInterface();
+		if (ai != nullptr && ai->isMoving() && ai->getGoalPosition() != nullptr && !ai->isAttacking() &&
+				m_zByObject.find(obj->getID()) == m_zByObject.end()) {
+			goals.push_back(std::make_pair(obj->getID(), *ai->getGoalPosition()));
+		}
+	}
+	for (Object *obj = TheGameLogic->getFirstObject(); obj != nullptr; obj = obj->getNextObject()) {
+		Coord3D pos = *obj->getPosition();
+		pos.x -= dx;
+		pos.y -= dy;
+		obj->setPosition(&pos);
+	}
+	if (TheTacticalView != nullptr) {
+		TheTacticalView->setStreamLimit(nullptr);		// a jump by a chunk, not a step toward the edge; set again next frame
+		m_limitSet = FALSE;
+		Coord3D look = TheTacticalView->getPosition();
+		look.x -= dx;
+		look.y -= dy;
+		look.z = TheTerrainLogic->getGroundHeight(look.x, look.y);
+		TheTacticalView->lookAt(&look);
+		if (vehicle != nullptr && wasFollowing) {		// locked again only if it was (the player may have let it go)
+			TheTacticalView->setCameraLock(vehicle->getID());
+		}
+	}
+	if (m_haveLastFocus) {
+		m_lastFocus.x -= dx;
+		m_lastFocus.y -= dy;
+	}
+	// the black world: what was explored slides with the ground; laid again when the objects' looks have moved too
+	if (m_settings.worldView == GXWorldSettings::VIEW_BLACK && ThePartitionManager != nullptr && ThePlayerList->getLocalPlayer() != nullptr) {
+		ThePartitionManager->gxShiftShroud(ThePlayerList->getLocalPlayer()->getPlayerIndex(), dx, dy);
+		m_shroudReapplyAt[0] = TheGameLogic->getFrame() + 2;
+		m_shroudReapplyAt[1] = TheGameLogic->getFrame() + 20;
+	}
+
+	// 3. the bridges (their logic does not move with the objects: they are built again where they are now), the
+	// terrain picture and the pathfinder (cells moved under every object), the roads, the radar
+	const double tObjects = wsNow();
+	m_waterDirty = TRUE;		// every water area moved with the ground
+	rebuildBridges(TRUE);
+	const double tBridges = wsNow();
+	terrainChanged(TRUE);
+	m_pathsDirty = FALSE;
+	updateObjectRing();
+	for (size_t g = 0; g < goals.size(); ++g) {
+		Object *obj = TheGameLogic->findObjectByID(goals[g].first);
+		if (obj == nullptr || obj->getAIUpdateInterface() == nullptr) continue;
+		Coord3D goal = goals[g].second;
+		goal.x -= dx;
+		goal.y -= dy;
+		obj->getAIUpdateInterface()->aiMoveToPosition(&goal, CMD_FROM_AI);
+	}
+	// the zombie run: the horde the window left behind is not parked - it comes on from the window's edge (a chunk
+	// inside, out of sight that far back), and every zombie hunts again at once
+	if (m_zActive) {
+		const Real extent = m_window * m_n * MAP_XY_FACTOR, inset = m_n * MAP_XY_FACTOR;
+		for (std::map<ObjectID, Int>::iterator it = m_zByObject.begin(); it != m_zByObject.end(); ++it) {
+			Object *z = TheGameLogic->findObjectByID(it->first);
+			if (z == nullptr || z->isEffectivelyDead()) continue;
+			Coord3D p = *z->getPosition();
+			const Bool out = p.x < 0.0f || p.y < 0.0f || p.x >= extent || p.y >= extent;
+			if (out) {
+				p.x = p.x < inset ? inset : p.x > extent - inset ? extent - inset : p.x;
+				p.y = p.y < inset ? inset : p.y > extent - inset ? extent - inset : p.y;
+				p.z = TheTerrainLogic->getGroundHeight(p.x, p.y);
+				z->setPosition(&p);
+			}
+			if (z->getAIUpdateInterface() != nullptr) z->getAIUpdateInterface()->aiHunt(CMD_FROM_AI);
+		}
+	}
+	// units the window left behind are kept off the map (they would be pulled back onto it and hurt), and the ones
+	// the window came back to stand again where they stood
+	parkUnitsOutside();
+	restoreParkedUnits();
+	// the drawn roads move with the ground now; the strip that came in gets its roads a moment later
+	const double tTerrain = wsNow();
+	if (TheTerrainRenderObject != nullptr) TheTerrainRenderObject->streamTranslateRoads(-dx, -dy);
+	rebuildTrees();			// they moved with the ground, and the far ones are thinned around the new middle
+	redrawCraterScorches();	// scorch marks do not move with the ground: laid again where the craters are now
+	m_roadsDirty = TRUE;
+	m_roadDue = tTerrain + kShiftRoadDelay;
+	const double tRoads = wsNow();
+	refreshRadar();
+	const double tRadar = wsNow();
+
+	// 4. park what is far behind (kept for the way back), ask for what is ahead
+	Int parked = 0;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end();) {
+		Chunk *c = it->second;
+		if (c->cx < m_winCx - kKeepRing || c->cx >= m_winCx + m_window + kKeepRing ||
+				c->cy < m_winCy - kKeepRing || c->cy >= m_winCy + m_window + kKeepRing) {
+			it = m_chunks.erase(it);
+			parkChunk(c);
+			++parked;
+		} else {
+			++it;
+		}
+	}
+	requestAround(kPrefetchRing);
+	++m_shifts;
+	wsLog("shift %d (%+d,%+d): window at %d,%d, strip %d chunk(s) written, %d missing, %d bridge(s), %d water area(s) (%.1f ms), "
+		"%d trees (%.1f ms), memory %d + %d parked (%d parked now, %d taken back, %d asked again), %.1f ms "
+		"(scroll %.1f, strip %.1f, objects %.1f, bridges %.1f, visual %.1f, paths %.1f, roads moved %.1f, radar %.1f)",
+		m_shifts, dcx, dcy, m_winCx, m_winCy, written, missing, m_bridges, (Int)m_waterTriggers.size(), m_lastWaterMs,
+		m_treesDrawn, m_lastTreeMs,
+		(Int)m_chunks.size(), (Int)m_parked.size(), parked, m_unparked, m_rerequested, (wsNow() - t0) * 1000.0,
+		(tScroll - t0) * 1000.0, (tStrip - tScroll) * 1000.0, (tObjects - tStrip) * 1000.0, (tBridges - tObjects) * 1000.0,
+		m_lastVisualMs, m_lastPathMs, (tRoads - tTerrain) * 1000.0, (tRadar - tRoads) * 1000.0);
+}
+
+void GXWorldStream::logicUpdate()
+{
+	pump();
+	if (!m_active) return;
+	WorldHeightMap *map = TheTerrainVisual != nullptr ? TheTerrainVisual->getLogicHeightMap() : nullptr;
+	if (map == nullptr) return;
+	handleKeys();
+	driveWithKeys();
+
+	// chunks that arrived after their place came into the window (the big window: a few a frame, nearest the camera
+	// first - it fills in while the game runs)
+	Bool late = FALSE;
+	{
+		std::vector<std::pair<Int, Chunk *> > due;
+		for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+			Chunk *c = it->second;
+			if (!c->applied && inWindow(c->cx, c->cy)) due.push_back(std::make_pair(bigWindow() ? focusDistance(c) : 0, c));
+		}
+		if (bigWindow() && (Int)due.size() > kLatePerFrame) {
+			std::partial_sort(due.begin(), due.begin() + kLatePerFrame, due.end(),
+				[](const std::pair<Int, Chunk *> &a, const std::pair<Int, Chunk *> &b) { return a.first < b.first; });
+			due.resize(kLatePerFrame);
+		}
+		for (size_t k = 0; k < due.size(); ++k) {
+			Chunk *c = due[k].second;
+			applyTerrain(c, map);
+			if (!bigWindow() || due[k].first <= kObjectRing) populate(c);
+			late = TRUE;
+			if (TheAI != nullptr && TheAI->pathfinder() != nullptr) {
+				IRegion2D cells;
+				cells.lo.x = (c->cx - m_winCx) * m_n; cells.hi.x = cells.lo.x + m_n - 1;
+				cells.lo.y = (c->cy - m_winCy) * m_n; cells.hi.y = cells.lo.y + m_n - 1;
+				TheAI->pathfinder()->invalidateTerrainCache(&cells);
+			}
+		}
+	}
+	const double now = wsNow();
+	if (late) {
+		// a bridge may have come with the chunk; the pathfinder (a layer per bridge, the new ground's cells) is rebuilt
+		// a moment later, once for all the chunks coming now
+		rebuildBridges(FALSE);
+		if (!m_pathsDirty) m_pathsDue = now + (bigWindow() ? kPathDelay : 0.0);
+		m_pathsDirty = TRUE;
+	}
+	// the camera went to another chunk of the big window: the town, the roads, the trees and the bridges follow it
+	if (bigWindow()) {
+		Int fx, fy;
+		if (focusChunk(&fx, &fy) && (fx != m_focusCx || fy != m_focusCy)) {
+			updateObjectRing();
+			if (rebuildBridges(FALSE)) {
+				if (!m_pathsDirty) m_pathsDue = now;
+				m_pathsDirty = TRUE;
+			}
+			if (!m_roadsDirty) m_roadDue = now + kRoadDebounce;
+			m_roadsDirty = TRUE;
+			if (!m_treesDirty) m_treesDue = now + kRoadDebounce;
+			m_treesDirty = TRUE;
+		}
+	}
+	const Bool paths = m_pathsDirty && now >= m_pathsDue;
+	if (paths) m_pathsDirty = FALSE;
+	if (late || paths || m_terrainDirty) {
+		terrainChanged(paths);
+	}
+	if (late) {
+		if (!m_roadsDirty) m_roadDue = m_lastRoadBuild + kRoadDebounce;
+		m_roadsDirty = TRUE;
+		m_radarDirty = TRUE;
+	}
+	if (m_roadsDirty && now >= m_roadDue) rebuildRoads();
+	if (late && !m_treesDirty) {
+		m_treesDirty = TRUE;
+		m_treesDue = now + kRoadDebounce;		// several chunks often come together
+	}
+	if (m_treesDirty && now >= m_treesDue) rebuildTrees();
+	if (m_radarDirty && now - m_lastRadar >= kRadarInterval) refreshRadar();
+	if (now - m_lastRetry >= 1.0) {
+		m_lastRetry = now;
+		retryIncomplete();
+	}
+	for (Int k = 0; k < 2; ++k) {
+		if (m_shroudReapplyAt[k] != 0 && TheGameLogic->getFrame() >= m_shroudReapplyAt[k]) {
+			m_shroudReapplyAt[k] = 0;
+			if (ThePartitionManager != nullptr && ThePlayerList->getLocalPlayer() != nullptr) {
+				ThePartitionManager->gxReapplyShroud(ThePlayerList->getLocalPlayer()->getPlayerIndex());
+			}
+		}
+	}
+
+	Object *vehicle = findVehicle();
+	if (m_cameraFrames > 0 && --m_cameraFrames == 0 && TheTacticalView != nullptr) {
+		const Bool follow = vehicle != nullptr && m_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE && m_settings.followCamera;
+		if (vehicle != nullptr) TheTacticalView->lookAt(vehicle->getPosition());
+		// the wanted height AND the zoom itself: a locked camera counts as scripted movement, and the view then takes
+		// its current height (the game start's maximum) as the wanted one - it would never come down
+		const Real height = vehicle != nullptr ? kStartCameraHeight : kRtsCameraHeight;
+		TheTacticalView->setHeightAboveGround(height);
+		const Real maxHeight = TheTacticalView->getMaxHeightAboveGround();
+		if (maxHeight > 1.0f) TheTacticalView->setZoom((height < maxHeight ? height : maxHeight) / maxHeight);
+		if (follow) TheTacticalView->setCameraLock(vehicle->getID());
+		static const char *s_free = getenv("ZHE_FREECAM");
+		if (s_free != nullptr && s_free[0] == '1') setFreeCamera(TRUE);
+		// ZHE_CAMHEIGHT=<units> / ZHE_CAMPITCH=<degrees>: test aids - a far, flat look at the window's edge
+		static const char *s_camHeight = getenv("ZHE_CAMHEIGHT");
+		if (s_camHeight != nullptr && atof(s_camHeight) > 0.0) {
+			const Real wanted = (Real)atof(s_camHeight);
+			TheTacticalView->setHeightAboveGround(wanted);
+			const Real maxH = TheTacticalView->getMaxHeightAboveGround();
+			if (maxH > 1.0f) TheTacticalView->setZoom((wanted < maxH ? wanted : maxH) / maxH);
+		}
+		static const char *s_camPitch = getenv("ZHE_CAMPITCH");
+		if (s_camPitch != nullptr && atof(s_camPitch) > 0.0) TheTacticalView->setPitch((Real)atof(s_camPitch) * 3.14159265f / 180.0f);
+		// ZHE_LOOKBRIDGE=1: a test aid - the camera starts over the bridge nearest the middle of the window
+		static const char *s_lookBridge = getenv("ZHE_LOOKBRIDGE");
+		if (s_lookBridge != nullptr && s_lookBridge[0] == '1' && m_bridges > 0 && !follow) {
+			Coord3D at = m_firstBridge;
+			at.z = TheTerrainLogic->getGroundHeight(at.x, at.y);
+			TheTacticalView->lookAt(&at);
+			TheTacticalView->setHeightAboveGround(450.0f);
+			const Real maxH = TheTacticalView->getMaxHeightAboveGround();
+			if (maxH > 1.0f) TheTacticalView->setZoom(450.0f / maxH);
+		}
+	}
+
+	// ZHE_AUTOPAN=<degrees>: the camera glides that way (0 = east, 90 = north) at about 40 m/s - a test aid: the
+	// window must follow the camera with nobody at the mouse.
+	static const char *s_pan = getenv("ZHE_AUTOPAN");
+	if (s_pan != nullptr && s_pan[0] != '\0' && TheTacticalView != nullptr && m_cameraFrames == 0 &&
+			!followingVehicle()) {
+		// ZHE_AUTOPANSPEED=<units/s> (default 160); ZHE_AUTOPANBACK=<s>: turn round after that long (the way back
+		// must find the world it left)
+		static const char *s_panSpeed = getenv("ZHE_AUTOPANSPEED");
+		static const char *s_panBack = getenv("ZHE_AUTOPANBACK");
+		static UnsignedInt s_panFrames = 0;
+		++s_panFrames;
+		Real heading = (Real)atof(s_pan) * 3.14159265f / 180.0f;
+		if (s_panBack != nullptr && atof(s_panBack) > 0.0 && s_panFrames > (UnsignedInt)(atof(s_panBack) * LOGICFRAMES_PER_SECOND)) {
+			heading += 3.14159265f;
+		}
+		const Real unitsPerSecond = s_panSpeed != nullptr && atof(s_panSpeed) > 0.0 ? (Real)atof(s_panSpeed) : 160.0f;
+		const Real speed = unitsPerSecond / (Real)(Int)LOGICFRAMES_PER_SECOND;	// units per logic frame (4 units = 1 m)
+		Coord3D look = TheTacticalView->getPosition();
+		look.x += cosf(heading) * speed;
+		look.y += sinf(heading) * speed;
+		look.z = TheTerrainLogic->getGroundHeight(look.x, look.y);
+		TheTacticalView->lookAt(&look);
+	}
+
+	Coord3D focus;
+	Real heading = 0.0f;
+	if (focusPoint(&focus, &heading)) {
+		const Real chunkUnits = m_n * MAP_XY_FACTOR;
+		const Int mid = m_window / 2;
+		const Real lo = (mid - kShiftHysteresis) * chunkUnits, hi = (mid + 1 + kShiftHysteresis) * chunkUnits;
+		// a side shifts only when every chunk it brings in is in memory (else the ground there would be the old edge
+		// stretched); until then the camera is held short of it and the chunks are asked for (nearest first)
+		Bool readyE = TRUE, readyW = TRUE, readyN = TRUE, readyS = TRUE;
+		Int dcx = 0, dcy = 0;
+		if (bigWindow()) {
+			// the big window: nothing moves while the camera is more than kEdgeMargin chunks from every edge; past that,
+			// the shift brings its chunk back to the middle - once every chunk that shift brings in is in memory
+			const Int fx = REAL_TO_INT_FLOOR(focus.x / chunkUnits), fy = REAL_TO_INT_FLOOR(focus.y / chunkUnits);
+			dcx = (fx >= m_window - kEdgeMargin || fx < kEdgeMargin) ? fx - mid : 0;
+			dcy = (fy >= m_window - kEdgeMargin || fy < kEdgeMargin) ? fy - mid : 0;
+			if (m_zActive && (dcx != 0 || dcy != 0)) {
+				// the zombie run: a shorter step (more of the horde stays in the window), and none in a fight - while
+				// zombies are close the shift waits, unless the camera is right at the edge
+				const Int step = kZombieShiftStep;
+				dcx = dcx > step ? step : dcx < -step ? -step : dcx;
+				dcy = dcy > step ? step : dcy < -step ? -step : dcy;
+				const Bool atEdge = fx < 2 || fy < 2 || fx >= m_window - 2 || fy >= m_window - 2;
+				if (!atEdge && zombiesNear(focus, kZombieFightRadius) > kZombieFightCount) dcx = dcy = 0;
+			}
+			if (dcx != 0 && !stripReady(dcx, 0)) { (dcx > 0 ? readyE : readyW) = FALSE; }
+			if (dcy != 0 && !stripReady(0, dcy)) { (dcy > 0 ? readyN : readyS) = FALSE; }
+		} else {
+			readyE = stripReady(1, 0); readyW = stripReady(-1, 0); readyN = stripReady(0, 1); readyS = stripReady(0, -1);
+			dcx = focus.x > hi ? 1 : focus.x < lo ? -1 : 0;
+			dcy = focus.y > hi ? 1 : focus.y < lo ? -1 : 0;
+		}
+		const Bool wantedShift = dcx != 0 || dcy != 0;
+		if ((dcx > 0 && !readyE) || (dcx < 0 && !readyW)) dcx = 0;
+		if ((dcy > 0 && !readyN) || (dcy < 0 && !readyS)) dcy = 0;
+		if (dcx != 0 && dcy != 0 && !stripReady(dcx, dcy)) dcy = 0;		// the corner chunk: x now, y when it comes
+		m_edgeBlocked = wantedShift && dcx == 0 && dcy == 0;
+		if (dcx != 0 || dcy != 0) {
+			shiftWorld(dcx, dcy);
+			focusPoint(&focus, &heading);
+		} else {
+			updateCameraLimit(readyE, readyW, readyN, readyS);
+		}
+		// tell the server where we are and where we are heading, about once a second, so it downloads ahead
+		const UnsignedInt frame = TheGameLogic->getFrame();
+		// held at an edge: four times a second, so the server turns to the chunks under the camera at once
+		const UnsignedInt interval = m_edgeBlocked ? (UnsignedInt)LOGICFRAMES_PER_SECOND / 4 : (UnsignedInt)LOGICFRAMES_PER_SECOND;
+		if (frame - m_lastPositionFrame >= interval) {
+			const Real seconds = (Real)(frame - m_lastPositionFrame) / (Real)(Int)LOGICFRAMES_PER_SECOND;
+			m_lastPositionFrame = frame;
+			Real speed = 0.0f;		// chunks per second
+			if (m_haveLastFocus) {
+				const Real mx = focus.x - m_lastFocus.x, my = focus.y - m_lastFocus.y;
+				if (mx * mx + my * my > 100.0f) m_focusHeading = atan2f(my, mx);
+				if (seconds > 0.0f) speed = sqrtf(mx * mx + my * my) / chunkUnits / seconds;
+			}
+			// the big window: three chunks before the shift point (the followed vehicle: six - it cannot be held back
+			// like the camera, so its strip is wanted earlier), the chunks that shift will bring are asked for
+			if (bigWindow()) {
+				const Int fx = REAL_TO_INT_FLOOR(focus.x / chunkUnits), fy = REAL_TO_INT_FLOOR(focus.y / chunkUnits);
+				const Bool followed = followingVehicle();
+				const Int ahead = followed ? 6 : 3;
+				Int east = m_window - kEdgeMargin - mid, west = kEdgeMargin - 1 - mid;
+				if (m_zActive) { east = east < kZombieShiftStep ? east : kZombieShiftStep; west = -east; }
+				const Int sx = fx >= m_window - kEdgeMargin - ahead ? east : fx < kEdgeMargin + ahead ? west : 0;
+				const Int sy = fy >= m_window - kEdgeMargin - ahead ? east : fy < kEdgeMargin + ahead ? west : 0;
+				if (sx != 0) stripReady(sx, 0);
+				if (sy != 0) stripReady(0, sy);
+				if (sx != 0 && sy != 0) stripReady(sx, sy);
+			}
+			// a fast flight: the next chunks on the way are asked for too, past the prefetch ring
+			else if (speed > 0.5f) {
+				const Int depth = speed > 2.0f ? 4 : 2;
+				const Real hc = cosf(m_focusHeading), hs = sinf(m_focusHeading);
+				const Int sx = hc > 0.38f ? 1 : hc < -0.38f ? -1 : 0, sy = hs > 0.38f ? 1 : hs < -0.38f ? -1 : 0;
+				const Int r0 = kPrefetchRing;
+				if (sx != 0) {
+					const Int cx0 = sx > 0 ? m_winCx + m_window + r0 : m_winCx - r0 - depth;
+					for (Int cy = m_winCy - r0; cy < m_winCy + m_window + r0; ++cy) requestBlock(cx0, cy, depth, 1);
+				}
+				if (sy != 0) {
+					const Int cy0 = sy > 0 ? m_winCy + m_window + r0 : m_winCy - r0 - depth;
+					for (Int d = 0; d < depth; ++d) requestBlock(m_winCx - r0, cy0 + d, m_window + 2 * r0, 1);
+				}
+			}
+			if (!followingVehicle()) {
+				heading = m_focusHeading;
+			}
+			m_lastFocus = focus;
+			m_haveLastFocus = TRUE;
+			Writer w;
+			w.put<double>((double)m_winCx * chunkUnits + focus.x);
+			w.put<double>((double)m_winCy * chunkUnits + focus.y);
+			w.put<float>(heading);
+			sendMessage(M_POSITION, w.b);
+			requestAround(kPrefetchRing);
+			checkVehicleSelection();
+			parkUnitsOutside();		// a unit that drove off the window's edge by itself
+			restoreParkedUnits();
+
+			static const Bool s_trace = getenv("ZHE_TRACE") != nullptr;
+			// ZHE_PATHTEST=1: can the player's first unit go 250 units each way? (a move order checks exactly this)
+			static const Bool s_pathTest = getenv("ZHE_PATHTEST") != nullptr;
+			if (s_pathTest && TheAI != nullptr && TheAI->pathfinder() != nullptr && ThePlayerList->getLocalPlayer() != nullptr &&
+					(frame / (UnsignedInt)LOGICFRAMES_PER_SECOND) % 3 == 0) {
+				for (Object *obj = TheGameLogic->getFirstObject(); obj != nullptr; obj = obj->getNextObject()) {
+					if (obj->getControllingPlayer() != ThePlayerList->getLocalPlayer() || obj->getAIUpdateInterface() == nullptr) continue;
+					Pathfinder *pf = TheAI->pathfinder();
+					const LocomotorSet &ls = obj->getAIUpdateInterface()->getLocomotorSet();
+					const Coord3D *from = obj->getPosition();
+					PathfindCell *fc = pf->getClippedCell(TheTerrainLogic->getLayerForDestination(from), from);
+					char line[512];
+					Int n = snprintf(line, sizeof(line), "pathtest %s at %.0f,%.0f cell type %d zone %d:", obj->getTemplate()->getName().str(),
+						from->x, from->y, fc ? (Int)fc->getType() : -1, fc ? (Int)fc->getZone() : -1);
+					for (Int d = 0; d < 8 && n < (Int)sizeof(line) - 40; ++d) {
+						Coord3D to = *from;
+						to.x += 250.0f * cosf(d * 0.785398f);
+						to.y += 250.0f * sinf(d * 0.785398f);
+						PathfindCell *tc = pf->getClippedCell(TheTerrainLogic->getLayerForDestination(&to), &to);
+						const Bool ok = pf->clientSafeQuickDoesPathExist(ls, from, &to);
+						const Bool valid = pf->validMovementPosition(false, TheTerrainLogic->getLayerForDestination(&to), ls, &to);
+						n += snprintf(line + n, sizeof(line) - n, " [%d: %s%s t%d z%d]", d, ok ? "ok" : "NO", valid ? "" : " invalid",
+							tc ? (Int)tc->getType() : -1, tc ? (Int)tc->getZone() : -1);
+					}
+					wsLog("%s", line);
+					// the order a player gives: through the message stream, as the selected unit's move
+					static Int s_ordered = 0;
+					static const Bool s_send = getenv("ZHE_PATHTEST")[0] == '2';
+					if (s_send && s_ordered++ == 1) {
+						GameMessage *msg = TheMessageStream->appendMessage(GameMessage::MSG_DO_MOVETO);
+						Coord3D to = *from;
+						to.x += 250.0f * cosf(1 * 0.785398f);
+						to.y += 250.0f * sinf(1 * 0.785398f);
+						msg->appendLocationArgument(to);
+						wsLog("pathtest: MSG_DO_MOVETO %.0f,%.0f sent (selected: %d)", to.x, to.y, (Int)obj->getDrawable()->isSelected());
+					}
+					break;
+				}
+			}
+			if (s_trace) {
+				double lat = 0, lon = 0;
+				latLonAt(focus.x, focus.y, &lat, &lon);
+				wsLog("trace: focus %.0f,%.0f (%.5f, %.5f) camera height %.0f pitch %.1f free=%d | vehicle %s | roads %d/%d (%.0f ms)",
+					focus.x, focus.y, lat, lon, TheTacticalView != nullptr ? TheTacticalView->getHeightAboveGround() : 0.0f,
+					TheTacticalView != nullptr ? TheTacticalView->getPitch() * 180.0f / 3.14159265f : 0.0f, (Int)m_freeCamera,
+					vehicle != nullptr ? "yes" : "no", m_roadPieces, m_roadSegments, m_lastRoadMs);
+			}
+
+			// ZHE_AUTODRIVE=<degrees>: keep driving the test vehicle on that heading (0 = east, 90 = north). A test
+			// aid: the window must keep sliding with nobody at the mouse.
+			static const char *s_drive = getenv("ZHE_AUTODRIVE");
+			if (s_drive != nullptr && s_drive[0] != '\0' && vehicle != nullptr && vehicle->getAIUpdateInterface() != nullptr) {
+				const Coord3D *p = vehicle->getPosition();
+				const Real driveHeading = (Real)atof(s_drive) * 3.14159265f / 180.0f;
+				Coord3D goal = *p;
+				goal.x += cosf(driveHeading) * chunkUnits * 1.6f;
+				goal.y += sinf(driveHeading) * chunkUnits * 1.6f;
+				goal.z = TheTerrainLogic->getGroundHeight(goal.x, goal.y);
+				vehicle->getAIUpdateInterface()->aiMoveToPosition(&goal, CMD_FROM_AI);
+			}
+		}
+	}
+	createQueued(24);
+	zombieUpdate();
+}
+
+// ------------------------------------------------------------------------------------------------ overlay
+/** Ctrl+F10 (or the menu's Debug overlay): the chunk borders on the ground - the middle chunk yellow - and a few
+lines of text: where the camera looks (GPS), the window, and what is loaded. */
+void GXWorldStream::drawOverlay()
+{
+	// DARKNESS: a night-blue veil over the drawn world, up to 70 % at 100 - the ground, the town, the units and every
+	// chunk that comes later alike, with nothing to recompute; the HUD's text and the control bar are drawn above it
+	if (m_active && m_settings.darkness > 0 && TheDisplay != nullptr) {
+		const Int d = m_settings.darkness > 100 ? 100 : m_settings.darkness;
+		const UnsignedInt alpha = (UnsignedInt)(d * 178 / 100);
+		TheDisplay->drawFillRect(0, 0, TheDisplay->getWidth(), TheDisplay->getHeight(), (alpha << 24) | 0x00060A1C);
+	}
+	if (m_active) drawZombieHud();
+	if (!m_settings.debugOverlay || TheTacticalView == nullptr || TheDisplay == nullptr || TheTerrainLogic == nullptr) return;
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	const Real size = m_window * chunkUnits;
+	const Int mid = m_window / 2;
+	const Real step = 4.0f * MAP_XY_FACTOR;
+	for (Int axis = 0; axis < 2; ++axis) {
+		for (Int k = 0; k <= m_window; ++k) {
+			const Real c = k * chunkUnits;
+			const Bool middle = (k == mid || k == mid + 1);
+			for (Real t = 0.0f; t < size; t += step) {
+				Coord3D a, b;
+				if (axis == 0) { a.x = c; a.y = t; b.x = c; b.y = t + step; }
+				else { a.x = t; a.y = c; b.x = t + step; b.y = c; }
+				a.z = TheTerrainLogic->getGroundHeight(a.x, a.y) + 2.0f;
+				b.z = TheTerrainLogic->getGroundHeight(b.x, b.y) + 2.0f;
+				ICoord2D sa, sb;
+				if (TheTacticalView->worldToScreenTriReturn(&a, &sa) != View::WTS_INSIDE_FRUSTUM) continue;
+				if (TheTacticalView->worldToScreenTriReturn(&b, &sb) != View::WTS_INSIDE_FRUSTUM) continue;
+				const Real along = axis == 0 ? (t + 0.5f * step) : (t + 0.5f * step);
+				const Bool onMiddle = middle && along >= mid * chunkUnits && along <= (mid + 1) * chunkUnits;
+				TheDisplay->drawLine(sa.x, sa.y, sb.x, sb.y, onMiddle ? 2.0f : 1.0f, onMiddle ? 0xE0FFD000 : 0x9000E0FF);
+			}
+		}
+	}
+
+	if (TheDisplayStringManager == nullptr || TheFontLibrary == nullptr) return;
+	Coord3D focus;
+	Real heading = 0.0f;
+	if (!focusPoint(&focus, &heading)) return;
+	double lat = 0, lon = 0;
+	latLonAt(focus.x, focus.y, &lat, &lon);
+	Int buildings = 0, chunksPresent = windowChunksPresent();
+	for (std::map<ChunkKey, Chunk *>::const_iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		const Chunk *c = it->second;
+		for (size_t i = 0; i < c->objects.size(); ++i) if (c->objects[i].created != INVALID_ID) ++buildings;
+	}
+	UnicodeString text[5];
+	const std::wstring place = GXWorldUtf8ToWide(m_placeName);
+	text[0].format(L"WORLD EXPLORATION  %ls", place.c_str());
+	text[1].format(L"GPS %.5f%lc %.5f%lc   window %dx%d at chunk %d,%d   shifts %d", fabs(lat), lat >= 0 ? L'N' : L'S',
+		fabs(lon), lon >= 0 ? L'E' : L'W', m_window, m_window, m_winCx + mid, m_winCy + mid, m_shifts);
+	text[2].format(L"chunks %d/%d in window, %d near + %d parked, %d coming%ls   buildings %d   road pieces %d (%d segments, %.0f ms)   bridges %d/%d",
+		chunksPresent, m_window * m_window, (Int)m_chunks.size(), (Int)m_parked.size(), (Int)m_requested.size(),
+		m_edgeBlocked ? L"  [EDGE: waiting for chunks]" : L"", buildings, m_roadPieces, m_roadSegments, m_lastRoadMs,
+		m_bridges, m_bridgeCandidates);
+	const Bool following = followingVehicle();
+	text[3].format(L"camera height %.0f  pitch %.0f deg   %ls%ls", TheTacticalView->getHeightAboveGround(),
+		TheTacticalView->getPitch() * 180.0f / 3.14159265f, m_freeCamera ? L"FREE CAMERA (Page Up/Down tilt)" : L"RTS camera",
+		following ? L", following the vehicle" : L", the window follows the camera");
+	text[4] = UnicodeString(L"Ctrl+F9 free camera   Ctrl+F10 this overlay");
+	if (m_overlayLines.empty()) {
+		GameFont *font = TheFontLibrary->getFont(AsciiString("Arial"), 12, FALSE);
+		for (Int i = 0; i < 5; ++i) {
+			DisplayString *s = TheDisplayStringManager->newDisplayString();
+			if (s == nullptr) break;
+			s->setFont(font);
+			m_overlayLines.push_back(s);
+		}
+	}
+	Int y = 40;
+	for (size_t i = 0; i < m_overlayLines.size(); ++i) {
+		m_overlayLines[i]->setText(text[i]);
+		m_overlayLines[i]->draw(12, y, 0xFFFFFFFF, 0xFF000000);
+		y += 18;
+	}
+}
+
+#endif // RTS_ZEROHOUR
