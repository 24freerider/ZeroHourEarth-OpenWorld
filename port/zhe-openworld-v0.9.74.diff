+void Radar::refreshTerrainRange( TerrainLogic *terrain )
+{
+	if( terrain == nullptr )
+		return;
+	terrain->getExtent( &m_mapExtent );
+	m_xSample = m_mapExtent.width() / static_cast<float>(RADAR_CELL_WIDTH);
+	m_ySample = m_mapExtent.height() / static_cast<float>(RADAR_CELL_HEIGHT);
+
+	std::vector<Real> ground;
+	ground.reserve( (RADAR_CELL_WIDTH / 2) * (RADAR_CELL_HEIGHT / 2) );
+	Real waterSum = 0.0f;
+	Int waterSamples = 0;
+	for( Int y = 0; y < RADAR_CELL_HEIGHT; y += 2 )
+	{
+		for( Int x = 0; x < RADAR_CELL_WIDTH; x += 2 )
+		{
+			Real z, waterZ;
+			if( terrain->isUnderwater( x * m_xSample, y * m_ySample, &waterZ, &z ) )
+			{
+				waterSum += z;
+				waterSamples++;
+			}
+			else
+				ground.push_back( z );
+		}
+	}
+	if( !ground.empty() )
+	{
+		std::sort( ground.begin(), ground.end() );
+		const size_t n = ground.size();
+		Real sum = 0.0f;
+		for( size_t i = 0; i < n; ++i )
+			sum += ground[ i ];
+		m_terrainAverageZ = sum / (Real)n;
+		m_mapExtent.lo.z = ground[ n * 2 / 100 ];
+		m_mapExtent.hi.z = ground[ (n * 98) / 100 < n ? (n * 98) / 100 : n - 1 ];
+		// a flat window still shades: a few metres either side of the middle
+		const Real minSpan = 40.0f;
+		if( m_mapExtent.hi.z - m_mapExtent.lo.z < minSpan )
+		{
+			const Real mid = 0.5f * (m_mapExtent.hi.z + m_mapExtent.lo.z);
+			m_mapExtent.lo.z = mid - 0.5f * minSpan;
+			m_mapExtent.hi.z = mid + 0.5f * minSpan;
+		}
+	}
+	m_waterAverageZ = waterSamples > 0 ? waterSum / (Real)waterSamples : m_terrainAverageZ;
+}
+
