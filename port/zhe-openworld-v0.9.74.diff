+void GXWorldStream::latLonAt(Real x, Real y, double *lat, double *lon) const
+{
+	// worldserver/worldgrid.py: metres per degree on the WGS84 ellipsoid at the anchor latitude
+	const double phi = m_anchorLat * 3.14159265358979 / 180.0;
+	const double ky = 111132.92 - 559.82 * cos(2 * phi) + 1.175 * cos(4 * phi);
+	const double kx = 111412.84 * cos(phi) - 93.5 * cos(3 * phi) + 0.118 * cos(5 * phi);
+	const double upm = MAP_XY_FACTOR / m_mpc;
+	const double chunkUnits = m_n * MAP_XY_FACTOR;
+	const double wx = m_winCx * chunkUnits + x, wy = m_winCy * chunkUnits + y;
+	*lat = m_anchorLat + wy / (ky * upm);
+	*lon = m_anchorLon + wx / (kx * upm);
+}
