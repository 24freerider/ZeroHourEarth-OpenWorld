+// ---------------------------------------------------------------------------------------------- road lines
+/** Points closer than kWeld units are one point: the same junction reached by two roads, or a road leaving one chunk
+and entering the next, comes out of the server a hair apart (each ribbon has its own rounding). */
+class PointWelder
+{
+public:
+	static constexpr Real kCell = 2.0f;
+	static constexpr Real kWeld = 1.0f;
+	std::vector<Real> x, y;
+	Int add(Real px, Real py)
+	{
+		const Int ix = (Int)floorf(px / kCell), iy = (Int)floorf(py / kCell);
+		for (Int j = iy - 1; j <= iy + 1; ++j) {
+			for (Int i = ix - 1; i <= ix + 1; ++i) {
+				std::unordered_map<long long, std::vector<Int> >::const_iterator it = m_cells.find(key(i, j));
+				if (it == m_cells.end()) continue;
+				for (size_t k = 0; k < it->second.size(); ++k) {
+					const Int id = it->second[k];
+					const Real dx = x[id] - px, dy = y[id] - py;
+					if (dx * dx + dy * dy <= kWeld * kWeld) return id;
+				}
+			}
+		}
+		const Int id = (Int)x.size();
+		x.push_back(px);
+		y.push_back(py);
+		m_cells[key(ix, iy)].push_back(id);
+		return id;
+	}
+private:
+	static long long key(Int i, Int j) { return ((long long)i << 32) ^ (unsigned int)j; }
+	std::unordered_map<long long, std::vector<Int> > m_cells;
+};
+
+/// Ramer-Douglas-Peucker on ids[a..b] (both kept): marks keep[] for the points that stay. A run is also split where
+/// one of its pieces turns more than ~10 degrees off the chord: the road buffer draws a join under ~27 degrees as a
+/// smooth mitre, but a sharper one as a fixed tile curve or a hard corner (the "teeth" of a bend reduced too far).
+void simplifyRun(const PointWelder &w, const std::vector<Int> &ids, Int a, Int b, Real eps, std::vector<char> &keep)
+{
+	if (b - a < 2) return;
+	static const Real kCosTurn = 0.985f;	// cos 10 degrees
+	const Real ax = w.x[ids[a]], ay = w.y[ids[a]], bx = w.x[ids[b]], by = w.y[ids[b]];
+	const Real dx = bx - ax, dy = by - ay;
+	const Real len = sqrtf(dx * dx + dy * dy);
+	Real worst = -1.0f, minCos = 1.0f;
+	Int at = -1;
+	for (Int i = a + 1; i < b; ++i) {
+		const Real px = w.x[ids[i]] - ax, py = w.y[ids[i]] - ay;
+		const Real d = len > 1e-4f ? fabsf(px * dy - py * dx) / len : sqrtf(px * px + py * py);
+		if (d > worst) { worst = d; at = i; }
+	}
+	if (len > 1e-4f) {
+		for (Int i = a; i < b; ++i) {
+			const Real sx = w.x[ids[i + 1]] - w.x[ids[i]], sy = w.y[ids[i + 1]] - w.y[ids[i]];
+			const Real sl = sqrtf(sx * sx + sy * sy);
+			if (sl > 1e-4f) {
+				const Real c = (sx * dx + sy * dy) / (sl * len);
+				if (c < minCos) minCos = c;
+			}
+		}
+	}
+	if ((worst > eps || minCos < kCosTurn) && at > a) {
+		keep[at] = 1;
+		simplifyRun(w, ids, a, at, eps, keep);
+		simplifyRun(w, ids, at, b, eps, keep);
+	}
+}
+
+Bool isMinorRoad(const std::string &name)
+{
+	return name.find("Dirt") != std::string::npos || name.find("Gravel") != std::string::npos ||
+		name.find("Sidewalk") != std::string::npos;
+}
+
+/** The chunk's roads reduced to what the road buffer needs, once, when the chunk arrives (network thread): points a
+hair apart welded, a point two roads share (a junction) or a road's end kept exactly, straight runs cut down to their
+bends (RDP, 5 units, 10 for tracks and paths), no piece under 4 units unless a junction asks for it. Doing it per chunk
+is exact: a junction lies in one chunk, and both roads that meet there are cut by that chunk's edges; the cut points are
+ends, so they are kept. A bridge is reduced harder (its spans are straight bridge models). */
+void prepareChunkLines(Chunk *c, const std::vector<RawRoad> &raw)
+{
+	PointWelder welder;
+	std::vector<Real> z;
+	struct Line { unsigned short tmpl; unsigned char flags; Real eps, width; std::vector<Int> ids; };
+	std::vector<Line> lines;
+	for (size_t k = 0; k < raw.size(); ++k) {
+		const RawRoad &road = raw[k];
+		Line line;
+		line.tmpl = road.tmpl;
+		line.flags = road.flags;
+		line.width = road.width;
+		// a bridge keeps its points (its deck rises and falls along them: rebuildBridges cuts its spans)
+		line.eps = (road.flags & 1) ? 2.0f : (isMinorRoad(c->strings[road.tmpl]) ? 10.0f : 5.0f);
+		const size_t points = road.xyz.size() / 3;
+		for (size_t p = 0; p < points; ++p) {
+			const Int id = welder.add(road.xyz[3 * p], road.xyz[3 * p + 1]);
+			if ((size_t)id >= z.size()) z.resize((size_t)id + 1, road.xyz[3 * p + 2]);
+			if (line.ids.empty() || line.ids.back() != id) line.ids.push_back(id);
+		}
+		if (line.ids.size() >= 2) lines.push_back(line);
+	}
+	std::vector<Int> uses(welder.x.size(), 0);
+	for (size_t l = 0; l < lines.size(); ++l) {
+		const std::vector<Int> &ids = lines[l].ids;
+		for (size_t i = 0; i < ids.size(); ++i) uses[ids[i]] += (i == 0 || i + 1 == ids.size()) ? 2 : 1;
+	}
+	for (size_t l = 0; l < lines.size(); ++l) {
+		const std::vector<Int> &ids = lines[l].ids;
+		const Int count = (Int)ids.size();
+		std::vector<char> keep(count, 0);
+		for (Int i = 0; i < count; ++i) keep[i] = (i == 0 || i == count - 1 || uses[ids[i]] >= 2) ? 1 : 0;
+		const std::vector<char> pinned(keep);
+		Int start = 0;
+		for (Int i = 1; i < count; ++i) {
+			if (pinned[i]) {
+				simplifyRun(welder, ids, start, i, lines[l].eps, keep);
+				start = i;
+			}
+		}
+		ChunkLine out;
+		out.tmpl = lines[l].tmpl;
+		out.flags = lines[l].flags;
+		out.width = lines[l].width;
+		Int prev = 0;
+		out.xyz.push_back(welder.x[ids[0]]); out.xyz.push_back(welder.y[ids[0]]); out.xyz.push_back(z[ids[0]]);
+		for (Int i = 1; i < count; ++i) {
+			if (!keep[i]) continue;
+			const Real dx = welder.x[ids[i]] - welder.x[ids[prev]], dy = welder.y[ids[i]] - welder.y[ids[prev]];
+			if (!pinned[i] && dx * dx + dy * dy < 16.0f) continue;
+			out.xyz.push_back(welder.x[ids[i]]); out.xyz.push_back(welder.y[ids[i]]); out.xyz.push_back(z[ids[i]]);
+			prev = i;
+		}
+		if (out.points() >= 2) c->lines.push_back(out);
+	}
+}
