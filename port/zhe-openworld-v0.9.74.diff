+			}
+			TBlendTileInfo info;
+			memset(&info, 0, sizeof(info));
+			info.blendNdx = tileOf(x, y, best);
+			info.customBlendEdgeClass = -1;
+			Int sx = x, sy = y;
+			Bool longDiagonal = false;
+			if (sides == 1) {
+				sx = left ? x - 1 : right ? x + 1 : x;
+				sy = bottom ? y - 1 : top ? y + 1 : y;
+			} else if (sides == 2) {
+				// two sides at a corner: the long diagonal, from the opposite corner as World Builder does it
+				longDiagonal = true;
+				if (top) sy--;
+				if (bottom) sy++;
+				if (left) sx++;
+				if (right) sx--;
+			} else {
+				// a corner only
+				for (Int j = -1; j <= 1 && sx == x; j += 2) {
+					for (Int i = -1; i <= 1; i += 2) {
+						if (classAt(x + i, y + j) == best) { sx = x + i; sy = y + j; break; }
+					}
+				}
+			}
+			if (sy == y) {
+				info.horiz = true;
+				info.inverted = (sx < x);
+			} else if (sx == x) {
+				info.vert = true;
+				info.inverted = (sy < y);
+			} else {
+				if (sx > x) info.rightDiagonal = true; else info.leftDiagonal = true;
+				info.inverted = (sy < y);
+				if (longDiagonal) {
+					info.longDiagonal = true;
+					info.inverted = !info.inverted;
+					info.rightDiagonal = !info.rightDiagonal;
+					info.leftDiagonal = !info.leftDiagonal;
+				}
+			}
+			const unsigned long long key = ((unsigned long long)(UnsignedInt)info.blendNdx << 32) | ((UnsignedInt)info.horiz << 0) |
+				((UnsignedInt)info.vert << 1) | ((UnsignedInt)info.rightDiagonal << 2) | ((UnsignedInt)info.leftDiagonal << 3) |
+				((UnsignedInt)info.longDiagonal << 4) | ((UnsignedInt)info.inverted << 8) | ((UnsignedInt)(info.customBlendEdgeClass + 1) << 16);
+			Int slot;
+			std::map<unsigned long long, Int>::iterator it = known.find(key);
+			if (it != known.end()) {
+				slot = it->second;
+			} else {
+				if (m_numBlendedTiles >= NUM_BLEND_TILES) continue;		// the table is full: a hard edge
+				slot = m_numBlendedTiles++;
+				m_blendedTiles[slot] = info;
+				known.insert(std::make_pair(key, slot));
+			}
+			m_blendTileNdxes[ndx] = (Short)slot;
+			blended++;
+		}
+	}
+	return blended;
+}
+
+void WorldHeightMap::streamRecomputeCliffs(Int x0, Int y0, Int x1, Int y1)
+{
+	if (m_cellCliffState == nullptr) {
+		return;
+	}
+	if (x0 < 0) x0 = 0;
+	if (y0 < 0) y0 = 0;
+	if (x1 > m_width - 2) x1 = m_width - 2;
+	if (y1 > m_height - 2) y1 = m_height - 2;
+	for (Int y = y0; y <= y1; y++) {
+		for (Int x = x0; x <= x1; x++) {
+			setCellCliffFlagFromHeights(x, y);
+		}
+	}
+}
