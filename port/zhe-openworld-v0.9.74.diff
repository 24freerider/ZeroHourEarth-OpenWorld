+
+	// dev / sandbox settings
+	CodeGuiLabel(s_screen, pad, cy, w - 2 * pad, row, nullptr, L"Settings (Ctrl+F9 in the game: free camera, Ctrl+F10: debug overlay)", FALSE, 11);
+	cy += row + CodeGuiScaleY(4);
