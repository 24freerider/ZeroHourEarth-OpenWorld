+// FILE: GXWorldStreamNet.cpp /////////////////////////////////////////////////////////////////////
+// GeneralsX @feature ZeroHourEarth 13/11/2026 See GXWorldStreamNet.h. No engine headers here.
+//
+// Two things this file must not include, both because of the target's precompiled header, which is
+// in front of every source whether it wants it or not:
+//   <winsock2.h>  the PCH has already included <windows.h> with the Winsock 1.1 declarations, and the
+//                 two cannot follow each other. Winsock 1.1 is all a loopback TCP stream needs.
+//   <zlib.h>      zconf.h typedefs Byte as unsigned char, the engine (Lib/BaseType.h) as char. The one
+//                 zlib function used here is declared by hand instead.
+///////////////////////////////////////////////////////////////////////////////////////////////////
+
+#include "W3DDevice/GameClient/GXWorldStreamNet.h"
+
+#include <cstring>
+
+extern "C" int uncompress(unsigned char *dest, unsigned long *destLen, const unsigned char *source, unsigned long sourceLen);
+
+#if defined(_WIN32)
+
+#include <windows.h>
+#include <winsock.h>
+
+#pragma comment(lib, "ws2_32.lib")
+
+static bool gxWorldWinsock()
+{
+	static bool s_tried = false, s_ok = false;
+	if (!s_tried) {
+		s_tried = true;
+		WSADATA data;
+		s_ok = WSAStartup(MAKEWORD(2, 2), &data) == 0;
+	}
+	return s_ok;
+}
+
+GXWorldSocket::GXWorldSocket() : m_handle((size_t)INVALID_SOCKET), m_open(false) {}
+
+GXWorldSocket::~GXWorldSocket() { close(); }
+
+bool GXWorldSocket::open(const char *host, int port)
+{
+	close();
+	if (!gxWorldWinsock()) {
+		return false;
+	}
+	SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+	if (s == INVALID_SOCKET) {
+		return false;
+	}
+	sockaddr_in addr;
+	memset(&addr, 0, sizeof(addr));
+	addr.sin_family = AF_INET;
+	addr.sin_port = htons((u_short)port);
+	addr.sin_addr.s_addr = inet_addr(host);
+	if (addr.sin_addr.s_addr == INADDR_NONE || connect(s, (const sockaddr *)&addr, sizeof(addr)) != 0) {
+		closesocket(s);
+		return false;
+	}
+	BOOL noDelay = TRUE;
+	setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (const char *)&noDelay, sizeof(noDelay));
+	m_handle = (size_t)s;
+	m_open = true;
+	return true;
+}
+
+void GXWorldSocket::close()
+{
+	if (m_open) {
+		m_open = false;
+		SOCKET s = (SOCKET)m_handle;
+		shutdown(s, 2);	// both directions: a receive blocked in the network thread returns
+		closesocket(s);
+		m_handle = (size_t)INVALID_SOCKET;
+	}
+}
+
+bool GXWorldSocket::sendAll(const void *data, size_t size)
+{
+	const char *p = (const char *)data;
+	while (size > 0 && m_open) {
+		const int n = send((SOCKET)m_handle, p, (int)(size > 0x40000 ? 0x40000 : size), 0);
+		if (n <= 0) {
+			return false;
+		}
+		p += n;
+		size -= (size_t)n;
+	}
+	return size == 0;
+}
+
+bool GXWorldSocket::recvAll(void *data, size_t size)
+{
+	char *p = (char *)data;
+	while (size > 0 && m_open) {
+		const int n = recv((SOCKET)m_handle, p, (int)(size > 0x40000 ? 0x40000 : size), 0);
+		if (n <= 0) {
+			return false;
+		}
+		p += n;
+		size -= (size_t)n;
+	}
+	return size == 0;
+}
+
+std::wstring GXWorldUtf8ToWide(const std::string &utf8)
+{
+	if (utf8.empty()) {
+		return std::wstring();
+	}
+	const int n = MultiByteToWideChar(CP_UTF8, 0, utf8.data(), (int)utf8.size(), nullptr, 0);
+	std::wstring out((size_t)(n > 0 ? n : 0), L'\0');
+	if (n > 0) {
+		MultiByteToWideChar(CP_UTF8, 0, utf8.data(), (int)utf8.size(), &out[0], n);
+	}
+	return out;
+}
+
+std::string GXWorldWideToUtf8(const std::wstring &wide)
+{
+	if (wide.empty()) {
+		return std::string();
+	}
+	const int n = WideCharToMultiByte(CP_UTF8, 0, wide.data(), (int)wide.size(), nullptr, 0, nullptr, nullptr);
+	std::string out((size_t)(n > 0 ? n : 0), '\0');
+	if (n > 0) {
+		WideCharToMultiByte(CP_UTF8, 0, wide.data(), (int)wide.size(), &out[0], n, nullptr, nullptr);
+	}
+	return out;
+}
+
+bool GXWorldKeyDown(GXWorldKey key)
+{
+	// only while the game has the focus: the keys of another window are none of our business
+	HWND fg = GetForegroundWindow();
+	DWORD pid = 0;
+	if (fg == nullptr || (GetWindowThreadProcessId(fg, &pid), pid) != GetCurrentProcessId()) {
+		return false;
+	}
+	int vk = 0;
+	switch (key) {
+	case GXKEY_CTRL: vk = VK_CONTROL; break;
+	case GXKEY_F9: vk = VK_F9; break;
+	case GXKEY_F10: vk = VK_F10; break;
+	case GXKEY_PAGE_UP: vk = VK_PRIOR; break;
+	case GXKEY_PAGE_DOWN: vk = VK_NEXT; break;
+	case GXKEY_UP: vk = VK_UP; break;
+	case GXKEY_DOWN: vk = VK_DOWN; break;
+	case GXKEY_LEFT: vk = VK_LEFT; break;
+	case GXKEY_RIGHT: vk = VK_RIGHT; break;
+	case GXKEY_SHIFT: vk = VK_SHIFT; break;
+	default: return false;
+	}
+	return (GetAsyncKeyState(vk) & 0x8000) != 0;
+}
+
+#else	// not Windows: the prototype's world server link is not ported yet; the menu reports "offline"
+
+bool GXWorldKeyDown(GXWorldKey) { return false; }
+
+GXWorldSocket::GXWorldSocket() : m_handle(0), m_open(false) {}
+GXWorldSocket::~GXWorldSocket() {}
+bool GXWorldSocket::open(const char *, int) { return false; }
+void GXWorldSocket::close() { m_open = false; }
+bool GXWorldSocket::sendAll(const void *, size_t) { return false; }
+bool GXWorldSocket::recvAll(void *, size_t) { return false; }
+
+std::wstring GXWorldUtf8ToWide(const std::string &utf8) { return std::wstring(utf8.begin(), utf8.end()); }
+std::string GXWorldWideToUtf8(const std::wstring &wide)
+{
+	std::string out;
+	for (size_t i = 0; i < wide.size(); ++i) out.push_back(wide[i] < 128 ? (char)wide[i] : '?');
+	return out;
+}
+
+#endif
+
+bool GXWorldInflate(const unsigned char *packed, size_t packedSize, unsigned char *raw, size_t rawSize)
+{
+	unsigned long got = (unsigned long)rawSize;
+	return uncompress(raw, &got, packed, (unsigned long)packedSize) == 0 /* Z_OK */ && got == (unsigned long)rawSize;
+}
