+GXWorldStream::GXWorldStream() :
+	m_quit(false), m_connected(false), m_threadStarted(FALSE), m_nextRid(1),
+	m_state(STATE_OFFLINE), m_searchSerial(0), m_searchRid(0), m_openRid(0),
+	m_hasSession(FALSE), m_anchorLat(0), m_anchorLon(0), m_spawnX(0), m_spawnY(0),
+	m_mpc(2.5f), m_spawnZ(0), m_spawnHeading(0), m_zBase(0),
+	m_n(64), m_window(7), m_winCx(0), m_winCy(0),
