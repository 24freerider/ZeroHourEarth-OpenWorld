+#define SKY_HAZE_DEG		1.5f
+#define SKY_GROUND_DEG	9.0f
+static void skyBelowHorizonLand(const Vector3 &eye, Real radius)
+{
+	const Real hazeDrop = radius * tanf(DEG_TO_RADF(SKY_HAZE_DEG));
+	const Real groundDrop = radius * tanf(DEG_TO_RADF(SKY_GROUND_DEG));
+	const Int N = SKY_BLACK_SIDES;
+	DynamicVBAccessClass vb_access(BUFFER_TYPE_DYNAMIC_DX8, dynamic_fvf_type, 3 * N + 1);
+	DynamicIBAccessClass ib_access(BUFFER_TYPE_DYNAMIC_DX8, 15 * N);
+	{
+		DynamicVBAccessClass::WriteLockClass lock(&vb_access);
+		DynamicIBAccessClass::WriteLockClass lockib(&ib_access);
+		VertexFormatXYZNDUV2 *v = lock.Get_Formatted_Vertex_Array();
+		UnsignedShort *ib = lockib.Get_Index_Array();
+		if (!v || !ib)
+			return;
+		memset(v, 0, sizeof(VertexFormatXYZNDUV2) * (3 * N + 1));
+		for (Int i = 0; i < N; ++i)
