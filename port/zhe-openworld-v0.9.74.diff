+// ---------------------------------------------------------------------------------------------- bytes
+struct Writer
+{
+	std::string b;
+	template <typename T> void put(T v) { b.append((const char *)&v, sizeof(T)); }
+	void str(const std::string &s)
+	{
+		const unsigned short n = (unsigned short)(s.size() > 65000 ? 65000 : s.size());
+		put(n);
+		b.append(s.data(), n);
+	}
+};
+
+struct Reader
+{
+	const unsigned char *p, *end;
+	bool ok;
+	Reader(const std::string &s) : p((const unsigned char *)s.data()), end((const unsigned char *)s.data() + s.size()), ok(true) {}
+	template <typename T> T get()
+	{
+		T v = T();
+		if ((size_t)(end - p) < sizeof(T)) { ok = false; p = end; return v; }
+		memcpy(&v, p, sizeof(T));
+		p += sizeof(T);
+		return v;
+	}
+	std::string str()
+	{
+		const unsigned short n = get<unsigned short>();
+		if ((size_t)(end - p) < n) { ok = false; p = end; return std::string(); }
+		std::string s((const char *)p, n);
+		p += n;
+		return s;
+	}
+	const unsigned char *raw(size_t n)
+	{
+		if ((size_t)(end - p) < n) { ok = false; p = end; return nullptr; }
+		const unsigned char *r = p;
+		p += n;
+		return r;
+	}
+};
