+//=============================================================================
+// W3DRoadBuffer::loadStreamRoads
+//=============================================================================
+/** GeneralsX @feature ZeroHourEarth 13/11/2026 World Exploration (GXWorldStream.cpp): every road of the streamed
+window, as straight pieces whose shared end points are exactly equal. They go through the same build as a map's road
+objects (addMapObjects reads them instead of the map objects while they are set). Their draw buffers may reach the
+16-bit index ceiling (a town of 7 x 7 chunks draws far more than GameData.ini's MaxRoadVertex of a stock map), and
+the segment array grows until every piece fits. */
+//=============================================================================
+void W3DRoadBuffer::loadStreamRoads(const W3DRoadStreamSegment *segments, Int count)
+{
+	m_streamSegments.assign(segments, segments + count);
+	if (m_streamSegments.empty()) {
+		W3DRoadStreamSegment none = { 0, 0, 0, 0, nullptr };	// "streaming, no roads": still not the map's own
+		m_streamSegments.push_back(none);
+	}
+	buildStreamRoads();
+}
+
+void W3DRoadBuffer::translateStreamRoads(Real dx, Real dy)
+{
+	for (size_t k = 0; k < m_streamSegments.size(); ++k) {
+		m_streamSegments[k].x1 += dx; m_streamSegments[k].y1 += dy;
+		m_streamSegments[k].x2 += dx; m_streamSegments[k].y2 += dy;
+	}
+	if (m_roads == nullptr) return;
+	for (Int i = 0; i < m_numRoads; i++) {
+		m_roads[i].translate(dx, dy);
+	}
+	m_updateBuffers = true;
+}
+
+void W3DRoadBuffer::clearStreamRoads()
+{
+	m_streamSegments.clear();
+	clearAllRoads();
+}
+
+/** GeneralsX @feature ZeroHourEarth The draw buffer limits: GameData.ini's MaxRoadVertex/Index for a map, the 16-bit
+index ceiling for the streamed world. */
+Int W3DRoadBuffer::roadVertexCap() const
+{
+	return m_streamSegments.empty() ? m_maxRoadVertex : STREAM_ROAD_VERTEX_CAP;
+}
+
+Int W3DRoadBuffer::roadIndexCap() const
+{
+	return m_streamSegments.empty() ? m_maxRoadIndex : STREAM_ROAD_INDEX_CAP;
+}
+
+void W3DRoadBuffer::buildStreamRoads()
+{
+	if (!m_initialized || m_roadTypes == nullptr) {
+		return;
+	}
+	clearAllRoads();
+	Int want = (Int)m_streamSegments.size()*SEGMENTS_PER_PAIR + 64;
+	if (want < MIN_ROAD_SEGMENTS) {
+		want = MIN_ROAD_SEGMENTS;
+	}
+	for (;;) {
+		sizeSegmentArray(want);
+		buildRoadSegments();
+		if (!m_segmentsFull || want >= STREAM_ROAD_SEGMENTS_MAX) {
+			break;
+		}
+		clearAllRoads();
+		want *= 2;
+	}
+	preloadRoadsInVertexAndIndexBuffers();
+	sizeRoadTypeBuffers();
+	m_maxRebuildDropped = 0;
+	m_updateBuffers = true;
+	fprintf(stderr, "[GXROADS] stream pieces=%d segments=%d cap=%d full=%d\n", (Int)m_streamSegments.size(), m_numRoads,
+		m_maxRoadSegments, m_segmentsFull ? 1 : 0);
+}
+
+/** GeneralsX @feature ZeroHourEarth The streamed pieces as addMapObjects' first pass reads a map's road point pairs. */
+void W3DRoadBuffer::addStreamSegments()
+{
+	for (size_t k = 0; k < m_streamSegments.size(); ++k) {
+		const W3DRoadStreamSegment &s = m_streamSegments[k];
+		if (s.type == nullptr) continue;
+		Vector2 loc1(s.x1, s.y1), loc2(s.x2, s.y2);
+		if (loc1.X == loc2.X && loc1.Y == loc2.Y) continue;
+		m_mapRoadPairs++;
+		if (m_numRoads >= m_maxRoadSegments) {
+			m_segmentsFull = true;
+			m_refusedRoadPairs++;
+			continue;
+		}
+		RoadSegment curRoad;
+		curRoad.m_scale = s.type->getRoadWidth();
+		curRoad.m_widthInTexture = s.type->getRoadWidthInTexture();
+		curRoad.m_uniqueID = s.type->getID();
+		curRoad.m_pt1.loc = loc1;
+		curRoad.m_pt1.isAngled = false;
+		curRoad.m_pt1.isJoin = false;
+		curRoad.m_pt2.loc = loc2;
+		curRoad.m_pt2.isAngled = false;
+		curRoad.m_pt2.isJoin = false;
+		curRoad.m_type = SEGMENT;
+		curRoad.m_curveRadius = CORNER_RADIUS;
+		addMapObject(&curRoad, m_numRoads, true);
+	}
+}
