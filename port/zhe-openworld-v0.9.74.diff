+//-----------------------------------------------------------------------------
+// GeneralsX @feature ZeroHourEarth 14/11/2026 World Exploration: the explored cells slide with the world
+void PartitionManager::gxShiftShroud( Int playerIndex, Real dx, Real dy )
+{
+	if (m_totalCellCount <= 0 || m_cells == nullptr)
+		return;
+	processEntirePendingUndoShroudRevealQueue();
+	const Int sx = REAL_TO_INT_FLOOR(dx * m_cellSizeInv + 0.5f), sy = REAL_TO_INT_FLOOR(dy * m_cellSizeInv + 0.5f);
+	std::vector<UnsignedByte> was((size_t)m_totalCellCount);
+	for (Int i = 0; i < m_totalCellCount; ++i)
+		was[(size_t)i] = m_cells[i].getShroudStatusForPlayer(playerIndex) != CELLSHROUD_SHROUDED ? 1 : 0;
+	m_gxExplored.assign((size_t)m_totalCellCount, 0);
+	for (Int y = 0; y < m_cellCountY; ++y)
+	{
+		const Int fy = y + sy;
+		if (fy < 0 || fy >= m_cellCountY)
+			continue;
+		for (Int x = 0; x < m_cellCountX; ++x)
+		{
+			const Int fx = x + sx;
+			if (fx >= 0 && fx < m_cellCountX)
+				m_gxExplored[(size_t)(y * m_cellCountX + x)] = was[(size_t)(fy * m_cellCountX + fx)];
+		}
+	}
+	gxReapplyShroud(playerIndex);
+}
+
+void PartitionManager::gxReapplyShroud( Int playerIndex )
+{
+	if (m_cells == nullptr || (Int)m_gxExplored.size() != m_totalCellCount)
+		return;
+	for (Int i = 0; i < m_totalCellCount; ++i)
+	{
+		PartitionCell &cell = m_cells[i];
+		const CellShroudStatus status = cell.getShroudStatusForPlayer(playerIndex);
+		if (status == CELLSHROUD_CLEAR)
+		{
+			m_gxExplored[(size_t)i] = 1;		// seen now: explored from here on
+		}
+		else if (m_gxExplored[(size_t)i] && status == CELLSHROUD_SHROUDED)
+		{
+			cell.addLooker(playerIndex);			// shrouded -> fogged
+			cell.removeLooker(playerIndex);
+		}
+		else if (!m_gxExplored[(size_t)i] && status == CELLSHROUD_FOGGED)
+		{
+			cell.addShrouder(playerIndex);		// fogged -> shrouded
+			cell.removeShrouder(playerIndex);
+		}
+	}
+}
