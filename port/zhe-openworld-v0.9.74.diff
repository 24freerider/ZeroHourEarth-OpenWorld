+{
+	m_lastFocus.zero();
+	setStatus(L"The world server is not running.");
+}
+
+GXWorldStream::~GXWorldStream()
+{
+	m_quit = true;
+	m_socket.close();
+	if (m_thread.joinable()) {
+		m_thread.join();
+	}
+	for (size_t i = 0; i < m_incoming.size(); ++i) delete m_incoming[i].chunk;
+	dropChunks();
+}
+
+void GXWorldStream::dropChunks()
+{
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		delete it->second;
+	}
+	m_chunks.clear();
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_parked.begin(); it != m_parked.end(); ++it) {
+		delete it->second;
+	}
+	m_parked.clear();
+	m_requested.clear();
+	m_createQueue.clear();
+	m_parkedUnits.clear();
+}
+
+Bool GXWorldStream::haveChunk(const ChunkKey &key)
+{
+	if (m_chunks.find(key) != m_chunks.end()) return TRUE;
+	std::map<ChunkKey, Chunk *>::iterator it = m_parked.find(key);
+	if (it == m_parked.end()) return FALSE;
+	Chunk *c = it->second;
+	m_parked.erase(it);
+	c->applied = FALSE;
+	c->populated = FALSE;
+	m_chunks[key] = c;
+	++m_unparked;
+	return TRUE;
+}
+
+Bool GXWorldStream::wanted(const ChunkKey &key, double now)
+{
+	if (haveChunk(key)) return FALSE;
+	std::map<ChunkKey, double>::iterator it = m_requested.find(key);
+	if (it == m_requested.end()) return TRUE;
+	return now - it->second >= kRequestTimeout;	// lost or still far down the server's list: ask again (it keeps one entry per chunk)
+}
+
+/** Keep a chunk that fell behind in memory, out of the game (its objects are already gone, destroyed ones stay
+marked), so coming back needs no server at all. Past kParkedMax the longest parked go. */
+void GXWorldStream::parkChunk(Chunk *c)
+{
+	const ChunkKey key = { c->cx, c->cy };
+	m_requested.erase(key);
+	if (c->incomplete) {				// not kept: coming back asks the server again, which by then may have it all
+		delete c;
+		return;
+	}
+	c->applied = FALSE;
+	c->populated = FALSE;
+	c->parkedAt = ++m_parkSerial;
+	m_parked[key] = c;
+	while (m_parked.size() > kParkedMax) {
+		std::map<ChunkKey, Chunk *>::iterator oldest = m_parked.begin();
+		for (std::map<ChunkKey, Chunk *>::iterator it = m_parked.begin(); it != m_parked.end(); ++it) {
+			if (it->second->parkedAt < oldest->second->parkedAt) oldest = it;
+		}
+		delete oldest->second;
+		m_parked.erase(oldest);
+	}
+}
+
+Bool GXWorldStream::stripReady(Int dcx, Int dcy)
+{
+	const Int nx = m_winCx + dcx, ny = m_winCy + dcy;
+	const double now = wsNow();
+	Bool ready = TRUE;
+	for (Int cy = ny; cy < ny + m_window; ++cy) {
+		for (Int cx = nx; cx < nx + m_window; ++cx) {
+			if (inWindow(cx, cy)) continue;
+			const ChunkKey key = { cx, cy };
+			if (haveChunk(key)) continue;
+			ready = FALSE;
+			if (wanted(key, now)) requestBlock(cx, cy, 1, 1);
+		}
+	}
+	return ready;
+}
+
+/** Hold the camera inside the window on a side whose next strip has not come yet: it slows down past the shift
+point and stops kEdgeSlack further (W3DView::setStreamLimit). Not for a camera following the vehicle. */
+void GXWorldStream::updateCameraLimit(Bool readyE, Bool readyW, Bool readyN, Bool readyS)
+{
+	if (TheTacticalView == nullptr) return;
+	Object *vehicle = findVehicle();
+	(void)vehicle;
+	if (followingVehicle() || (readyE && readyW && readyN && readyS)) {
+		if (m_limitSet) TheTacticalView->setStreamLimit(nullptr);
+		m_limitSet = FALSE;
+		return;
+	}
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	const Int mid = m_window / 2;
+	const Real kNoLimit = 1.0e9f;
+	// the big window: held two chunks short of its edge (it would show the map's end); else just past the shift point
+	const Real lo = bigWindow() ? 2.0f * chunkUnits : (mid - kShiftHysteresis - kEdgeSlack) * chunkUnits;
+	const Real hi = bigWindow() ? (m_window - 2) * chunkUnits : (mid + 1 + kShiftHysteresis + kEdgeSlack) * chunkUnits;
+	Region2D r;
+	r.lo.x = readyW ? -kNoLimit : lo;
+	r.hi.x = readyE ? kNoLimit : hi;
+	r.lo.y = readyS ? -kNoLimit : lo;
+	r.hi.y = readyN ? kNoLimit : hi;
+	TheTacticalView->setStreamLimit(&r);
+	m_limitSet = TRUE;
+}
+
+void GXWorldStream::setSettings(const GXWorldSettings &settings)
+{
+	m_settings = settings;
+	if (m_settings.window < 3) m_settings.window = 3;
+	if (m_settings.window > kMaxWindow) m_settings.window = kMaxWindow;
+	if (!(m_settings.window & 1)) ++m_settings.window;
+}
+
+AsciiString GXWorldStream::getBaseMapPath() const
+{
+	// worldserver/worldmap.py: the 7 x 7 window keeps its old name, every other size has its own map
+	const Int window = m_hasSession ? m_window : m_settings.window;
+	// the zombie run: its own variant ("Z": the Zombies side and the map.ini of the shop and the zombie types)
+	AsciiString path;
+	if (m_settings.zombies()) {
+		path.format("Maps\\WorldExploration%dZ\\WorldExploration%dZ.map", window, window);
+	} else if (window == 7) {
+		path = "Maps\\WorldExploration\\WorldExploration.map";
+	} else {
+		path.format("Maps\\WorldExploration%d\\WorldExploration%d.map", window, window);
+	}
+	return path;
+}
