+	s_search = CodeGuiButton(s_screen, w - pad - searchW, cy, searchW, row, "GXWorldExplore:Search", L"SEARCH");
+	cy += row + CodeGuiScaleY(10);
+	CodeGuiLabel(s_screen, pad, cy, w - 2 * pad, row, nullptr, L"Spawn point:", FALSE, 11);
+	cy += row;
+	const Int settingsH = 8 * row + CodeGuiScaleY(8 * 6);
+	const Int listH = h - cy - 2 * row - settingsH - CodeGuiScaleY(34);
+	s_list = CodeGuiListbox(s_screen, pad, cy, w - 2 * pad, listH, "GXWorldExplore:Places", 12, FALSE, TRUE, 11);
