+/// worldserver/chunkgen.py's payload. Runs on the network thread: nothing here touches the game.
+Chunk *parseChunk(const std::string &payload)
+{
+	Reader r(payload);
+	if (r.get<unsigned int>() != 0x4B435847u) return nullptr;	// 'GXCK'
+	const unsigned short version = r.get<unsigned short>();
+	const unsigned short flags = r.get<unsigned short>();	// 1: incomplete (a map tile, or the pitches, not there yet)
+	Chunk *c = new Chunk;
+	c->incomplete = (flags & 1) != 0;
+	c->cx = r.get<int>();
+	c->cy = r.get<int>();
+	c->n = r.get<unsigned short>();
+	r.get<unsigned short>();
+	if (version != 1 || c->n < 8 || c->n > 256) { delete c; return nullptr; }
+	const unsigned int numStrings = r.get<unsigned int>();
+	if (numStrings > 4096) { delete c; return nullptr; }
+	for (unsigned int i = 0; i < numStrings && r.ok; ++i) c->strings.push_back(r.str());
+	const size_t cells = (size_t)c->n * c->n;
+	const unsigned char *h = r.raw(cells * 4);
+	const unsigned char *g = r.raw(cells);
+	if (!r.ok) { delete c; return nullptr; }
+	c->heights.resize(cells);
+	memcpy(c->heights.data(), h, cells * 4);
+	c->ground.assign(g, g + cells);
+	const unsigned int numRoads = r.get<unsigned int>();
+	if (numRoads > 100000) { delete c; return nullptr; }
+	std::vector<RawRoad> raw;
+	raw.reserve(numRoads);
+	for (unsigned int i = 0; i < numRoads && r.ok; ++i) {
+		RawRoad road;
+		road.tmpl = r.get<unsigned short>();
+		r.get<unsigned char>();	// rank
+		road.flags = r.get<unsigned char>();
+		road.width = r.get<float>();	// roads: the game's Roads.ini width is what is drawn; bridges: their own
+		const unsigned int points = r.get<unsigned int>();
+		if (points > 100000) { r.ok = false; break; }
+		const unsigned char *pts = r.raw((size_t)points * 28);
+		if (pts == nullptr) break;
+		road.xyz.resize((size_t)points * 3);
+		for (unsigned int k = 0; k < points; ++k) {
+			float rec[7];	// lx ly lz rx ry rz s
+			memcpy(rec, pts + (size_t)k * 28, sizeof(rec));
+			road.xyz[3 * k] = 0.5f * (rec[0] + rec[3]);
+			road.xyz[3 * k + 1] = 0.5f * (rec[1] + rec[4]);
+			road.xyz[3 * k + 2] = 0.5f * (rec[2] + rec[5]);
+		}
+		if (points >= 2 && road.tmpl < c->strings.size()) raw.push_back(road);
+	}
+	if (r.ok) prepareChunkLines(c, raw);
+	const unsigned int numObjects = r.get<unsigned int>();
+	if (!r.ok || numObjects > 200000) { delete c; return nullptr; }
+	c->objects.reserve(numObjects);
+	for (unsigned int i = 0; i < numObjects && r.ok; ++i) {
+		ChunkObject o;
+		o.tmpl = r.get<unsigned short>();
+		o.kind = r.get<unsigned char>();
+		o.flags = r.get<unsigned char>();
+		o.x = r.get<float>(); o.y = r.get<float>(); o.z = r.get<float>();
+		o.angle = r.get<float>(); o.scale = r.get<float>();
+		o.id = r.get<unsigned long long>();
+		o.created = INVALID_ID;
+		if (r.ok && o.tmpl < c->strings.size()) c->objects.push_back(o);
+	}
+	if (!r.ok) { delete c; return nullptr; }
+	// water: rectangles (any polygon is taken by its bounds)
+	const unsigned int numWater = r.get<unsigned int>();
+	if (!r.ok || numWater > 10000) return c;		// an old payload without water is still a chunk
+	for (unsigned int i = 0; i < numWater && r.ok; ++i) {
+		ChunkWater w;
+		w.z = r.get<float>();
+		w.flags = r.get<unsigned char>();
+		r.raw(3);
+		const unsigned int points = r.get<unsigned int>();
+		if (points > 100000) break;
+		const unsigned char *pts = r.raw((size_t)points * 8);
+		if (pts == nullptr || points < 3) continue;
+		for (unsigned int k = 0; k < points; ++k) {
+			float xy[2];
+			memcpy(xy, pts + (size_t)k * 8, sizeof(xy));
+			if (k < 4) { w.px[k] = xy[0]; w.py[k] = xy[1]; }
+			if (k == 0 || xy[0] < w.x0) w.x0 = xy[0];
+			if (k == 0 || xy[0] > w.x1) w.x1 = xy[0];
+			if (k == 0 || xy[1] < w.y0) w.y0 = xy[1];
+			if (k == 0 || xy[1] > w.y1) w.y1 = xy[1];
+		}
+		if (w.x1 - w.x0 >= 1.0f && w.y1 - w.y0 >= 1.0f) c->water.push_back(w);
+	}
+	return c;
+}
