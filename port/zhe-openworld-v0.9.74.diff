+	const Int row = CodeGuiAtLeast(CodeGuiScaleY(26), 22);
+	Int cy = CodeGuiScaleY(12);
+	CodeGuiLabel(s_screen, pad, cy, w - 2 * pad, row, nullptr, L"WORLD EXPLORATION", TRUE, 16, TRUE);
+	cy += row + CodeGuiScaleY(6);
