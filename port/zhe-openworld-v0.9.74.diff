+//-------------------------------------------------------------------------------------------------
+void GXWorldExploreMenuInit(GameWindow *parentMainMenu, GameWindow *buttonSinglePlayer)
+{
+	s_mainParent = parentMainMenu;
+	s_template = buttonSinglePlayer;
+	s_button = nullptr;
+	s_screen = nullptr;
+	if (TheWorldStream == nullptr || parentMainMenu == nullptr || buttonSinglePlayer == nullptr)
+		return;
+
+	// MainMenuInit runs again over the same windows (the shell re-inits the menu without destroying it): the
+	// column is already seven rows and our button is in it. Take it back; laying the column out twice would
+	// squeeze it to nothing.
+	GameWindow *existing = TheWindowManager->winGetWindowFromId(parentMainMenu, TheNameKeyGenerator->nameToKey("GXWorldExplore:Button"));
+	if (existing != nullptr)
+	{
+		s_button = existing;
+		s_buttonID = (NameKeyType)s_button->winGetWindowId();
+		return;
+	}
+
+	// The stock column: six buttons at an even pitch. Seven go into the same band.
+	GameWindow *column[kStockCount];
+	Int top = 0, bottom = 0, left = 0, width = 0, height = 0;
+	for (Int i = 0; i < kStockCount; ++i)
+	{
+		column[i] = TheWindowManager->winGetWindowFromId(parentMainMenu, TheNameKeyGenerator->nameToKey(kStockColumn[i]));
+		if (column[i] == nullptr || column[i]->winGetParent() != buttonSinglePlayer->winGetParent())
+			return;		// not the layout this was written for: leave the menu alone
+		Int x, y, w, h;
+		column[i]->winGetPosition(&x, &y);
+		column[i]->winGetSize(&w, &h);
+		if (i == 0) { top = y; left = x; width = w; height = h; }
+		if (y + h > bottom) bottom = y + h;
+	}
+	Int secondY = 0, dummy = 0;
+	column[1]->winGetPosition(&dummy, &secondY);
+	const Int gap = secondY - (top + height);
+	if (gap < 0 || bottom <= top)
+		return;
+	const Int rows = kStockCount + 1;
+	const Int newHeight = (bottom - top - gap * (rows - 1)) / rows;
+	if (newHeight < 12)
+		return;
+	const Int pitch = newHeight + gap;
+	// SOLO PLAY, WORLD EXPLORATION, then the rest
+	column[0]->winSetSize(width, newHeight);
+	column[0]->winSetPosition(left, top);
+	for (Int i = 1; i < kStockCount; ++i)
+	{
+		Int x, y;
+		column[i]->winGetPosition(&x, &y);
+		column[i]->winSetSize(width, newHeight);
+		column[i]->winSetPosition(x, top + (i + 1) * pitch);
+	}
+	s_button = CodeGuiButtonLike(buttonSinglePlayer, kStockColumn[0], "GXWorldExplore:Button",
+		left, top + pitch, width, newHeight, L"WORLD EXPLORATION");
+	if (s_button != nullptr)
+	{
+		s_buttonID = (NameKeyType)s_button->winGetWindowId();
+		s_button->winHide(buttonSinglePlayer->winIsHidden());
+	}
+}
+
+//-------------------------------------------------------------------------------------------------
+void GXWorldExploreMenuUpdate()
+{
+	if (TheWorldStream == nullptr)
+		return;
+	if (s_button != nullptr && s_template != nullptr)
+	{
+		// in the top-level menu exactly when SOLO PLAY is
+		const Bool hide = s_template->winIsHidden();
+		if (s_button->winIsHidden() != hide)
+			s_button->winHide(hide);
+	}
+	// ZHE_AUTOSTART=<place>: open the screen, search the place and start at the first hit, once, with no click.
+	// "Play OpenWorld.cmd <place>" sets it; the automated tests drive the whole path with it.
+	static Int s_auto = -1;		// -1 unread, 0 off / done, 1 open the screen, 2 search, 3 wait for places
+	static UnicodeString s_autoPlace;
+	if (s_auto < 0)
+	{
+		const char *env = getenv("ZHE_AUTOSTART");
+		s_auto = (env != nullptr && env[0] != '\0') ? 1 : 0;
+		if (s_auto)
+		{
+			s_autoPlace.translate(AsciiString(env));
+			settingsFromEnvironment();
+		}
+	}
+	if (s_auto == 1 && s_button != nullptr && !s_button->winIsHidden())
+	{
+		openScreen();
+		s_auto = s_screen != nullptr ? 2 : 0;
+	}
+
+	if (s_screen == nullptr)
+		return;
+
+	const GXWorldStreamInterface::State state = TheWorldStream->getState();
+	if (s_auto == 2 && state == GXWorldStreamInterface::STATE_READY)
+	{
+		TheWorldStream->search(s_autoPlace);
+		s_auto = 3;
+	}
+	else if (s_auto == 3 && state == GXWorldStreamInterface::STATE_READY && TheWorldStream->getSearchSerial() != s_shownSerial)
+	{
+		fillPlaces();
+		s_auto = 0;
+		doStart();
+	}
+	if (TheWorldStream->getSearchSerial() != s_shownSerial)
+		fillPlaces();
+
+	if (s_status != nullptr)
+	{
+		UnicodeString text = TheWorldStream->getStatusText();
+		if (state == GXWorldStreamInterface::STATE_OFFLINE)
+			text = UnicodeString(L"The world server is not running. Start the game with \"Play OpenWorld.cmd\".");
+		else if (state == GXWorldStreamInterface::STATE_OPENING)
+			text.format(L"Downloading the world around the spawn point... %d%%", (Int)(TheWorldStream->getOpenProgress() * 100.0f));
+		GadgetStaticTextSetText(s_status, text);
+	}
+	if (s_darkSlider != nullptr || s_capSlider != nullptr)
+	{
+		readSettings();			// the sliders' labels follow them as they are dragged
+		showSliderLabels();
+	}
+	const Bool idle = state == GXWorldStreamInterface::STATE_READY || state == GXWorldStreamInterface::STATE_SESSION_READY;
+	if (s_search != nullptr) s_search->winEnable(idle && !s_starting);
+	if (s_start != nullptr) s_start->winEnable(idle && !s_starting && TheWorldStream->getPlaceCount() > 0);
+
+	if (s_starting)
+	{
+		// the state as it is now: doStart() above may have just opened the session (OPENING) in this very update
+		const GXWorldStreamInterface::State now = TheWorldStream->getState();
+		if (now == GXWorldStreamInterface::STATE_SESSION_READY)
+		{
+			const AsciiString map = TheWorldStream->getBaseMapPath();
+			closeScreen();
+			setupGameStart(map, DIFFICULTY_NORMAL);
+		}
+		else if (now != GXWorldStreamInterface::STATE_OPENING)
+		{
+			s_starting = FALSE;		// the open failed: the status line says why
+		}
+	}
+}
