+static GameWindow *s_search = nullptr;
+static GameWindow *s_start = nullptr;
+static GameWindow *s_back = nullptr;
+static Int s_shownSerial = -1;
+static Bool s_starting = FALSE;								///< Start was pressed: waiting for the first window
+static NameKeyType s_buttonID = NAMEKEY_INVALID;
+
+// the dev / sandbox settings (kept for the session of the game; GXWorldSettings has the defaults)
+static GXWorldSettings s_settings;
+static GameWindow *s_grid = nullptr;					///< cycles the window size
+static GameWindow *s_mode = nullptr;					///< cycles RTS / free camera <-> test vehicle
+static GameWindow *s_follow = nullptr;
+static GameWindow *s_layerBuildings = nullptr;
+static GameWindow *s_layerRoads = nullptr;
+static GameWindow *s_layerTrees = nullptr;
+static GameWindow *s_debugOverlay = nullptr;
+static GameWindow *s_wireframe = nullptr;
+static GameWindow *s_zombie = nullptr;				///< ZOMBIE MODE: OFF / ON (the Humvee only)
+static GameWindow *s_worldView = nullptr;			///< WORLD: REVEALED / GREY / BLACK
+static GameWindow *s_darkLabel = nullptr;
+static GameWindow *s_darkSlider = nullptr;		///< 0..100 % darker
+static GameWindow *s_capLabel = nullptr;
+static GameWindow *s_capSlider = nullptr;			///< the zombies alive at once, in steps of kCapStep
+static GameWindow *s_keyDriving = nullptr;		///< the arrows drive the followed Humvee
+static const Int kCapStep = 50;
+static const Int kCapMin = 50, kCapMax = 3000;
+static const Int kGridSizes[] = { 5, 7, 9, 11, 13, 25 };		// 25: the 4 km world (GXWorldStream.cpp, THE BIG WINDOW)
+
+static void closeScreen();
+static void showSliderLabels();
+
+//-------------------------------------------------------------------------------------------------
+static void showSettings()
+{
+	if (s_grid != nullptr)
+	{
+		UnicodeString text;
+		text.format(L"GRID: %dx%d (~%.1f km)", s_settings.window, s_settings.window, s_settings.window * 0.16f);
+		GadgetButtonSetText(s_grid, text);
+	}
+	if (s_mode != nullptr)
+		GadgetButtonSetText(s_mode, UnicodeString(s_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE ?
+			L"MODE: TEST VEHICLE (HUMVEE)" : L"MODE: RTS / FREE CAMERA"));
+	if (s_follow != nullptr)
+		s_follow->winEnable(s_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE);
+	if (s_layerTrees != nullptr)
+		GadgetButtonSetText(s_layerTrees, UnicodeString(s_settings.treeMode == GXWorldSettings::TREES_OFF ? L"TREES: OFF" :
+			s_settings.treeMode == GXWorldSettings::TREES_UNLIMITED ? L"TREES: UNLIMITED" : L"TREES: OPTIMIZED"));
+	const Bool vehicle = s_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE;
+	if (s_zombie != nullptr)
+	{
+		GadgetButtonSetText(s_zombie, UnicodeString(!vehicle ? L"ZOMBIE MODE: HUMVEE ONLY" :
+			s_settings.zombieMode ? L"ZOMBIE MODE: ON" : L"ZOMBIE MODE: OFF"));
+		s_zombie->winEnable(vehicle);
+	}
+	if (s_worldView != nullptr)
+		GadgetButtonSetText(s_worldView, UnicodeString(s_settings.worldView == GXWorldSettings::VIEW_GREY ? L"WORLD: GREY (FOG)" :
+			s_settings.worldView == GXWorldSettings::VIEW_BLACK ? L"WORLD: BLACK (UNEXPLORED)" : L"WORLD: REVEALED"));
+	if (s_capSlider != nullptr)
+		s_capSlider->winEnable(vehicle && s_settings.zombieMode);
+	showSliderLabels();
+}
+
+//-------------------------------------------------------------------------------------------------
+static void showSliderLabels()
+{
+	if (s_darkLabel != nullptr)
+	{
+		UnicodeString text;
+		text.format(L"World darkness: %d%%", s_settings.darkness);
+		GadgetStaticTextSetText(s_darkLabel, text);
+	}
+	if (s_capLabel != nullptr)
+	{
+		UnicodeString text;
+		text.format(L"Zombie limit (alive at once): %d", s_settings.zombieCap);
+		GadgetStaticTextSetText(s_capLabel, text);
+	}
+}
+
+//-------------------------------------------------------------------------------------------------
+static void readSettings()
+{
+	if (s_follow) s_settings.followCamera = GadgetCheckBoxIsChecked(s_follow);
+	if (s_layerBuildings) s_settings.buildings = GadgetCheckBoxIsChecked(s_layerBuildings);
+	if (s_layerRoads) s_settings.roads = GadgetCheckBoxIsChecked(s_layerRoads);
+	s_settings.trees = s_settings.treeMode != GXWorldSettings::TREES_OFF;
+	if (s_debugOverlay) s_settings.debugOverlay = GadgetCheckBoxIsChecked(s_debugOverlay);
+	if (s_wireframe) s_settings.wireframe = GadgetCheckBoxIsChecked(s_wireframe);
+	if (s_keyDriving) s_settings.keyDriving = GadgetCheckBoxIsChecked(s_keyDriving);
+	if (s_darkSlider) s_settings.darkness = GadgetSliderGetPosition(s_darkSlider);
+	if (s_capSlider) s_settings.zombieCap = GadgetSliderGetPosition(s_capSlider) * kCapStep;
+	if (s_settings.zombieCap < kCapMin) s_settings.zombieCap = kCapMin;
+	if (s_settings.zombieCap > kCapMax) s_settings.zombieCap = kCapMax;
+}
+
+//-------------------------------------------------------------------------------------------------
+/** ZHE_AUTOSTART's companions, so a test can pick the settings with nobody at the mouse:
+	ZHE_WINDOW=<odd n>  ZHE_SPAWN=vehicle|free  ZHE_FOLLOW=0|1  ZHE_OVERLAY=0|1  ZHE_NOBUILDINGS=1  ZHE_NOROADS=1 */
+static void settingsFromEnvironment()
+{
+	const char *v;
+	if ((v = getenv("ZHE_WINDOW")) != nullptr && atoi(v) >= 3)
+		s_settings.window = atoi(v) | 1;
+	if ((v = getenv("ZHE_SPAWN")) != nullptr)
+		s_settings.spawnMode = (v[0] == 'v' || v[0] == 'V') ? GXWorldSettings::SPAWN_VEHICLE : GXWorldSettings::SPAWN_FREE_CAMERA;
+	if ((v = getenv("ZHE_FOLLOW")) != nullptr)
+		s_settings.followCamera = v[0] != '0';
+	if ((v = getenv("ZHE_OVERLAY")) != nullptr)
+		s_settings.debugOverlay = v[0] == '1';
+	if ((v = getenv("ZHE_NOBUILDINGS")) != nullptr && v[0] == '1')
+		s_settings.buildings = FALSE;
+	if ((v = getenv("ZHE_NOROADS")) != nullptr && v[0] == '1')
+		s_settings.roads = FALSE;
+	// ZHE_TREES=off|optimized|unlimited
+	if ((v = getenv("ZHE_TREES")) != nullptr && v[0] != '\0')
+		s_settings.treeMode = (v[0] == 'o' && v[1] == 'f') ? GXWorldSettings::TREES_OFF :
+			(v[0] == 'u' || v[0] == 'U') ? GXWorldSettings::TREES_UNLIMITED : GXWorldSettings::TREES_OPTIMIZED;
+	s_settings.trees = s_settings.treeMode != GXWorldSettings::TREES_OFF;
+	// ZHE_ZOMBIES=1  ZHE_WORLDVIEW=revealed|grey|black  ZHE_DARKNESS=<0..100>  ZHE_ZOMBIECAP=<n>
+	if ((v = getenv("ZHE_ZOMBIES")) != nullptr)
+		s_settings.zombieMode = v[0] == '1';
+	if ((v = getenv("ZHE_WORLDVIEW")) != nullptr && v[0] != '\0')
+		s_settings.worldView = (v[0] == 'g' || v[0] == 'G') ? GXWorldSettings::VIEW_GREY :
+			(v[0] == 'b' || v[0] == 'B') ? GXWorldSettings::VIEW_BLACK : GXWorldSettings::VIEW_REVEALED;
+	if ((v = getenv("ZHE_DARKNESS")) != nullptr && v[0] != '\0')
+		s_settings.darkness = atoi(v) < 0 ? 0 : atoi(v) > 100 ? 100 : atoi(v);
+	if ((v = getenv("ZHE_ZOMBIECAP")) != nullptr && atoi(v) > 0)
+		s_settings.zombieCap = atoi(v) < kCapMin ? kCapMin : atoi(v) > kCapMax ? kCapMax : atoi(v);
+}
+
+//-------------------------------------------------------------------------------------------------
+static void fillPlaces()
+{
+	if (s_list == nullptr || TheWorldStream == nullptr)
+		return;
+	GadgetListBoxReset(s_list);
+	const Color white = GameMakeColor(255, 255, 255, 255);
+	for (Int i = 0; i < TheWorldStream->getPlaceCount(); ++i)
+	{
+		const GXWorldPlace *p = TheWorldStream->getPlace(i);
+		UnicodeString line;
+		line.format(L"%ls", p->name.str());
+		GadgetListBoxAddEntryText(s_list, line, white, -1, 0);
+	}
+	if (TheWorldStream->getPlaceCount() > 0)
+		GadgetListBoxSetSelected(s_list, 0);
+	s_shownSerial = TheWorldStream->getSearchSerial();
+}
+
+//-------------------------------------------------------------------------------------------------
+static void doSearch()
+{
+	if (TheWorldStream == nullptr || s_entry == nullptr || s_starting)
+		return;
+	UnicodeString query = GadgetTextEntryGetText(s_entry);
+	query.trim();
+	if (query.isEmpty())
+		return;
+	TheWorldStream->search(query);
+}
+
+//-------------------------------------------------------------------------------------------------
+static void doStart()
+{
+	if (TheWorldStream == nullptr || s_list == nullptr || s_starting)
+		return;
+	Int selected = -1;
+	GadgetListBoxGetSelected(s_list, &selected);
+	if (selected < 0 || selected >= TheWorldStream->getPlaceCount())
+		return;
+	readSettings();
+	TheWorldStream->setSettings(s_settings);
+	TheWorldStream->open(selected);
+	s_starting = TRUE;
+}
+
+//-------------------------------------------------------------------------------------------------
+static WindowMsgHandledType screenSystem(GameWindow *window, UnsignedInt msg, WindowMsgData mData1, WindowMsgData mData2)
+{
+	switch (msg)
+	{
+		case GWM_INPUT_FOCUS:
+			if (mData1 == TRUE)
+				*(Bool *)mData2 = TRUE;
+			return MSG_HANDLED;
+
+		case GBM_SELECTED:
+		{
+			GameWindow *control = (GameWindow *)mData1;
+			if (control == s_search)
+				doSearch();
+			else if (control == s_start)
+				doStart();
+			else if (control == s_grid)
+			{
+				Int next = kGridSizes[0];
+				for (Int i = 0; i < (Int)ARRAY_SIZE(kGridSizes); ++i)
+					if (kGridSizes[i] == s_settings.window)
+						next = kGridSizes[(i + 1) % ARRAY_SIZE(kGridSizes)];
+				s_settings.window = next;
+				showSettings();
+			}
+			else if (control == s_layerTrees)
+			{
+				s_settings.treeMode = (s_settings.treeMode + 1) % 3;
+				s_settings.trees = s_settings.treeMode != GXWorldSettings::TREES_OFF;
+				showSettings();
+			}
+			else if (control == s_mode)
+			{
+				s_settings.spawnMode = s_settings.spawnMode == GXWorldSettings::SPAWN_VEHICLE ?
+					GXWorldSettings::SPAWN_FREE_CAMERA : GXWorldSettings::SPAWN_VEHICLE;
+				showSettings();
+			}
+			else if (control == s_zombie)
+			{
+				s_settings.zombieMode = !s_settings.zombieMode;
+				showSettings();
+			}
+			else if (control == s_worldView)
+			{
+				s_settings.worldView = (s_settings.worldView + 1) % 3;
+				showSettings();
+			}
+			else if (control == s_back)
+			{
+				if (TheWorldStream != nullptr)
+					TheWorldStream->cancel();
+				closeScreen();
+			}
+			else
+				readSettings();		// one of the check boxes
+			return MSG_HANDLED;
+		}
+
+		case GEM_EDIT_DONE:
+			doSearch();
+			return MSG_HANDLED;
+
+		case GLM_DOUBLE_CLICKED:
+			doStart();
+			return MSG_HANDLED;
+
+		default:
+			break;
+	}
+	return MSG_IGNORED;
+}
