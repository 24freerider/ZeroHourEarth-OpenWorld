+/** The centre of attention: the followed vehicle, else the point the camera looks at. */
+Bool GXWorldStream::focusPoint(Coord3D *pos, Real *heading)
+{
+	Object *vehicle = findVehicle();
+	if (vehicle != nullptr && followingVehicle()) {
+		*pos = *vehicle->getPosition();
+		*heading = vehicle->getOrientation();
+		return TRUE;
+	}
+	if (TheTacticalView == nullptr) return FALSE;
+	*pos = TheTacticalView->getPosition();
+	*heading = m_focusHeading;
+	return TRUE;
+}
