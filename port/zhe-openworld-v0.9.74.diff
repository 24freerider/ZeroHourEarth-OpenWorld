+Int WorldHeightMap::streamTextureClassOfCell(Int x, Int y) const
+{
+	if (x < 0 || y < 0 || x >= m_width || y >= m_height || m_tileNdxes == nullptr) {
+		return -1;
+	}
+	const Int tile = m_tileNdxes[y * m_width + x] >> 2;
+	for (Int c = 0; c < m_numTextureClasses; c++) {
+		const TXTextureClass &tc = m_textureClasses[c];
+		if (tile >= tc.firstTile && tile < tc.firstTile + tc.numTiles) {
+			return c;
+		}
+	}
+	return -1;
