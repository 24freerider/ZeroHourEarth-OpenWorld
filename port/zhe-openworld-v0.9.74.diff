+/// One road of a chunk, ready to draw: its centre line reduced to the points that matter (ends, junctions inside the
+/// chunk, bends), chunk-relative world units. A bridge keeps its deck height in z; its type is a Roads.ini bridge.
+struct ChunkLine
+{
+	unsigned short tmpl;
+	unsigned char flags;
+	Real width = 0.0f;				///< a bridge's deck width (world units), as the real one is
+	std::vector<Real> xyz;		///< x0 y0 z0 x1 y1 z1 ...
+	Int points() const { return (Int)(xyz.size() / 3); }
+};
