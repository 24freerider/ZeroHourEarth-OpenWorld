+// ------------------------------------------------------------------------------------------------ network
+void GXWorldStream::connect()
+{
+	if (!m_threadStarted) {
+		m_threadStarted = TRUE;
+		m_thread = std::thread(&GXWorldStream::threadMain, this);
+	}
+}
+
+void GXWorldStream::threadMain()
+{
+	while (!m_quit) {
+		if (!m_socket.open("127.0.0.1", kPort)) {
+			for (int i = 0; i < 10 && !m_quit; ++i) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+			continue;
+		}
+		{
+			// the hello goes out from here so the game thread never sees a half-open connection
+			Writer w;
+			w.put<unsigned int>(6 + 4); w.put<unsigned short>(M_HELLO); w.put<unsigned int>(0); w.put<unsigned int>(kProtocol);
+			std::lock_guard<std::mutex> guard(m_sendLock);
+			m_socket.sendAll(w.b.data(), w.b.size());
+		}
+		m_connected = true;
+		for (;;) {
+			unsigned int length = 0;
+			if (!m_socket.recvAll(&length, 4) || length < 6 || length > (64u << 20)) break;
+			std::string frame(length, '\0');
+			if (!m_socket.recvAll(&frame[0], length)) break;
+			Message m;
+			memcpy(&m.type, frame.data(), 2);
+			memcpy(&m.rid, frame.data() + 2, 4);
+			if (m.type == R_CHUNK && length >= 6 + 12) {
+				// inflate here, off the game thread: body = the raw chunk payload
+				unsigned int rawSize = 0;
+				memcpy(&rawSize, frame.data() + 6 + 8, 4);
+				if (rawSize == 0 || rawSize > (64u << 20)) break;
+				m.body.resize(rawSize);
+				if (!GXWorldInflate((const unsigned char *)frame.data() + 18, length - 18, (unsigned char *)&m.body[0], rawSize)) break;
+				// parse and prepare its roads here too: the game thread only places what is ready
+				m.chunk = parseChunk(m.body);
+				std::string().swap(m.body);
+			} else {
+				m.body.assign(frame.data() + 6, length - 6);
+			}
+			std::lock_guard<std::mutex> guard(m_lock);
+			m_incoming.push_back(std::move(m));
+		}
+		m_connected = false;
+		m_socket.close();
+		{
+			Message lost;
+			lost.type = 0;		// "the connection was lost"
+			lost.rid = 0;
+			std::lock_guard<std::mutex> guard(m_lock);
+			m_incoming.push_back(lost);
+		}
+	}
+}
+
+unsigned int GXWorldStream::sendMessage(unsigned short type, const std::string &body)
+{
+	const unsigned int rid = m_nextRid++;
+	if (!m_connected) {
+		return rid;
+	}
+	Writer w;
+	w.put<unsigned int>((unsigned int)(6 + body.size()));
+	w.put<unsigned short>(type);
+	w.put<unsigned int>(rid);
+	w.b += body;
+	std::lock_guard<std::mutex> guard(m_sendLock);
+	m_socket.sendAll(w.b.data(), w.b.size());
+	return rid;
+}
+
+void GXWorldStream::pump()
+{
+	std::deque<Message> batch;
+	{
+		std::lock_guard<std::mutex> guard(m_lock);
+		batch.swap(m_incoming);
+	}
+	for (size_t i = 0; i < batch.size(); ++i) {
+		handle(batch[i]);
+	}
+	if (!m_connected && !m_active && m_state != STATE_OFFLINE) {
+		m_state = STATE_OFFLINE;
+		setStatus(L"The world server is not running.");
+	}
+}
+
+void GXWorldStream::handle(const Message &m)
+{
+	Reader r(m.body);
+	switch (m.type) {
+	case 0:	// connection lost
+		m_requested.clear();
+		if (!m_active) {
+			m_state = STATE_OFFLINE;
+			m_hasSession = FALSE;
+			setStatus(L"The world server is not running.");
+		} else {
+			wsLog("the world server went away; carrying on with what is loaded");
+		}
+		break;
+
+	case R_HELLO_OK:
+		wsLog("connected to the world server");
+		if (m_active && m_hasSession) {
+			// the server restarted under a running game: open the same place again, the grid is the same
+			Writer w;
+			w.put<double>(m_openPlace.lat); w.put<double>(m_openPlace.lon); w.str(m_placeName);
+			w.put<unsigned short>((unsigned short)m_window);
+			w.put<unsigned char>((unsigned char)((m_settings.buildings ? LAYER_BUILDINGS : 0) | (m_settings.roads ? LAYER_ROADS : 0) | (m_settings.trees ? LAYER_TREES : 0) | (m_settings.zombies() ? LAYER_ZOMBIES : 0)));
+			m_openRid = sendMessage(M_OPEN, w.b);
+		} else if (m_state == STATE_OFFLINE) {
+			m_state = STATE_READY;
+			setStatus(L"Type a place and press Search.");
+		}
+		break;
+
+	case R_PLACES: {
+		if (m.rid != m_searchRid) break;
+		m_places.clear();
+		const unsigned short count = r.get<unsigned short>();
+		for (unsigned short i = 0; i < count && r.ok; ++i) {
+			GXWorldPlace p;
+			p.lat = r.get<double>();
+			p.lon = r.get<double>();
+			const std::wstring name = GXWorldUtf8ToWide(r.str());
+			p.name = UnicodeString(name.c_str());
+			p.kind = AsciiString(r.str().c_str());
+			if (r.ok) m_places.push_back(p);
+		}
+		++m_searchSerial;
+		if (m_state == STATE_SEARCHING) m_state = STATE_READY;
+		setStatus(m_places.empty() ? L"No such place was found." : L"Pick a place and press Start.");
+		break;
+	}
+
+	case R_OPENED: {
+		if (m.rid != m_openRid) break;
+		m_anchorLat = r.get<double>(); m_anchorLon = r.get<double>();
+		m_mpc = r.get<float>();
+		const Int n = r.get<unsigned short>();
+		const Int window = r.get<unsigned short>();
+		const Int spawnCx = r.get<int>(), spawnCy = r.get<int>();
+		m_spawnX = r.get<double>(); m_spawnY = r.get<double>();
+		m_spawnZ = r.get<float>(); m_spawnHeading = r.get<float>(); m_zBase = r.get<float>();
+		const unsigned short classes = r.get<unsigned short>();
+		std::vector<std::string> names;
+		for (unsigned short i = 0; i < classes && r.ok; ++i) names.push_back(r.str());
+		const std::string place = r.str();
+		if (!r.ok || n < 8 || window < 3 || !(window & 1)) {
+			setStatus(L"The world server sent a session this game does not understand.");
+			m_state = STATE_READY;
+			break;
+		}
+		if (m_active) {
+			// a reconnect during play: same grid, just ask again for what is missing
+			m_requested.clear();
+			break;
+		}
+		dropChunks();
+		m_n = n; m_window = window;
+		m_groundClasses = names;
+		m_placeName = place;
+		m_winCx = spawnCx - window / 2;
+		m_winCy = spawnCy - window / 2;
+		m_hasSession = TRUE;
+		wsLog("session at %.4f,%.4f: chunk %d cells, window %d, spawn chunk %d,%d", m_anchorLat, m_anchorLon, n, window, spawnCx, spawnCy);
+		for (Int cy = m_winCy; cy < m_winCy + window; ++cy) requestBlock(m_winCx, cy, window, 1);	// rows: a request holds at most 400
+		setStatus(L"Downloading the world around the spawn point...");
+		break;
+	}
+
+	case R_CHUNK: {
+		Chunk *c = m.chunk;
+		if (c == nullptr) { wsLog("a damaged chunk was dropped"); break; }
+		if (c->n != m_n || !m_hasSession) { delete c; break; }
+		const ChunkKey key = { c->cx, c->cy };
+		m_requested.erase(key);		// it came: it may be asked for again once it is dropped
+		c->askedAt = wsNow();
+		std::map<ChunkKey, Chunk *>::iterator have = m_chunks.find(key);
+		if (have != m_chunks.end() && have->second->incomplete) {
+			replaceChunk(have->second, c);		// the full version of a chunk that came incomplete
+			break;
+		}
+		if (have != m_chunks.end() || m_parked.find(key) != m_parked.end()) { delete c; break; }	// already have it
+		m_chunks[key] = c;
+		if (m_state == STATE_OPENING && coreReady()) {
+			m_state = STATE_SESSION_READY;
+			setStatus(L"Ready.");
+		}
+		break;
+	}
+
+	case R_DONE:
+		break;
+
+	case R_ERROR: {
+		const std::wstring text = GXWorldUtf8ToWide(r.str());
+		wsLog("server error: %ls", text.c_str());
+		if (!m_active) {
+			m_status = UnicodeString(text.c_str());
+			if (m_state == STATE_SEARCHING || m_state == STATE_OPENING) m_state = STATE_READY;
+		}
+		break;
+	}
+	default:
+		break;
+	}
+}
+
+// ------------------------------------------------------------------------------------------------ menu
+void GXWorldStream::search(const UnicodeString &query)
+{
+	pump();
+	if (m_state != STATE_READY && m_state != STATE_SESSION_READY) return;
+	Writer w;
+	w.str(GXWorldWideToUtf8(std::wstring(query.str())));
+	m_searchRid = sendMessage(M_SEARCH, w.b);
+	m_state = STATE_SEARCHING;
+	m_hasSession = FALSE;
+	setStatus(L"Searching...");
+}
+
+void GXWorldStream::open(Int placeIndex)
+{
+	pump();
+	const GXWorldPlace *p = getPlace(placeIndex);
+	if (p == nullptr || (m_state != STATE_READY && m_state != STATE_SESSION_READY)) return;
+	m_openPlace = *p;
+	Writer w;
+	w.put<double>(p->lat); w.put<double>(p->lon);
+	w.str(GXWorldWideToUtf8(std::wstring(p->name.str())));
+	// protocol 2: the window the player chose and the layers to generate (the server writes the base map to match)
+	w.put<unsigned short>((unsigned short)m_settings.window);
+	w.put<unsigned char>((unsigned char)((m_settings.buildings ? LAYER_BUILDINGS : 0) | (m_settings.roads ? LAYER_ROADS : 0) | (m_settings.trees ? LAYER_TREES : 0) | (m_settings.zombies() ? LAYER_ZOMBIES : 0)));
+	m_hasSession = FALSE;
+	m_openRid = sendMessage(M_OPEN, w.b);
+	m_state = STATE_OPENING;
+	setStatus(L"Opening the place...");
+}
+
+void GXWorldStream::cancel()
+{
+	if (m_active) return;
+	if (m_hasSession) sendMessage(M_CLOSE, std::string());
+	m_hasSession = FALSE;
+	dropChunks();
+	if (m_state == STATE_OPENING || m_state == STATE_SESSION_READY || m_state == STATE_SEARCHING) {
+		m_state = m_connected ? STATE_READY : STATE_OFFLINE;
+	}
+}
+
+Int GXWorldStream::windowChunksPresent() const
+{
+	Int present = 0;
+	for (std::map<ChunkKey, Chunk *>::const_iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		if (inWindow(it->first.cx, it->first.cy)) ++present;
+	}
+	return present;
+}
+
+/** A small window starts whole; the big one once kStartRing chunks around the spawn (the middle) are in - the rest
+comes while the game runs (logicUpdate: late chunks). */
+Bool GXWorldStream::coreReady() const
+{
+	if (!bigWindow()) return windowChunksPresent() == m_window * m_window;
+	const Int mid = m_window / 2;
+	Int present = 0;
+	for (std::map<ChunkKey, Chunk *>::const_iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		const Int dx = it->first.cx - m_winCx - mid, dy = it->first.cy - m_winCy - mid;
+		if (abs(dx) <= kStartRing && abs(dy) <= kStartRing) ++present;
+	}
+	return present == (2 * kStartRing + 1) * (2 * kStartRing + 1);
+}
+
+Real GXWorldStream::getOpenProgress() const
+{
+	if (!m_hasSession) return 0.0f;
+	if (bigWindow()) {
+		const Int mid = m_window / 2;
+		Int present = 0;
+		for (std::map<ChunkKey, Chunk *>::const_iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+			const Int dx = it->first.cx - m_winCx - mid, dy = it->first.cy - m_winCy - mid;
+			if (abs(dx) <= kStartRing && abs(dy) <= kStartRing) ++present;
+		}
+		return (Real)present / (Real)((2 * kStartRing + 1) * (2 * kStartRing + 1));
+	}
+	return (Real)windowChunksPresent() / (Real)(m_window * m_window);
+}
+
+Bool GXWorldStream::focusChunk(Int *fx, Int *fy)
+{
+	Coord3D focus;
+	Real heading = 0.0f;
+	if (!m_active || !focusPoint(&focus, &heading)) {
+		*fx = *fy = m_window / 2;
+		return FALSE;
+	}
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	Int x = REAL_TO_INT_FLOOR(focus.x / chunkUnits), y = REAL_TO_INT_FLOOR(focus.y / chunkUnits);
+	*fx = x < 0 ? 0 : x >= m_window ? m_window - 1 : x;
+	*fy = y < 0 ? 0 : y >= m_window ? m_window - 1 : y;
+	return TRUE;
+}
+
+Int GXWorldStream::focusDistance(const Chunk *c)
+{
+	Int fx, fy;
+	focusChunk(&fx, &fy);
+	const Int dx = abs(c->cx - m_winCx - fx), dy = abs(c->cy - m_winCy - fy);
+	return dx > dy ? dx : dy;
+}
+
+/** The big window: the town's buildings and props are game objects only near the camera (kObjectRing chunks), and
+leave the game past kObjectKeep (a destroyed one is reported and stays destroyed, as when a chunk leaves the window).
+A small window has all of them. */
+void GXWorldStream::updateObjectRing()
+{
+	Int fx, fy;
+	focusChunk(&fx, &fy);
+	m_focusCx = fx;
+	m_focusCy = fy;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		if (!c->applied || !inWindow(c->cx, c->cy)) continue;
+		const Int dx = abs(c->cx - m_winCx - fx), dy = abs(c->cy - m_winCy - fy);
+		const Int d = dx > dy ? dx : dy;
+		if (!bigWindow() || d <= kObjectRing) {
+			if (!c->populated) populate(c);
+		} else if (d > kObjectKeep && c->populated) {
+			depopulate(c);
+		}
+	}
+}
+
+void GXWorldStream::requestBlock(Int cx0, Int cy0, Int nx, Int ny)
+{
+	Bool any = FALSE;
+	const double now = wsNow();
+	for (Int j = 0; j < ny; ++j) {
+		for (Int i = 0; i < nx; ++i) {
+			const ChunkKey key = { cx0 + i, cy0 + j };
+			if (wanted(key, now)) {
+				if (m_requested.find(key) != m_requested.end()) ++m_rerequested;
+				m_requested[key] = now;
+				any = TRUE;
+			}
+		}
+	}
+	if (!any) return;
+	Writer w;
+	w.put<int>(cx0); w.put<int>(cy0); w.put<unsigned short>((unsigned short)nx); w.put<unsigned short>((unsigned short)ny);
+	sendMessage(M_CHUNKS, w.b);
+}
+
+/** INCOMPLETE CHUNKS. The server marks a chunk it made without all of its map data (a tile that did not come, the
+football pitches Overpass has not answered yet) and does not keep it. Such a chunk is asked for again every
+kIncompleteRetry seconds while it is in memory; the full one replaces it (replaceChunk). */
+void GXWorldStream::retryIncomplete()
+{
+	if (!m_connected) return;
+	const double now = wsNow();
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		if (!c->incomplete || now - c->askedAt < kIncompleteRetry) continue;
+		c->askedAt = now;
+		m_requested[it->first] = now;
+		++m_rerequested;
+		Writer w;
+		w.put<int>(c->cx); w.put<int>(c->cy); w.put<unsigned short>(1); w.put<unsigned short>(1);
+		sendMessage(M_CHUNKS, w.b);
+	}
+}
+
+/** The chunk `old` (in the window or around it) gives way to `fresh`: its objects leave the game (a destroyed one
+is reported, and the server keeps it destroyed), its queued creations are dropped, and `fresh` is placed like a chunk
+that came late (logicUpdate: ground, objects, roads, trees, radar). */
+void GXWorldStream::replaceChunk(Chunk *old, Chunk *fresh)
+{
+	const ChunkKey key = { old->cx, old->cy };
+	wsLog("chunk %d,%d came again %s", key.cx, key.cy, fresh->incomplete ? "(still incomplete)" : "complete");
+	if (fresh->incomplete) {			// nothing new yet: keep the one in the game, ask again later
+		delete fresh;
+		old->askedAt = wsNow();
+		return;
+	}
+	if (old->populated) depopulate(old);
+	for (std::deque<Pending>::iterator it = m_createQueue.begin(); it != m_createQueue.end();) {
+		if (it->key.cx == key.cx && it->key.cy == key.cy) it = m_createQueue.erase(it);
+		else ++it;
+	}
+	delete old;
+	m_chunks[key] = fresh;				// not applied: logicUpdate places it this frame
+}
+
+/** Ask for every chunk of the window plus `ring` chunks around it that is neither here nor on its way, as rows
+(one request per run of missing chunks), so the strip a shift brings in is already in memory when it happens. */
+void GXWorldStream::requestAround(Int ring)
+{
+	if (!m_connected) return;
+	const double now = wsNow();
+	for (Int cy = m_winCy - ring; cy < m_winCy + m_window + ring; ++cy) {
+		Int runStart = 0, runLen = 0;
+		for (Int cx = m_winCx - ring; cx <= m_winCx + m_window + ring; ++cx) {
+			const ChunkKey key = { cx, cy };
+			const Bool missing = cx < m_winCx + m_window + ring && wanted(key, now);
+			if (missing) {
+				if (runLen == 0) runStart = cx;
+				++runLen;
+			} else if (runLen > 0) {
+				requestBlock(runStart, cy, runLen, 1);
+				runLen = 0;
+			}
+		}
+	}
+}
+
+// ------------------------------------------------------------------------------------------------ game
+void GXWorldStream::applyTerrain(Chunk *c, WorldHeightMap *map)
+{
+	craterChunk(c);
+	const Int x0 = (c->cx - m_winCx) * m_n, y0 = (c->cy - m_winCy) * m_n;
+	map->streamWriteHeights(x0, y0, m_n, m_n, c->heights.data());
+	if (!m_classToTexture.empty()) {
+		map->streamWriteGround(x0, y0, m_n, m_n, c->ground.data(), m_classToTexture.data(), (Int)m_classToTexture.size());
+		// soft edges: the chunk and the ring of its neighbours' cells along it (their edges now meet new ground)
+		if (!m_texturePriority.empty()) {
+			map->streamBlendGround(x0 - 1, y0 - 1, x0 + m_n, y0 + m_n, m_texturePriority.data(), (Int)m_texturePriority.size());
+		}
+	}
+	map->streamRecomputeCliffs(x0 - 1, y0 - 1, x0 + m_n, y0 + m_n);
+	c->applied = TRUE;
+	m_terrainDirty = TRUE;
+	m_waterDirty = TRUE;
+}
+
+// ------------------------------------------------------------------------------------------------ nuke craters
+// The crater of a nuke: a bowl of radius kCraterShare of the blast's (about 50 m for the zombie run's 420), as deep as a
+// quarter of its radius in the middle, its walls easing out to the old ground (cos²), a low rim up to kCraterRim radii,
+// bare rock inside, and the game's black scorch marks over it.
+static const Real kCraterShare = 0.48f;
+static const Real kCraterRim = 1.3f;
+static const Real kCraterClear = 1.15f;		///< out to here (radii) nothing stands: roads, bridges, props, trees
+static const Int kCraterZones = 3;					///< ash, burnt soil, scorched grass (craterChunk)
+static const Real kCraterZoneEdge[kCraterZones] = { 0.65f, 0.95f, 1.3f };	///< each zone's edge (radii, before the noise)
+static const Real kCraterZoneBand = 0.2f;			///< the patchy band across each edge (radii)
+static const Real kCraterGroundReach = 1.65f;	///< the outer zone, its band and the noise stay inside this (radii)
+
+void GXWorldStream::nukeDetonated(const Coord3D *groundPos, Real blastRadius)
+{
+	GXWorldStream *self = static_cast<GXWorldStream *>(TheWorldStream);
+	if (self == nullptr || !self->m_active || groundPos == nullptr) return;
+	self->addCrater(*groundPos, blastRadius);
+}
+
+Bool GXWorldStream::insideCrater(double ax, double ay) const
+{
+	for (size_t k = 0; k < m_craters.size(); ++k) {
+		const double dx = ax - m_craters[k].ax, dy = ay - m_craters[k].ay, r = m_craters[k].radius * kCraterClear;
+		if (dx * dx + dy * dy < r * r) return TRUE;
+	}
+	return FALSE;
+}
+
+void GXWorldStream::craterChunk(Chunk *c)
+{
+	if (c->cratersDone >= m_craters.size()) return;
+	const double cu = (double)m_n * MAP_XY_FACTOR;
+	const double cx0 = c->cx * cu, cy0 = c->cy * cu;
+	// THE GROUND: three zones (chunkgen.py G_BURNT, G_DIRT, G_SCORCHED; the first and last are in no chunk) - ash in
+	// the middle, burnt soil around it, scorched grass outside - their edges ragged (an angular noise of the crater's
+	// own) and patchy (each cell taken with a chance falling off across a band), so no edge is a circle. A cell keeps
+	// what is more burnt (overlapping craters). A server without the classes: bare rock in the middle only.
+	auto classOf = [&](const char *name) -> Int {
+		for (size_t i = 0; i < m_groundClasses.size(); ++i) {
+			if (m_groundClasses[i] == name && i < m_classToTexture.size() && m_classToTexture[i] >= 0) return (Int)i;
+		}
+		return -1;
+	};
+	Int zoneClass[kCraterZones] = { classOf("DirtMediumType2"), classOf("DirtMediumType1"), classOf("GrassMediumType23brown") };
+	if (zoneClass[0] < 0) zoneClass[0] = classOf("RocksMediumType1");
+	if (zoneClass[2] < 0) zoneClass[1] = zoneClass[2] = -1;		// an old server: no zones, as before
+	auto rankOf = [&](Int cls) -> Int {
+		for (Int z = 0; z < kCraterZones; ++z) {
+			if (cls >= 0 && zoneClass[z] == cls) return kCraterZones - z;
+		}
+		return 0;
+	};
+	const Int n = c->n;
+	const Bool hasGround = c->ground.size() >= (size_t)n * n;
+	for (size_t k = c->cratersDone; k < m_craters.size(); ++k) {
+		const Crater &cr = m_craters[k];
+		const double reach = cr.radius * kCraterGroundReach;
+		if (cr.ax + reach < cx0 || cr.ax - reach > cx0 + cu || cr.ay + reach < cy0 || cr.ay - reach > cy0 + cu) continue;
+		Real phase[3];
+		craterPhases(cr, phase);
+		for (Int j = 0; j < n; ++j) {
+			for (Int i = 0; i < n; ++i) {
+				const double dx = cx0 + i * MAP_XY_FACTOR - cr.ax, dy = cy0 + j * MAP_XY_FACTOR - cr.ay;
+				const Real r = (Real)(sqrt(dx * dx + dy * dy) / cr.radius);
+				if (r >= kCraterGroundReach) continue;
+				if (r < kCraterRim) {
+					Real &z = c->heights[(size_t)j * n + i];
+					if (r < 1.0f) {
+						const Real s = cosf(r * 3.14159265f * 0.5f);
+						z -= cr.depth * s * s;
+					} else {
+						z += cr.depth * 0.15f * sinf((r - 1.0f) / (kCraterRim - 1.0f) * 3.14159265f);
+					}
+				}
+				if (!hasGround) continue;
+				const Real a = (Real)atan2(dy, dx);
+				const Real re = r / (1.0f + 0.10f * sinf(3.0f * a + phase[0]) + 0.07f * sinf(7.0f * a + phase[1]) +
+					0.05f * sinf(13.0f * a + phase[2]));
+				const long long gx = (long long)c->cx * n + i, gy = (long long)c->cy * n + j;
+				for (Int zone = 0; zone < kCraterZones; ++zone) {
+					const Real edge = kCraterZoneEdge[zone], lo = edge - kCraterZoneBand * 0.5f, hi = edge + kCraterZoneBand * 0.5f;
+					unsigned long long h = (unsigned long long)(gx * 7919LL + gy * 104729LL + zone * 15485863LL) * 0x9E3779B97F4A7C15ULL;
+					h ^= h >> 29;
+					const Real chance = (Real)((h >> 11) & 0xFFFF) / 65536.0f;
+					if (re < lo || (re < hi && chance < (hi - re) / kCraterZoneBand)) {
+						UnsignedByte &g = c->ground[(size_t)j * n + i];
+						if (zoneClass[zone] >= 0 && rankOf(zoneClass[zone]) > rankOf((Int)g)) g = (UnsignedByte)zoneClass[zone];
+						break;
+					}
+				}
+			}
+		}
+	}
+	c->cratersDone = m_craters.size();
+}
+
+void GXWorldStream::craterPhases(const Crater &k, Real phase[3])
+{
+	unsigned long long h = (unsigned long long)((long long)k.ax * 73856093LL ^ (long long)k.ay * 19349663LL);
+	for (Int p = 0; p < 3; ++p) {
+		h = h * 6364136223846793005ULL + 1442695040888963407ULL;
+		phase[p] = (Real)((h >> 40) & 0xFFFF) / 65536.0f * 6.2831853f;
+	}
+}
+
+void GXWorldStream::addCraterScorches(const Crater &k)
+{
+	if (TheTerrainRenderObject == nullptr || TheTerrainLogic == nullptr) return;
+	const double cu = (double)m_n * MAP_XY_FACTOR;
+	const Real x = (Real)(k.ax - m_winCx * cu), y = (Real)(k.ay - m_winCy * cu);
+	const Real extent = (Real)(m_window * cu);
+	if (x < -k.radius * 2.0f || y < -k.radius * 2.0f || x > extent + k.radius * 2.0f || y > extent + k.radius * 2.0f) return;
+	const Vector3 at(x, y, TheTerrainLogic->getGroundHeight(x, y));
+	// black in the middle (two layers, each its own type, so neither is taken for a duplicate), and patches around the
+	// burnt soil at the crater's own angles and sizes - no black circle over the ragged zones
+	TheTerrainRenderObject->addScorch(at, k.radius * 0.85f, SCORCH_1);
+	TheTerrainRenderObject->addScorch(at, k.radius * 0.55f, SCORCH_2);
+	unsigned long long h = (unsigned long long)((long long)k.ax * 19349663LL ^ (long long)k.ay * 73856093LL);
+	auto next = [&h]() -> Real {
+		h = h * 6364136223846793005ULL + 1442695040888963407ULL;
+		return (Real)((h >> 40) & 0xFFFF) / 65536.0f;
+	};
+	for (Int s = 0; s < 9; ++s) {
+		const Real a = (s + next() * 0.8f) / 9.0f * 6.2831853f;
+		const Real d = k.radius * (0.7f + 0.45f * next());
+		const Real px = x + cosf(a) * d, py = y + sinf(a) * d;
+		const Vector3 p(px, py, TheTerrainLogic->getGroundHeight(px, py));
+		TheTerrainRenderObject->addScorch(p, k.radius * (0.2f + 0.2f * next()), (Scorches)(SCORCH_1 + s % 4));
+	}
+}
+
+void GXWorldStream::redrawCraterScorches()
+{
+	if (m_craters.empty() || TheTerrainRenderObject == nullptr) return;
+	TheTerrainRenderObject->clearAllScorches();		// they stay where they were drawn: a shift would leave them behind
+	for (size_t k = 0; k < m_craters.size(); ++k) addCraterScorches(m_craters[k]);
+}
+
+void GXWorldStream::addCrater(const Coord3D &pos, Real blastRadius)
+{
+	WorldHeightMap *map = TheTerrainVisual != nullptr ? TheTerrainVisual->getLogicHeightMap() : nullptr;
+	if (map == nullptr) return;
+	const double cu = (double)m_n * MAP_XY_FACTOR;
+	Crater k;
+	k.ax = pos.x + m_winCx * cu;
+	k.ay = pos.y + m_winCy * cu;
+	k.radius = blastRadius * kCraterShare > 80.0f ? blastRadius * kCraterShare : 80.0f;
+	k.depth = k.radius * 0.25f;
+	m_craters.push_back(k);
+	// the chunks of the window under it are written again (applyTerrain digs it in first), out to its scorched grass
+	const double reach = k.radius * kCraterGroundReach;
+	Int written = 0;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		const double cx0 = c->cx * cu, cy0 = c->cy * cu;
+		if (k.ax + reach < cx0 || k.ax - reach > cx0 + cu || k.ay + reach < cy0 || k.ay - reach > cy0 + cu) continue;
+		if (!c->applied || !inWindow(c->cx, c->cy)) { craterChunk(c); continue; }
+		applyTerrain(c, map);
+		++written;
+		if (TheAI != nullptr && TheAI->pathfinder() != nullptr) {
+			IRegion2D cells;
+			cells.lo.x = (c->cx - m_winCx) * m_n; cells.hi.x = cells.lo.x + m_n - 1;
+			cells.lo.y = (c->cy - m_winCy) * m_n; cells.hi.y = cells.lo.y + m_n - 1;
+			TheAI->pathfinder()->invalidateTerrainCache(&cells);
+		}
+	}
+	// nothing stands in it any more: the props go for good (the server keeps them destroyed), the roads and bridges
+	// through it are cut (rebuildRoads, rebuildBridges), the trees are not drawn; a destroyed building stays, a ruin
+	Int props = 0;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		const double cx0 = c->cx * cu, cy0 = c->cy * cu;
+		if (k.ax + reach < cx0 || k.ax - reach > cx0 + cu || k.ay + reach < cy0 || k.ay - reach > cy0 + cu) continue;
+		for (size_t i = 0; i < c->objects.size(); ++i) {
+			ChunkObject &o = c->objects[i];
+			if (o.kind != KIND_PROP || (o.flags & OBJECT_FLAG_DESTROYED) || !insideCrater(cx0 + o.x, cy0 + o.y)) continue;
+			if (o.created != INVALID_ID) {
+				Object *obj = TheGameLogic->findObjectByID(o.created);
+				if (obj != nullptr) TheGameLogic->destroyObject(obj);
+				o.created = INVALID_ID;
+			}
+			o.flags |= OBJECT_FLAG_DESTROYED;
+			Writer w;
+			w.put<unsigned long long>(o.id);
+			sendMessage(M_DESTROYED, w.b);
+			++props;
+		}
+	}
+	rebuildBridges(FALSE);
+	if (!m_roadsDirty) m_roadDue = wsNow();
+	m_roadsDirty = TRUE;
+	if (written > 0) {
+		map->recomputeSampleRange();
+		terrainChanged(FALSE);
+	}
+	if (!m_pathsDirty) m_pathsDue = wsNow();
+	m_pathsDirty = TRUE;
+	// what stands on the ground there goes down with it (aircraft and missiles stay where they fly)
+	if (ThePartitionManager != nullptr) {
+		ObjectIterator *iter = ThePartitionManager->iterateObjectsInRange(&pos, (Real)reach, FROM_CENTER_2D, nullptr);
+		MemoryPoolObjectHolder hold(iter);
+		for (Object *obj = iter->first(); obj != nullptr; obj = iter->next()) {
+			if (obj->isKindOf(KINDOF_AIRCRAFT) || obj->isKindOf(KINDOF_PROJECTILE) || obj->isAirborneTarget()) continue;
+			Coord3D p = *obj->getPosition();
+			p.z = TheTerrainLogic->getGroundHeight(p.x, p.y);
+			obj->setPosition(&p);
+		}
+	}
+	addCraterScorches(k);
+	if (!m_treesDirty) m_treesDue = wsNow();
+	m_treesDirty = TRUE;
+	m_radarDirty = TRUE;
+	wsLog("nuke crater at %.0f,%.0f: radius %.0f, depth %.0f, %d chunk(s) written, %d prop(s) gone", pos.x, pos.y, k.radius,
+		k.depth, written, props);
+}
+
+/** WATER. Each chunk brings its water as rectangles at the level the elevation data measured there; the ground
+inside a rectangle is either under water (the bed) or above it (the bank), so the shore is where the ground crosses the
+level. Each rectangle is a water area (a polygon trigger) of the map, made again for the whole window whenever its
+chunks change; the game finds them per chunk (g_gxStreamWaterLookup), not by walking hundreds of triggers per query. */
+void GXWorldStream::clearWater()
+{
+	g_gxStreamWaterLookup = nullptr;
+	g_gxStreamWaterFirst = nullptr;
+	// our own chain, outside the map's trigger list (PolygonTrigger.h); one at a time (deleting a trigger deletes the
+	// ones linked after it, recursively)
+	for (size_t i = 0; i < m_waterTriggers.size(); ++i) {
+		m_waterTriggers[i]->setNextPoly(nullptr);
+		deleteInstance(m_waterTriggers[i]);
+	}
+	m_waterTriggers.clear();
+	m_waterGrid.clear();
+}
+
+void GXWorldStream::rebuildWater()
+{
+	m_waterDirty = FALSE;
+	const double t0 = wsNow();
+	clearWater();
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	m_waterGrid.assign((size_t)(m_window * m_window), std::vector<WaterRect>());
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		if (!c->applied || !inWindow(c->cx, c->cy) || c->water.empty()) continue;
+		const Real ox = (c->cx - m_winCx) * chunkUnits, oy = (c->cy - m_winCy) * chunkUnits;
+		std::vector<WaterRect> &slot = m_waterGrid[(size_t)((c->cy - m_winCy) * m_window + (c->cx - m_winCx))];
+		for (size_t k = 0; k < c->water.size(); ++k) {
+			const ChunkWater &w = c->water[k];
+			WaterRect r;
+			r.x0 = REAL_TO_INT_FLOOR(ox + w.x0 + 0.5f); r.x1 = REAL_TO_INT_FLOOR(ox + w.x1 + 0.5f);
+			r.y0 = REAL_TO_INT_FLOOR(oy + w.y0 + 0.5f); r.y1 = REAL_TO_INT_FLOOR(oy + w.y1 + 0.5f);
+			r.z = REAL_TO_INT_FLOOR(w.z + 0.5f);
+			r.ford = (w.flags & WATER_FLAG_FORD) != 0;
+			PolygonTrigger *t = newInstance(PolygonTrigger)(4);
+			t->setTriggerName(AsciiString("GXStreamWater"));
+			t->setWaterArea(TRUE);
+			t->setShouldRender(TRUE);
+			ICoord3D p;
+			p.z = r.z;
+			if (r.ford) {
+				// a brook's piece: its own corners, so the water follows the stream instead of the cell grid
+				for (Int q = 0; q < 4; ++q) {
+					r.qx[q] = ox + w.px[q];
+					r.qy[q] = oy + w.py[q];
+					p.x = REAL_TO_INT_FLOOR(r.qx[q] + 0.5f); p.y = REAL_TO_INT_FLOOR(r.qy[q] + 0.5f);
+					t->addPoint(p);
+				}
+			} else {
+				p.x = r.x0; p.y = r.y0; t->addPoint(p);
+				p.x = r.x1; p.y = r.y0; t->addPoint(p);
+				p.x = r.x1; p.y = r.y1; t->addPoint(p);
+				p.x = r.x0; p.y = r.y1; t->addPoint(p);
+			}
+			t->setNextPoly(m_waterTriggers.empty() ? nullptr : m_waterTriggers.back());
+			m_waterTriggers.push_back(t);
+			g_gxStreamWaterFirst = t;
+			r.trigger = t;
+			slot.push_back(r);
+		}
+	}
+	g_gxStreamWaterLookup = &GXWorldStream::waterLookup;
+	if (TheTerrainRenderObject != nullptr) {
+		std::vector<Int> boxes;
+		boxes.reserve(m_waterTriggers.size() * 4);
+		for (size_t s = 0; s < m_waterGrid.size(); ++s) {
+			for (size_t k = 0; k < m_waterGrid[s].size(); ++k) {
+				const WaterRect &r = m_waterGrid[s][k];
+				boxes.push_back(r.x0); boxes.push_back(r.y0); boxes.push_back(r.x1); boxes.push_back(r.y1);
+			}
+		}
+		TheTerrainRenderObject->streamWaterChanged(boxes.empty() ? nullptr : boxes.data(), (Int)(boxes.size() / 4));
+	}
+	m_lastWaterMs = (wsNow() - t0) * 1000.0;
+}
+
+PolygonTrigger *GXWorldStream::waterLookup(Real x, Real y, Bool forLogic)
+{
+	GXWorldStream *self = static_cast<GXWorldStream *>(TheWorldStream);
+	if (self == nullptr || self->m_waterGrid.empty()) return nullptr;
+	const Real chunkUnits = self->m_n * MAP_XY_FACTOR;
+	const Int ix = REAL_TO_INT_FLOOR(x + 0.5f), iy = REAL_TO_INT_FLOOR(y + 0.5f);
+	PolygonTrigger *best = nullptr;
+	Int bestZ = 0;
+	// the point's chunk and, on its edge, the chunk before it (a rectangle ends on the next chunk's first vertex)
+	const Int sx = REAL_TO_INT_FLOOR(x / chunkUnits), sy = REAL_TO_INT_FLOOR(y / chunkUnits);
+	for (Int dy = -1; dy <= 0; ++dy) {
+		for (Int dx = -1; dx <= 0; ++dx) {
+			const Int cx = sx + dx, cy = sy + dy;
+			if (cx < 0 || cy < 0 || cx >= self->m_window || cy >= self->m_window) continue;
+			const std::vector<WaterRect> &slot = self->m_waterGrid[(size_t)(cy * self->m_window + cx)];
+			for (size_t k = 0; k < slot.size(); ++k) {
+				const WaterRect &r = slot[k];
+				if (ix < r.x0 || ix > r.x1 || iy < r.y0 || iy > r.y1) continue;
+				if (forLogic && r.ford) continue;		// a brook: units cross it
+				if (r.ford) {
+					// inside its quad (convex, either winding): the point is on one side of all four edges
+					Int pos = 0, neg = 0;
+					for (Int q = 0; q < 4; ++q) {
+						const Int e = (q + 1) & 3;
+						const Real c = (r.qx[e] - r.qx[q]) * (y - r.qy[q]) - (r.qy[e] - r.qy[q]) * (x - r.qx[q]);
+						if (c > 0.0f) ++pos; else if (c < 0.0f) ++neg;
+					}
+					if (pos > 0 && neg > 0) continue;
+				}
+				if (best == nullptr || r.z > bestZ) { best = r.trigger; bestZ = r.z; }
+			}
+		}
+	}
+	return best;
+}
+
+/** The ground of the window changed: redraw it, and (after a shift) rebuild what the pathfinder knows of it. */
+void GXWorldStream::terrainChanged(Bool rebuildPaths)
+{
+	m_terrainDirty = FALSE;
+	// the water first: the pathfinder classifies cells under water as water
+	if (m_waterDirty) rebuildWater();
+	const double t0 = wsNow();
+	if (TheTerrainRenderObject != nullptr) {
+		TheTerrainRenderObject->streamTerrainChanged();
+	}
+	const double t1 = wsNow();
+	if (rebuildPaths && TheAI != nullptr && TheAI->pathfinder() != nullptr) {
+		TheAI->pathfinder()->rebuildAfterWorldShift();
+	}
+	m_lastVisualMs = (t1 - t0) * 1000.0;
+	m_lastPathMs = (wsNow() - t1) * 1000.0;
+}
+
+/** Every road of the chunks in the window, into the terrain's road buffer (see ROADS at the top). */
+void GXWorldStream::rebuildRoads()
+{
+	m_roadsDirty = FALSE;
+	m_lastRoadBuild = wsNow();
+	if (TheTerrainRenderObject == nullptr || TheTerrainRoads == nullptr) return;
+	const double t0 = wsNow();
+	std::vector<W3DRoadStreamSegment> segments;
+	if (m_settings.roads) {
+		// the lines were prepared when their chunks arrived: here they are only placed, and the points where a road
+		// leaves one chunk and enters the next are welded into one (the buffer links pieces by equal points)
+		PointWelder welder;
+		const Real chunkUnits = m_n * MAP_XY_FACTOR;
+		// the nuke craters, in the window's units: a road is cut where it enters one and goes on past it
+		std::vector<Real> holes;		// x y r per crater
+		for (size_t k = 0; k < m_craters.size(); ++k) {
+			holes.push_back((Real)(m_craters[k].ax - m_winCx * (double)chunkUnits));
+			holes.push_back((Real)(m_craters[k].ay - m_winCy * (double)chunkUnits));
+			holes.push_back(m_craters[k].radius * kCraterClear);
+		}
+		auto addSegment = [&](Real x1, Real y1, Real x2, Real y2, TerrainRoadType *type) {
+			// the parts of x1,y1 -> x2,y2 outside every crater (t along it, 0..1)
+			std::vector<std::pair<Real, Real> > keep(1, std::make_pair(0.0f, 1.0f));
+			const Real dx = x2 - x1, dy = y2 - y1, len2 = dx * dx + dy * dy;
+			for (size_t h = 0; h + 2 < holes.size() && len2 > 0.0f; h += 3) {
+				const Real fx = x1 - holes[h], fy = y1 - holes[h + 1], r = holes[h + 2];
+				const Real b = fx * dx + fy * dy, c = fx * fx + fy * fy - r * r, disc = b * b - len2 * c;
+				if (disc <= 0.0f) continue;
+				const Real s = sqrtf(disc), t0 = (-b - s) / len2, t1 = (-b + s) / len2;
+				if (t1 <= 0.0f || t0 >= 1.0f) continue;
+				std::vector<std::pair<Real, Real> > next;
+				for (size_t q = 0; q < keep.size(); ++q) {
+					if (keep[q].first < t0) next.push_back(std::make_pair(keep[q].first, keep[q].second < t0 ? keep[q].second : t0));
+					if (keep[q].second > t1) next.push_back(std::make_pair(keep[q].first > t1 ? keep[q].first : t1, keep[q].second));
+				}
+				keep.swap(next);
+			}
+			for (size_t q = 0; q < keep.size(); ++q) {
+				if ((keep[q].second - keep[q].first) * (keep[q].second - keep[q].first) * len2 < 1.0f) continue;
+				W3DRoadStreamSegment s;
+				s.x1 = x1 + dx * keep[q].first; s.y1 = y1 + dy * keep[q].first;
+				s.x2 = x1 + dx * keep[q].second; s.y2 = y1 + dy * keep[q].second;
+				s.type = type;
+				segments.push_back(s);
+			}
+		};
+		for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+			Chunk *c = it->second;
+			if (!c->applied || !inWindow(c->cx, c->cy)) continue;
+			// the big window: the roads near the camera (a road type's draw buffer holds 65,535 vertices)
+			if (bigWindow() && focusDistance(c) > kRoadRing) continue;
+			const Real ox = (c->cx - m_winCx) * chunkUnits, oy = (c->cy - m_winCy) * chunkUnits;
+			std::vector<TerrainRoadType *> types(c->strings.size(), nullptr);
+			std::vector<char> looked(c->strings.size(), 0);
+			for (size_t k = 0; k < c->lines.size(); ++k) {
+				const ChunkLine &line = c->lines[k];
+				if (line.flags & ROAD_FLAG_BRIDGE) continue;		// bridges are models of their own (rebuildBridges)
+				if (!looked[line.tmpl]) {
+					looked[line.tmpl] = 1;
+					types[line.tmpl] = TheTerrainRoads->findRoad(AsciiString(c->strings[line.tmpl].c_str()));
+				}
+				if (types[line.tmpl] == nullptr) continue;
+				Int prev = welder.add(ox + line.xyz[0], oy + line.xyz[1]);
+				for (Int p = 1; p < line.points(); ++p) {
+					const Int id = welder.add(ox + line.xyz[3 * p], oy + line.xyz[3 * p + 1]);
+					if (id == prev) continue;
+					addSegment(welder.x[prev], welder.y[prev], welder.x[id], welder.y[id], types[line.tmpl]);
+					prev = id;
+				}
+			}
+		}
+	}
+	m_roadPieces = (Int)segments.size();
+	const double tPrep = wsNow();
+	m_roadSegments = TheTerrainRenderObject->streamSetRoads(segments.empty() ? nullptr : segments.data(), (Int)segments.size());
+	m_lastRoadMs = (wsNow() - t0) * 1000.0;
+	m_lastRoadPrepMs = (tPrep - t0) * 1000.0;
+}
+
+/** The window's bridges as real game bridges (model, GenericBridge object, pathfinder layer). The pieces a chunk edge
+cut apart are joined again, each run is cut into straight spans (a bridge model is straight), and the spans nearest the
+middle of the window are built - the pathfinder has a layer for at most kMaxBridges of them. Returns TRUE when the set
+of bridges changed (the pathfinder must then classify its layers again). Unchanged and `force` FALSE: nothing is done. */
+Bool GXWorldStream::rebuildBridges(Bool force)
+{
+	if (TheTerrainRenderObject == nullptr) return FALSE;
+	struct Piece { std::string name; std::vector<Int> ids; Bool used; Real width; };
+	std::vector<Piece> pieces;
+	std::vector<Real> z;
+	PointWelder welder;
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	if (m_settings.roads) {
+		for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+			Chunk *c = it->second;
+			if (!c->applied || !inWindow(c->cx, c->cy)) continue;
+			const Real ox = (c->cx - m_winCx) * chunkUnits, oy = (c->cy - m_winCy) * chunkUnits;
+			for (size_t k = 0; k < c->lines.size(); ++k) {
+				const ChunkLine &line = c->lines[k];
+				if (!(line.flags & ROAD_FLAG_BRIDGE)) continue;
+				// a nuke crater took it: a bridge that reaches into one is not built
+				if (!m_craters.empty()) {
+					Bool hit = FALSE;
+					for (Int p = 0; p < line.points() && !hit; ++p) {
+						hit = insideCrater(c->cx * (double)chunkUnits + line.xyz[3 * p], c->cy * (double)chunkUnits + line.xyz[3 * p + 1]);
+					}
+					if (hit) continue;
+				}
+				Piece piece;
+				piece.name = c->strings[line.tmpl];
+				piece.used = FALSE;
+				piece.width = line.width;
+				for (Int p = 0; p < line.points(); ++p) {
+					const Int id = welder.add(ox + line.xyz[3 * p], oy + line.xyz[3 * p + 1]);
+					if ((size_t)id >= z.size()) z.resize((size_t)id + 1, line.xyz[3 * p + 2]);
+					if (piece.ids.empty() || piece.ids.back() != id) piece.ids.push_back(id);
+				}
+				if (piece.ids.size() >= 2) pieces.push_back(piece);
+			}
+		}
+	}
+	// join the pieces that meet end to end (a bridge cut by a chunk edge), one bridge name at a time
+	std::vector<Int> ends(welder.x.size(), 0);
+	for (size_t i = 0; i < pieces.size(); ++i) { ends[pieces[i].ids.front()]++; ends[pieces[i].ids.back()]++; }
+	std::vector<W3DStreamBridge> spans;
+	std::vector<std::string> names;
+	for (size_t i = 0; i < pieces.size(); ++i) {
+		if (pieces[i].used) continue;
+		pieces[i].used = TRUE;
+		std::vector<Int> chain = pieces[i].ids;
+		Real width = pieces[i].width;
+		for (Bool grew = TRUE; grew;) {
+			grew = FALSE;
+			for (size_t j = 0; j < pieces.size(); ++j) {
+				if (pieces[j].used || pieces[j].name != pieces[i].name) continue;
+				const std::vector<Int> &q = pieces[j].ids;
+				if (q.front() == chain.back() && ends[q.front()] == 2) chain.insert(chain.end(), q.begin() + 1, q.end());
+				else if (q.back() == chain.back() && ends[q.back()] == 2) chain.insert(chain.end(), q.rbegin() + 1, q.rend());
+				else if (q.back() == chain.front() && ends[q.back()] == 2) chain.insert(chain.begin(), q.begin(), q.end() - 1);
+				else if (q.front() == chain.front() && ends[q.front()] == 2) chain.insert(chain.begin(), q.rbegin(), q.rend() - 1);
+				else continue;
+				pieces[j].used = TRUE;
+				if (pieces[j].width > width) width = pieces[j].width;
+				grew = TRUE;
+			}
+		}
+		// straight spans: the chain's bends (the chunk-edge joins in a straight bridge go away) ...
+		std::vector<char> keep(chain.size(), 0);
+		keep.front() = keep.back() = 1;
+		simplifyRun(welder, chain, 0, (Int)chain.size() - 1, 30.0f, keep);
+		// ... and where the deck rises and falls (over a river, over a road): a span is straight in height too
+		for (Bool split = TRUE; split;) {
+			split = FALSE;
+			Int a = 0;
+			for (Int k = 1; k < (Int)chain.size(); ++k) {
+				if (!keep[k]) continue;
+				const Real x0 = welder.x[chain[a]], y0 = welder.y[chain[a]], x1 = welder.x[chain[k]], y1 = welder.y[chain[k]];
+				const Real len = sqrtf((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
+				Int worst = -1;
+				Real worstDz = 6.0f;		// 1.5 m off the straight deck
+				for (Int m = a + 1; m < k && len > 160.0f; ++m) {
+					const Real t = sqrtf((welder.x[chain[m]] - x0) * (welder.x[chain[m]] - x0) + (welder.y[chain[m]] - y0) * (welder.y[chain[m]] - y0)) / len;
+					if (t * len < 60.0f || (1.0f - t) * len < 60.0f) continue;		// no stub spans of a few metres
+					const Real dz = fabsf(z[chain[m]] - (z[chain[a]] + (z[chain[k]] - z[chain[a]]) * t));
+					if (dz > worstDz) { worstDz = dz; worst = m; }
+				}
+				if (worst >= 0) { keep[worst] = 1; split = TRUE; }
+				a = k;
+			}
+		}
+		Int prev = 0;
+		for (Int k = 1; k < (Int)chain.size(); ++k) {
+			if (!keep[k]) continue;
+			const Int a = chain[prev], b = chain[k];
+			const Real dx = welder.x[b] - welder.x[a], dy = welder.y[b] - welder.y[a];
+			if (dx * dx + dy * dy >= 24.0f * 24.0f) {		// a footbridge over a brook is 6 m
+				W3DStreamBridge s;
+				s.x1 = welder.x[a]; s.y1 = welder.y[a]; s.z1 = z[a];
+				s.x2 = welder.x[b]; s.y2 = welder.y[b]; s.z2 = z[b];
+				s.name = nullptr;
+				s.width = width;
+				spans.push_back(s);
+				names.push_back(pieces[i].name);
+			}
+			prev = k;
+		}
+	}
+	// the nearest to the camera first (the middle of the window before the game runs)
+	Real midX = 0.5f * m_window * chunkUnits, midY = midX;
+	{
+		Coord3D focus;
+		Real heading = 0.0f;
+		if (m_active && focusPoint(&focus, &heading)) { midX = focus.x; midY = focus.y; }
+	}
+	std::vector<size_t> order(spans.size());
+	for (size_t i = 0; i < order.size(); ++i) order[i] = i;
+	std::sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+		const Real da = fabsf(0.5f * (spans[a].x1 + spans[a].x2) - midX) + fabsf(0.5f * (spans[a].y1 + spans[a].y2) - midY);
+		const Real db = fabsf(0.5f * (spans[b].x1 + spans[b].x2) - midX) + fabsf(0.5f * (spans[b].y1 + spans[b].y2) - midY);
+		return da < db;
+	});
+	if (order.size() > (size_t)kMaxBridges) order.resize(kMaxBridges);
+	std::vector<W3DStreamBridge> chosen;
+	std::vector<std::string> chosenNames;
+	std::string signature;
+	for (size_t i = 0; i < order.size(); ++i) {
+		chosen.push_back(spans[order[i]]);
+		chosenNames.push_back(names[order[i]]);
+		char key[96];
+		snprintf(key, sizeof(key), "%.0f,%.0f,%.0f,%.0f;", spans[order[i]].x1, spans[order[i]].y1, spans[order[i]].x2, spans[order[i]].y2);
+		signature += key + names[order[i]];
+	}
+	if (!force && signature == m_bridgeSignature) return FALSE;
+	m_bridgeSignature = signature;
+	for (size_t i = 0; i < chosen.size(); ++i) chosen[i].name = chosenNames[i].c_str();
+	m_bridges = TheTerrainRenderObject->streamSetBridges(chosen.empty() ? nullptr : chosen.data(), (Int)chosen.size());
+	m_bridgeCandidates = (Int)spans.size();
+	m_firstBridge.zero();
+	if (!chosen.empty()) {
+		m_firstBridge.x = 0.5f * (chosen[0].x1 + chosen[0].x2);
+		m_firstBridge.y = 0.5f * (chosen[0].y1 + chosen[0].y2);
+		m_firstBridge.z = 0.5f * (chosen[0].z1 + chosen[0].z2);
+	}
+	static const Bool s_trace = getenv("ZHE_TRACE") != nullptr;
+	if (s_trace) {
+		for (size_t i = 0; i < chosen.size(); ++i) {
+			wsLog("bridge %s %.0f,%.0f,%.0f -> %.0f,%.0f,%.0f, %.1f m wide", chosenNames[i].c_str(), chosen[i].x1, chosen[i].y1, chosen[i].z1,
+				chosen[i].x2, chosen[i].y2, chosen[i].z2, chosen[i].width / 4.0f);
+		}
+	}
+	return TRUE;
+}
+
+/** The radar shows the window as it is now: height range (float heights around ZBASE), shading and colours. */
+void GXWorldStream::refreshRadar()
+{
+	m_radarDirty = FALSE;
+	m_lastRadar = wsNow();
+	WorldHeightMap *map = TheTerrainVisual != nullptr ? TheTerrainVisual->getLogicHeightMap() : nullptr;
+	if (map != nullptr && TheTerrainLogic != nullptr) {
+		TheTerrainLogic->setStreamHeightRange(map->getMinSample() * MAP_HEIGHT_SCALE, map->getMaxSample() * MAP_HEIGHT_SCALE);
+	}
+	if (TheRadar != nullptr && TheTerrainLogic != nullptr) {
+		TheRadar->refreshTerrainRange(TheTerrainLogic);
+		TheRadar->refreshTerrain(TheTerrainLogic);
+		TheRadar->refreshObjects();		// the units' dots moved with the shift too: not 6 frames late
+	}
+	// the horizon past the window: the window's own ground, a little darker, and a haze between it and the sky
+	if (TheTerrainVisual != nullptr) {
+		const Real size = m_window * m_n * MAP_XY_FACTOR;
+		Real r = 0, g = 0, b = 0;
+		Int samples = 0;
+		for (Int j = 0; j < 12; ++j) {
+			for (Int i = 0; i < 12; ++i) {
+				RGBColor c;
+				TheTerrainVisual->getTerrainColorAt((i + 0.5f) * size / 12.0f, (j + 0.5f) * size / 12.0f, &c);
+				r += c.red; g += c.green; b += c.blue;
+				++samples;
+			}
+		}
+		if (samples > 0) {
+			r /= samples; g /= samples; b /= samples;
+			auto pack = [](Real cr, Real cg, Real cb) {
+				const Int ir = REAL_TO_INT(cr * 255.0f), ig = REAL_TO_INT(cg * 255.0f), ib = REAL_TO_INT(cb * 255.0f);
+				return (UnsignedInt)(((ir < 0 ? 0 : ir > 255 ? 255 : ir) << 16) | ((ig < 0 ? 0 : ig > 255 ? 255 : ig) << 8) | (ib < 0 ? 0 : ib > 255 ? 255 : ib));
+			};
+			const Real k = 0.8f;					// the far land is a shade darker than the ground underfoot
+			const Real h = 0.6f;					// how much of the sky is in the haze
+			g_gxHorizonGround = pack(r * k, g * k, b * k) | 0xFF000000;
+			g_gxHorizonHaze = pack(r * (1 - h) + 0.66f * h, g * (1 - h) + 0.73f * h, b * (1 - h) + 0.80f * h) | 0xFF000000;
+		}
+	}
+}
+
+void GXWorldStream::populate(Chunk *c)
+{
+	if (c->populated) return;
+	c->populated = TRUE;
+	if (!m_settings.buildings) return;
+	const ChunkKey key = { c->cx, c->cy };
+	for (size_t i = 0; i < c->objects.size(); ++i) {
+		const ChunkObject &o = c->objects[i];
+		// buildings and the town's props (graves, playgrounds, benches, parked cars) are game objects; trees are not.
+		// A destroyed building comes back as its ruin (createQueued); a destroyed prop does not come back
+		if ((o.kind != KIND_BUILDING && o.kind != KIND_PROP) || o.created != INVALID_ID) continue;
+		if ((o.flags & OBJECT_FLAG_DESTROYED) && o.kind != KIND_BUILDING) continue;
+		Pending p = { key, i };
+		m_createQueue.push_back(p);
+	}
+}
+
+/** Remove the chunk's objects from the game (it left the window). An object that is already gone was destroyed
+by the player: the world server is told, and it stays gone. */
+void GXWorldStream::depopulate(Chunk *c)
+{
+	for (size_t i = 0; i < c->objects.size(); ++i) {
+		ChunkObject &o = c->objects[i];
+		if (o.created == INVALID_ID) continue;
+		Object *obj = TheGameLogic->findObjectByID(o.created);
+		if ((obj == nullptr || obj->isEffectivelyDead()) && !(o.flags & OBJECT_FLAG_DESTROYED)) {		// a ruin: told already
+			o.flags |= OBJECT_FLAG_DESTROYED;
+			Writer w;
+			w.put<unsigned long long>(o.id);
+			sendMessage(M_DESTROYED, w.b);
+		}
+		if (obj != nullptr) {
+			TheGameLogic->destroyObject(obj);
+		}
+		o.created = INVALID_ID;
+	}
+	c->populated = FALSE;
+}
+
+/** TREES. The server places them (forests, orchards, parks, scrub; conifers higher up). They are drawn by the
+terrain's tree buffer - the same instanced drawing a map's trees get - with no game object behind them, so tens of
+thousands cost little; they sway, but do not block or burn. After a shift (they all moved) or when chunks came, the
+buffer is filled again from the window's chunks, nearest the camera first:
+	TREES_OPTIMIZED - every tree within two chunks of the window's middle, one in three farther out, no bushes there,
+	                  at most kOptimizedTrees;
+	TREES_UNLIMITED - every tree and bush, up to the buffer's 32,000. */
+static const Int kOptimizedTrees = 12000;
+static const Int kUnlimitedTrees = 32000;
+
+void GXWorldStream::rebuildTrees()
+{
+	m_treesDirty = FALSE;
+	const double t0 = wsNow();
+	if (TheTerrainRenderObject == nullptr) return;
+	TheTerrainRenderObject->streamClearTrees();
+	m_treesDrawn = m_treesInWindow = 0;
+	if (m_settings.treeMode == GXWorldSettings::TREES_OFF || TheThingFactory == nullptr) return;
+	const Bool optimized = m_settings.treeMode != GXWorldSettings::TREES_UNLIMITED;
+	const Int cap = optimized ? kOptimizedTrees : kUnlimitedTrees;
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	// the window's chunks, nearest the camera first (a cap then leaves out the far ones)
+	std::vector<std::pair<Int, Chunk *> > order;
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		Chunk *c = it->second;
+		if (!c->applied || !inWindow(c->cx, c->cy)) continue;
+		order.push_back(std::make_pair(focusDistance(c), c));
+	}
+	std::stable_sort(order.begin(), order.end(),
+		[](const std::pair<Int, Chunk *> &a, const std::pair<Int, Chunk *> &b) { return a.first < b.first; });
+	for (size_t k = 0; k < order.size(); ++k) {
+		Chunk *c = order[k].second;
+		const Bool thin = optimized && order[k].first > 2;
+		const Real ox = (c->cx - m_winCx) * chunkUnits, oy = (c->cy - m_winCy) * chunkUnits;
+		std::vector<const W3DTreeDrawModuleData *> data(c->strings.size(), nullptr);
+		std::vector<char> looked(c->strings.size(), 0), bush(c->strings.size(), 0);
+		for (size_t i = 0; i < c->objects.size(); ++i) {
+			const ChunkObject &o = c->objects[i];
+			if (o.kind != KIND_TREE || (o.flags & OBJECT_FLAG_DESTROYED)) continue;
+			if (!m_craters.empty() && insideCrater(c->cx * (double)chunkUnits + o.x, c->cy * (double)chunkUnits + o.y)) continue;
+			++m_treesInWindow;
+			if (!looked[o.tmpl]) {
+				looked[o.tmpl] = 1;
+				const std::string &name = c->strings[o.tmpl];
+				bush[o.tmpl] = name.compare(0, 4, "Bush") == 0;
+				std::map<std::string, const W3DTreeDrawModuleData *>::iterator d = m_treeData.find(name);
+				if (d == m_treeData.end()) {
+					const W3DTreeDrawModuleData *found = nullptr;
+					const ThingTemplate *tmpl = TheThingFactory->findTemplate(AsciiString(name.c_str()), FALSE);
+					if (tmpl != nullptr) {
+						const ModuleInfo &mi = tmpl->getDrawModuleInfo();
+						for (Int m = 0; m < mi.getCount() && found == nullptr; ++m) {
+							if (mi.getNthName(m).compareNoCase("W3DTreeDraw") == 0) found = (const W3DTreeDrawModuleData *)mi.getNthData(m);
+						}
+					}
+					if (found == nullptr) wsLog("tree %s has no W3DTreeDraw: not drawn", name.c_str());
+					d = m_treeData.insert(std::make_pair(name, found)).first;
+				}
+				data[o.tmpl] = d->second;
+			}
+			if (data[o.tmpl] == nullptr) continue;
+			if (thin && (bush[o.tmpl] || (o.id % 3) != 0)) continue;		// thinned evenly: by the tree's own id
+			if (m_treesDrawn >= cap) break;
+			Coord3D at;
+			at.x = ox + o.x;
+			at.y = oy + o.y;
+			at.z = o.z;
+			TheTerrainRenderObject->addTree(INVALID_DRAWABLE_ID, at, o.scale, o.angle, 0.0f, data[o.tmpl]);
+			++m_treesDrawn;
+		}
+	}
+	m_treesDrawn = TheTerrainRenderObject->streamTreeCount();
+	m_lastTreeMs = (wsNow() - t0) * 1000.0;
+}
+
+/** Create up to `budget` queued objects this frame, so a new strip of town appears over a few frames instead of
+stalling one. */
+void GXWorldStream::createQueued(Int budget)
+{
+	Player *civ = ThePlayerList->findPlayerWithNameKey(NAMEKEY("PlyrCivilian"));
+	if (civ == nullptr) civ = ThePlayerList->getNeutralPlayer();
+	Team *team = civ->getDefaultTeam();
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	while (budget > 0 && !m_createQueue.empty()) {
+		const Pending p = m_createQueue.front();
+		m_createQueue.pop_front();
+		std::map<ChunkKey, Chunk *>::iterator it = m_chunks.find(p.key);
+		if (it == m_chunks.end()) continue;
+		Chunk *c = it->second;
+		if (!c->populated || !inWindow(c->cx, c->cy) || p.index >= c->objects.size()) continue;
+		ChunkObject &o = c->objects[p.index];
+		const Bool ruin = (o.flags & OBJECT_FLAG_DESTROYED) != 0;
+		if (o.created != INVALID_ID || (ruin && o.kind != KIND_BUILDING)) continue;
+		const ThingTemplate *tmpl = TheThingFactory->findTemplate(AsciiString(c->strings[o.tmpl].c_str()), FALSE);
+		if (tmpl == nullptr) continue;
+		Object *obj = TheThingFactory->newObject(tmpl, team);
+		if (obj == nullptr) continue;
+		Coord3D pos;
+		pos.x = (c->cx - m_winCx) * chunkUnits + o.x;
+		pos.y = (c->cy - m_winCy) * chunkUnits + o.y;
+		pos.z = TheTerrainLogic->getGroundHeight(pos.x, pos.y);
+		obj->setOrientation(o.angle);
+		obj->setPosition(&pos);
+		if (ruin) {
+			makeRuin(obj);		// destroyed before: it stands again as what its collapse left (no pathfinder cells)
+			o.created = obj->getID();
+			--budget;
+			continue;
+		}
+		for (BehaviorModule **mod = obj->getBehaviorModules(); *mod; ++mod) {
+			CreateModuleInterface *create = (*mod)->getCreate();
+			if (create != nullptr) create->onBuildComplete();
+		}
+		team->setActive();
+		TheAI->pathfinder()->addObjectToPathfindMap(obj);
+		o.created = obj->getID();
+		--budget;
+	}
+}
+
+/** A building the player destroyed comes back with its chunk as a ruin, not as nothing: drawn as its collapse leaves
+it (POST_COLLAPSE where it has a StructureCollapseUpdate, else RUBBLE), dead (no health bar, no target, no garrison, off
+the radar), and kept out of the pathfinder, as a collapsed building's rubble is walked over. */
+void GXWorldStream::makeRuin(Object *obj)
+{
+	if (obj == nullptr) return;
+	Bool collapses = FALSE;
+	const ModuleInfo &mi = obj->getTemplate()->getBehaviorModuleInfo();
+	for (Int m = 0; m < mi.getCount(); ++m) {
+		if (mi.getNthName(m).compareNoCase("StructureCollapseUpdate") == 0) collapses = TRUE;
+	}
+	Drawable *draw = obj->getDrawable();
+	if (draw != nullptr) {
+		draw->clearModelConditionState(MODELCONDITION_RUBBLE);
+		draw->setModelConditionState(collapses ? MODELCONDITION_POST_COLLAPSE : MODELCONDITION_RUBBLE);
+	}
+	obj->setEffectivelyDead(TRUE);
+}
+
+Object *GXWorldStream::findVehicle()
+{
+	Object *obj = m_vehicleID != INVALID_ID ? TheGameLogic->findObjectByID(m_vehicleID) : nullptr;
+	if (obj != nullptr && !obj->isEffectivelyDead()) return obj;
+	return nullptr;
+}
+
+/** The test vehicle is the centre only while the camera is locked on it. The player who lets the camera go (free
+camera, scrolling away) takes the window along with the camera, like the RTS mode: else the camera could fly past the
+window's end, where nothing can be ordered. Locked again: Ctrl+F9 off. */
+Bool GXWorldStream::followingVehicle()
+{
+	Object *vehicle = findVehicle();
+	if (vehicle == nullptr || m_settings.spawnMode != GXWorldSettings::SPAWN_VEHICLE || !m_settings.followCamera) return FALSE;
+	if (m_cameraFrames > 0) return TRUE;		// the start: the lock is set a few frames in
+	return TheTacticalView != nullptr && TheTacticalView->getCameraLock() == vehicle->getID();
+}
+
+/** The test vehicle selected on the screen (health bar, command bar) but not in the simulation's selection (orders
+go to the simulation's group: it would not obey), or the other way round, for two checks in a row (the simulation
+takes a selection a few frames after the screen): both are made to hold it, as a click on it does - the screen
+selects the drawable, and a select message makes the simulation's group and lets the command translator give orders. */
+void GXWorldStream::checkVehicleSelection()
+{
+	Object *vehicle = findVehicle();
+	Player *local = ThePlayerList != nullptr ? ThePlayerList->getLocalPlayer() : nullptr;
+	if (vehicle == nullptr || local == nullptr || vehicle->getControllingPlayer() != local || vehicle->getDrawable() == nullptr ||
+			TheAI == nullptr || TheInGameUI == nullptr) {
+		m_selectionMismatch = 0;
+		return;
+	}
+	Drawable *draw = vehicle->getDrawable();
+	// the zombie run: with nothing selected at all (two checks in a row) the Humvee is selected again - it is the shop,
+	// and its command bar must not just go away
+	if (TheInGameUI->getSelectCount() == 0) {
+		m_selectionMismatch = 0;
+		return;
+	}
+	const Bool onScreen = draw->isSelected();
+	AIGroupPtr group = TheAI->createGroup();
+#if RETAIL_COMPATIBLE_AIGROUP
+	local->getCurrentSelectionAsAIGroup(group);
+#else
+	local->getCurrentSelectionAsAIGroup(group.Peek());
+#endif
+	const Bool inLogic = group->isMember(vehicle);
+#if RETAIL_COMPATIBLE_AIGROUP
+	TheAI->destroyGroup(group);
+#else
+	group->removeAll();
+#endif
+	if (onScreen == inLogic) {
+		m_selectionMismatch = 0;
+		return;
+	}
+	if (++m_selectionMismatch < 2) return;
+	m_selectionMismatch = 0;
+	wsLog("the test vehicle was selected %s only: selected again in both", onScreen ? "on the screen" : "in the simulation");
+	if (!onScreen) TheInGameUI->selectDrawable(draw);
+	GameMessage *sel = TheMessageStream->appendMessage(GameMessage::MSG_CREATE_SELECTED_GROUP_NO_SOUND);
+	sel->appendBooleanArgument(FALSE);
+	sel->appendObjectIDArgument(vehicle->getID());
+}
+
+/** The test vehicle selected as a click selects it: on the screen, and the simulation's group by a select message
+(the command translator gives orders only to a group it has seen made). Added to what is selected. */
+void GXWorldStream::selectVehicle(Object *vehicle)
+{
+	if (vehicle == nullptr || vehicle->getDrawable() == nullptr || TheInGameUI == nullptr) return;
+	TheInGameUI->selectDrawable(vehicle->getDrawable());
+	GameMessage *sel = TheMessageStream->appendMessage(GameMessage::MSG_CREATE_SELECTED_GROUP_NO_SOUND);
+	sel->appendBooleanArgument(FALSE);
+	sel->appendObjectIDArgument(vehicle->getID());
+}
+
+/** A unit of the local player at the spawn point (on the nearest road), selected. */
+Object *GXWorldStream::spawnUnit(const char *templateName, Real heading)
+{
+	const ThingTemplate *tmpl = TheThingFactory->findTemplate(AsciiString(templateName), FALSE);
+	Player *player = ThePlayerList->getLocalPlayer();
+	if (tmpl == nullptr || player == nullptr) { wsLog("no %s template or no local player", templateName); return nullptr; }
+	Object *obj = TheThingFactory->newObject(tmpl, player->getDefaultTeam());
+	if (obj == nullptr) return nullptr;
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	Coord3D pos;
+	pos.x = (Real)(m_spawnX - (double)m_winCx * chunkUnits);
+	pos.y = (Real)(m_spawnY - (double)m_winCy * chunkUnits);
+	pos.z = TheTerrainLogic->getGroundHeight(pos.x, pos.y);
+	obj->setOrientation(heading);
+	obj->setPosition(&pos);
+	player->getDefaultTeam()->setActive();
+	TheGameLogic->selectObject(obj, TRUE, player->getPlayerMask(), TRUE);
+	// ... and through the message stream, as a click would: the command translator only gives move orders to a
+	// selected group it has seen created (CommandTranslator m_teamExists) - without this the unit took build orders
+	// from its buttons but no move order until the player selected it again by hand
+	GameMessage *sel = TheMessageStream->appendMessage(GameMessage::MSG_CREATE_SELECTED_GROUP);
+	sel->appendBooleanArgument(TRUE);
+	sel->appendObjectIDArgument(obj->getID());
+	wsLog("%s at %.0f,%.0f,%.0f", templateName, pos.x, pos.y, pos.z);
+	return obj;
+}
+
+/** UNITS OUTSIDE THE WINDOW. The map is only the window: a unit the window left behind would stand off the map, where
+the game pulls it back on and hurts it. So it is taken out of the game and kept here - its type, owner, health,
+veterancy, heading and its place in the world - and made again at that very place when the window comes back to it,
+however far away the camera went meanwhile. The world's own buildings come and go with their chunks instead. */
+void GXWorldStream::parkUnitsOutside()
+{
+	if (TheGameLogic == nullptr || ThePlayerList == nullptr) return;
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	const Real extent = m_window * chunkUnits;
+	std::set<ObjectID> world;		// the chunks' buildings
+	for (std::map<ChunkKey, Chunk *>::iterator it = m_chunks.begin(); it != m_chunks.end(); ++it) {
+		const std::vector<ChunkObject> &objs = it->second->objects;
+		for (size_t i = 0; i < objs.size(); ++i) if (objs[i].created != INVALID_ID) world.insert(objs[i].created);
+	}
+	std::vector<Object *> out;
+	for (Object *obj = TheGameLogic->getFirstObject(); obj != nullptr; obj = obj->getNextObject()) {
+		const Coord3D *p = obj->getPosition();
+		if (p->x >= 0.0f && p->y >= 0.0f && p->x < extent && p->y < extent) continue;
+		// (a chunk that left the window destroys its buildings, but they leave the list only at the end of the frame)
+		if (obj->isDestroyed() || obj->isContained() || obj->isEffectivelyDead() || world.find(obj->getID()) != world.end()) continue;
+		if (obj->isKindOf(KINDOF_PROJECTILE) || obj->isKindOf(KINDOF_INERT) || obj->isKindOf(KINDOF_BRIDGE) ||
+				obj->isKindOf(KINDOF_BRIDGE_TOWER)) continue;
+		out.push_back(obj);
+	}
+	for (size_t i = 0; i < out.size(); ++i) {
+		Object *obj = out[i];
+		ParkedUnit u;
+		u.tmpl = obj->getTemplate()->getName().str();
+		Player *owner = obj->getControllingPlayer();
+		u.player = owner != nullptr ? owner->getPlayerIndex() : -1;
+		u.ax = (double)m_winCx * chunkUnits + obj->getPosition()->x;
+		u.ay = (double)m_winCy * chunkUnits + obj->getPosition()->y;
+		u.angle = obj->getOrientation();
+		BodyModuleInterface *body = obj->getBodyModule();
+		u.health = body != nullptr ? body->getHealth() : 0.0f;
+		u.veterancy = obj->getExperienceTracker() != nullptr ? (Int)obj->getExperienceTracker()->getVeterancyLevel() : 0;
+		u.selected = obj->getDrawable() != nullptr && obj->getDrawable()->isSelected();
+		u.vehicle = obj->getID() == m_vehicleID;
+		u.zombie = -1;
+		std::map<ObjectID, Int>::iterator z = m_zByObject.find(obj->getID());
+		if (z != m_zByObject.end()) {		// a zombie: parked, still alive (it counts), not a kill
+			u.zombie = z->second;
+			m_zombies[(size_t)z->second].state = Z_PARKED;
+			m_zombies[(size_t)z->second].obj = INVALID_ID;
+			m_zombies[(size_t)z->second].farSince = 0;
+			m_zByObject.erase(z);
+		}
+		m_parkedUnits.push_back(u);
+		++m_unitsParked;
+		wsLog("unit parked: %s of player %d at %.0f,%.0f, health %.0f", u.tmpl.c_str(), u.player, u.ax, u.ay, u.health);
+		TheGameLogic->destroyObject(obj);
+	}
+}
+
+void GXWorldStream::restoreParkedUnits()
+{
+	if (m_parkedUnits.empty() || TheGameLogic == nullptr || ThePlayerList == nullptr) return;
+	const Real chunkUnits = m_n * MAP_XY_FACTOR;
+	const Real extent = m_window * chunkUnits;
+	const Real inset = 0.5f * chunkUnits;		// well inside, so it is not parked again at once
+	std::vector<Object *> reselect;
+	for (size_t i = 0; i < m_parkedUnits.size();) {
+		const ParkedUnit &u = m_parkedUnits[i];
+		Coord3D pos;
+		pos.x = (Real)(u.ax - (double)m_winCx * chunkUnits);
+		pos.y = (Real)(u.ay - (double)m_winCy * chunkUnits);
+		if (pos.x < inset || pos.y < inset || pos.x > extent - inset || pos.y > extent - inset) { ++i; continue; }
+		const ThingTemplate *tmpl = TheThingFactory->findTemplate(AsciiString(u.tmpl.c_str()), FALSE);
+		Player *player = u.player >= 0 ? ThePlayerList->getNthPlayer(u.player) : nullptr;
+		Object *obj = tmpl != nullptr && player != nullptr ? TheThingFactory->newObject(tmpl, player->getDefaultTeam()) : nullptr;
+		if (obj != nullptr) {
+			pos.z = TheTerrainLogic->getGroundHeight(pos.x, pos.y);
+			obj->setOrientation(u.angle);
+			obj->setPosition(&pos);
+			BodyModuleInterface *body = obj->getBodyModule();
+			if (body != nullptr && u.health > 0.0f && u.health < body->getHealth()) body->internalChangeHealth(u.health - body->getHealth());
+			if (obj->getExperienceTracker() != nullptr && u.veterancy > 0) {
+				obj->getExperienceTracker()->setVeterancyLevel((VeterancyLevel)u.veterancy, FALSE);
+			}
+			++m_unitsRestored;
+			if (u.vehicle) m_vehicleID = obj->getID();
+			if (u.zombie >= 0 && u.zombie < (Int)m_zombies.size()) {		// the same zombie again, from its record
+				m_zombies[(size_t)u.zombie].state = Z_ALIVE;
+				m_zombies[(size_t)u.zombie].obj = obj->getID();
+				m_zByObject[obj->getID()] = u.zombie;
+			}
+			if (u.selected && player == ThePlayerList->getLocalPlayer()) reselect.push_back(obj);
+			wsLog("unit restored: %s of player %d at %.0f,%.0f, health %.0f%s", u.tmpl.c_str(), u.player, u.ax, u.ay, u.health,
+				u.vehicle ? " (the test vehicle)" : "");
+		}
+		m_parkedUnits[i] = m_parkedUnits.back();
+		m_parkedUnits.pop_back();
+	}
+	// selected again - added to what is selected now - and through the message stream, as spawnUnit does (a move order
+	// goes only to a group the command translator has seen made)
+	if (!reselect.empty()) {
+		Player *local = ThePlayerList->getLocalPlayer();
+		GameMessage *sel = TheMessageStream->appendMessage(GameMessage::MSG_CREATE_SELECTED_GROUP);
+		sel->appendBooleanArgument(FALSE);
+		for (size_t k = 0; k < reselect.size(); ++k) {
+			TheGameLogic->selectObject(reselect[k], FALSE, local->getPlayerMask(), TRUE);
+			sel->appendObjectIDArgument(reselect[k]->getID());
+		}
+	}
+}
