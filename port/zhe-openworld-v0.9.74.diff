+// FILE: GXWorldStream.h //////////////////////////////////////////////////////////////////////////
+// GeneralsX @feature ZeroHourEarth 13/11/2026 World Exploration: a seamless open world streamed
+// from real map data.
+//
+// HOW IT WORKS
+//
+//   world server (worldserver/server.py, a companion process on 127.0.0.1)
+//       downloads elevation and map tiles while you drive, cuts the world into 160 m chunks and
+//       sends them over a local socket.
+//   TheWorldStream (this interface; implemented in the device layer, GXWorldStream.cpp)
+//       asks for chunks around the player, keeps them in memory, and owns the window.
+//   the window
+//       the loaded map IS the window: a fixed-size height map (7 x 7 chunks, about 1.1 km) whose
+//       content slides. When the centre of attention - the point the camera looks at, or the
+//       followed vehicle - leaves the middle chunk the world shifts by one chunk:
+//       the height map scrolls, the strip that came in is written from its chunks, and every object,
+//       the camera and everything else that has a position moves the opposite way in the same logic
+//       frame. Nothing reloads and nothing waits: a chunk that is late shows the edge of its
+//       neighbour until it arrives.
+//       The big window (17 x 17 chunks and more; 25 x 25 = 4 km, the default) does not move while the
+//       camera roams it: it shifts only near its edge, by as many chunks as bring the camera back to
+//       its middle. Its town stands only around the camera (GXWorldStream.cpp, THE BIG WINDOW).
+//
+// The game side talks to this interface only. It is null on a build without the device layer
+// (headless tools); every caller checks.
+///////////////////////////////////////////////////////////////////////////////////////////////////
+
+#pragma once
+
+#include "Lib/BaseType.h"
+#include "Common/AsciiString.h"
+#include "Common/UnicodeString.h"
+
+/// The World Exploration screen's dev / sandbox settings (sent with the session, applied when the game starts).
+struct GXWorldSettings
+{
+	enum SpawnMode { SPAWN_FREE_CAMERA = 0, SPAWN_VEHICLE = 1 };
+	Int window;						///< chunks a side of the streamed window, odd, 3..25 (7 = about 1.1 km, 25 = 4 km)
+	Int spawnMode;				///< SpawnMode: RTS / free camera with a scout (default), or the test vehicle
+	Bool followCamera;		///< SPAWN_VEHICLE: the camera follows the vehicle and the window moves with it
+	Bool buildings;
+	Bool roads;
+	Bool trees;						///< trees and bushes are generated (server side): treeMode != TREES_OFF
+	/// TREES_OPTIMIZED: every tree near the camera, a third of them farther out, no bushes there, at most kOptimizedTrees;
+	/// TREES_UNLIMITED: every tree of the window (the tree buffer holds 32,000)
+	enum TreeMode { TREES_OFF = 0, TREES_OPTIMIZED = 1, TREES_UNLIMITED = 2 };
+	Int treeMode;
+	Bool debugOverlay;		///< chunk borders, GPS of the camera centre, counts
+	Bool wireframe;
+	/// the world as the player sees it: all revealed (the old way), all grey (fog: seen only near own units), or
+	/// black where never seen and grey where seen before
+	enum WorldView { VIEW_REVEALED = 0, VIEW_GREY = 1, VIEW_BLACK = 2 };
+	Int worldView;
+	Int darkness;					///< 0..100: the scene's lighting from as it is down to a readable dusk (the HUD stays bright)
+	Bool zombieMode;			///< SPAWN_VEHICLE only: the zombie run (GXWorldZombies; the base map's "Z" variant)
+	Int zombieCap;				///< the zombies alive at once in the whole run, parked ones too (50..3000)
+	Bool keyDriving;			///< SPAWN_VEHICLE, camera locked on it: the arrows drive it (racing-game style, with reverse)
+	GXWorldSettings() : window(25), spawnMode(SPAWN_FREE_CAMERA), followCamera(TRUE), buildings(TRUE), roads(TRUE),
+		trees(TRUE), treeMode(TREES_OPTIMIZED), debugOverlay(FALSE), wireframe(FALSE), worldView(VIEW_REVEALED), darkness(0),
+		zombieMode(FALSE), zombieCap(300), keyDriving(TRUE) {}
+	Bool zombies() const { return zombieMode && spawnMode == SPAWN_VEHICLE; }
+};
+
+struct GXWorldPlace
+{
+	double lat;
+	double lon;
+	UnicodeString name;				///< "Poltar, District of Poltar, ..., Slovakia"
+	AsciiString kind;					///< town, village, peak, ...
+};
+
+class GXWorldStreamInterface
+{
+public:
+	enum State
+	{
+		STATE_OFFLINE,						///< no world server answers on the local port
+		STATE_READY,							///< connected, nothing in flight
+		STATE_SEARCHING,					///< a place search is on its way
+		STATE_OPENING,						///< a session is being opened / its first window is downloading
+		STATE_SESSION_READY,			///< the first window is in memory: the game may start
+		STATE_RUNNING							///< a World Exploration game is being played
+	};
+
+	virtual ~GXWorldStreamInterface() {}
+
+	// ---- the menu
+	virtual void connect() = 0;																///< start (or keep) talking to the world server; never blocks
+	virtual State getState() const = 0;
+	virtual UnicodeString getStatusText() const = 0;					///< one line for the player: what is happening, or what went wrong
+	virtual void search( const UnicodeString &query ) = 0;		///< results arrive later: watch getSearchSerial()
+	virtual Int getSearchSerial() const = 0;									///< changes whenever the list of places was replaced
+	virtual Int getPlaceCount() const = 0;
+	virtual const GXWorldPlace *getPlace( Int index ) const = 0;
+	virtual void open( Int placeIndex ) = 0;									///< open a session there; STATE_SESSION_READY follows
+	virtual void cancel() = 0;																///< forget the session (the menu was closed)
+	virtual Real getOpenProgress() const = 0;									///< 0..1 while STATE_OPENING
+	virtual AsciiString getBaseMapPath() const = 0;						///< the map to start once STATE_SESSION_READY
+	virtual void setSettings( const GXWorldSettings &settings ) = 0;	///< before open(); the window size goes to the server
+	virtual const GXWorldSettings &getSettings() const = 0;
+
+	// ---- the game
+	virtual void onMapLoaded() = 0;														///< GameLogic::startNewGame, just before the load screen ends
+	virtual void logicUpdate() = 0;														///< every logic frame
+	virtual void onGameEnded() = 0;														///< the game data is being cleared
+	virtual Bool isActive() const = 0;												///< a World Exploration game is running
+	virtual void drawOverlay() = 0;														///< client frame, after the 2D UI: the debug overlay
+};
+
+extern GXWorldStreamInterface *TheWorldStream;
+
+/// Device layer: create TheWorldStream if it does not exist yet (called once the terrain visual exists).
+void GXWorldStreamInstall();
