+/// Main menu glue (GXWorldExploreMenu.cpp). MainMenu.cpp calls these; they do nothing without TheWorldStream.
+class GameWindow;
+void GXWorldExploreMenuInit( GameWindow *parentMainMenu, GameWindow *buttonSinglePlayer );
+void GXWorldExploreMenuUpdate();
+Bool GXWorldExploreMenuSelected( GameWindow *control );			///< TRUE if `control` was our button and was handled
+void GXWorldExploreMenuShutdown();
