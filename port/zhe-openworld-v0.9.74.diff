+void RoadSegment::translate(Real dx, Real dy)
+{
+	const Vector2 d(dx, dy);
+	m_pt1.loc += d; m_pt1.top += d; m_pt1.bottom += d;
+	m_pt2.loc += d; m_pt2.top += d; m_pt2.bottom += d;
+	m_info.loc += d;
+	for (Int k = 0; k < NUM_CORNERS; k++) m_info.corners[k] += d;
+	for (Int i = 0; i < m_numVertex; i++) {
+		m_vb[i].x += dx;
+		m_vb[i].y += dy;
+	}
+	m_bounds.Center.X += dx;
+	m_bounds.Center.Y += dy;
+}
