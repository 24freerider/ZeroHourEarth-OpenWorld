+//-------------------------------------------------------------------------------------------------
+// GeneralsX @feature ZeroHourEarth 13/11/2026 The streamed world's edge where the next chunks have not come yet.
+void W3DView::setStreamLimit( const Region2D *limit )
+{
+	if (limit == nullptr)
+	{
+		m_gxLimitOn = FALSE;
+		m_gxLimitPrevValid = FALSE;
+		return;
+	}
+	m_gxLimit = *limit;
+	m_gxLimitOn = TRUE;
+}
+
+/** Moving out toward a limit, the look-at point keeps less and less of each step over the last kSoft units (down to
+a crawl), then stops at the limit; moving back in is never slowed. */
+void W3DView::applyStreamLimit()
+{
+	if (!m_gxLimitOn)
+	{
+		m_gxLimitPrevValid = FALSE;
+		return;
+	}
+	const Real kSoft = 320.0f;		// half a chunk
+	const Real kCrawl = 0.08f;
+	Coord2D pos = getPosition2D();
+	const Coord2D before = pos;
+	if (m_gxLimitPrevValid)
+	{
+		const Coord2D prev = m_gxLimitPrev;
+		Real *p[2] = { &pos.x, &pos.y };
+		const Real q[2] = { prev.x, prev.y };
+		const Real lo[2] = { m_gxLimit.lo.x, m_gxLimit.lo.y };
+		const Real hi[2] = { m_gxLimit.hi.x, m_gxLimit.hi.y };
+		for (Int a = 0; a < 2; ++a)
+		{
+			const Real step = *p[a] - q[a];
+			Real room = 0.0f;
+			if (step > 0.0f) room = hi[a] - q[a];
+			else if (step < 0.0f) room = q[a] - lo[a];
+			else continue;
+			if (room >= kSoft) continue;
+			Real keep = room / kSoft;
+			if (keep < kCrawl) keep = kCrawl;
+			*p[a] = q[a] + step * keep;
+		}
+	}
+	if (pos.x > m_gxLimit.hi.x) pos.x = m_gxLimit.hi.x;
+	if (pos.x < m_gxLimit.lo.x) pos.x = m_gxLimit.lo.x;
+	if (pos.y > m_gxLimit.hi.y) pos.y = m_gxLimit.hi.y;
+	if (pos.y < m_gxLimit.lo.y) pos.y = m_gxLimit.lo.y;
+	if (pos.x != before.x || pos.y != before.y)
+	{
+		setPosition2D(pos);
+		m_recalcCamera = true;
+	}
+	m_gxLimitPrev = pos;
+	m_gxLimitPrevValid = TRUE;
+}
