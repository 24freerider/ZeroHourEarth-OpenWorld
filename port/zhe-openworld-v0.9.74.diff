+	s_grid = CodeGuiButton(s_screen, pad, cy, half, row, "GXWorldExplore:Grid", L"GRID",
+		L"Chunks a side of the streamed area (one chunk = 160 m). A bigger window costs memory and shift time.");
+	s_mode = CodeGuiButton(s_screen, 2 * pad + half, cy, half, row, "GXWorldExplore:Mode", L"MODE",
+		L"RTS / free camera: the world streams around where the camera looks. Test vehicle: drive a Humvee.");
+	cy += row + CodeGuiScaleY(6);
+	s_follow = CodeGuiCheckbox(s_screen, pad, cy, third, row, "GXWorldExplore:Follow", L"Camera follows vehicle", s_settings.followCamera);
+	s_layerBuildings = CodeGuiCheckbox(s_screen, pad + third, cy, third, row, "GXWorldExplore:Buildings", L"Buildings", s_settings.buildings);
+	s_layerRoads = CodeGuiCheckbox(s_screen, pad + 2 * third, cy, third, row, "GXWorldExplore:Roads", L"Roads", s_settings.roads);
+	cy += row + CodeGuiScaleY(6);
+	s_layerTrees = CodeGuiButton(s_screen, pad, cy, third, row, "GXWorldExplore:Trees", L"TREES",
+		L"Optimized: every tree near the camera, a third of them farther out. Unlimited: every tree and bush of the area (slower).");
+	s_debugOverlay = CodeGuiCheckbox(s_screen, pad + third, cy, third, row, "GXWorldExplore:Overlay", L"Debug overlay", s_settings.debugOverlay);
+	s_wireframe = CodeGuiCheckbox(s_screen, pad + 2 * third, cy, third, row, "GXWorldExplore:Wireframe", L"Wireframe", s_settings.wireframe);
+	cy += row + CodeGuiScaleY(6);
