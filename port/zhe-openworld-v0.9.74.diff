+/// One rectangle of water surface (worldserver/chunkgen.py _water): chunk-relative world units, the level in world z.
+struct ChunkWater
+{
+	Real x0, y0, x1, y1, z;
+	UnsignedByte flags;		///< WATER_FLAG_FORD: drawn, but not water to the game's rules (a brook units cross)
+	Real px[4], py[4];		///< a brook's piece: its own four corners down the stream (x0..y1 are their bounds)
+};
