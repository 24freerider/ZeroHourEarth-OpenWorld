+/**
+ * GeneralsX @feature ZeroHourEarth 13/11/2026 World Exploration (GXWorldStream.cpp) slid the height map under the
+ * objects and moved the objects with it. classifyMap() alone keeps a cell an obstacle if it was one, which is now
+ * the wrong cell; so every cell is reset first, the terrain is classified, and each object's footprint is put
+ * back at its new place - what newMap() does for a map that has just been loaded.
+ */
+void Pathfinder::rebuildAfterWorldShift()
+{
+	if (m_map == nullptr || !m_isMapReady) {
+		return;
+	}
+	const Int W = m_extent.hi.x - m_extent.lo.x + 1, H = m_extent.hi.y - m_extent.lo.y + 1;
+	if (W <= 0 || H <= 0) {
+		return;
+	}
+	for (Int j = m_extent.lo.y; j <= m_extent.hi.y; j++) {
+		for (Int i = m_extent.lo.x; i <= m_extent.hi.x; i++) {
+			m_map[i][j].reset();
+		}
+	}
+	// the terrain classes: from the cache, classifying only what changed (classifyMap's own rules, region by region)
+	if (m_gxTerrainW != W || m_gxTerrainH != H || (Int)m_gxTerrain.size() != W * H) {
+		m_gxTerrainW = W;
+		m_gxTerrainH = H;
+		m_gxTerrain.assign((size_t)W * H, 0);
+		m_gxTerrainDirty.clear();
+		gxClassifyTerrainRegion(m_extent);
+	} else {
+		for (size_t k = 0; k < m_gxTerrainDirty.size(); ++k) {
+			IRegion2D r = m_gxTerrainDirty[k];
+			if (r.lo.x > r.hi.x) {
+				r = m_extent;
+			}
+			gxClassifyTerrainRegion(r);
+		}
+	}
+	m_gxTerrainDirty.clear();
+	for (Int i = m_extent.lo.x; i <= m_extent.hi.x; i++) {
+		const UnsignedByte *column = &m_gxTerrain[(size_t)(i - m_extent.lo.x) * H];
+		for (Int j = m_extent.lo.y; j <= m_extent.hi.y; j++) {
+			const UnsignedByte t = column[j - m_extent.lo.y];
+			PathfindCell &cell = m_map[i][j];
+			cell.setType((PathfindCell::CellType)(t & 7));
+			cell.setPinched((t & 8) != 0);
+		}
+	}
+	for (Int i = 0; i < LAYER_LAST; i++) {
+		if (!m_layers[i].isUnused()) {
+			m_layers[i].classifyCells();
+		}
+	}
+	if (!m_layers[LAYER_WALL].isUnused()) {
+		m_layers[LAYER_WALL].classifyWallCells(m_wallPieces, m_numWallPieces);
+	}
+	m_zoneManager.calculateZones(m_map, m_layers, m_extent);
+	for (Object *obj = TheGameLogic->getFirstObject(); obj; obj = obj->getNextObject()) {
+		classifyObjectFootprint(obj, true);
+	}
+}
+
+/** classifyMap()'s terrain rules for the cells of `cells` (clamped to the map), into m_gxTerrain: every cell water or
+cliff by its corners, then clear cells next to a cliff become cliff, then clear cells next to that are pinched. The
+neighbours two cells out decide a cell, so they are classified along (and thrown away). */
+void Pathfinder::gxClassifyTerrainRegion(const IRegion2D &cells)
+{
+	const Int W = m_gxTerrainW, H = m_gxTerrainH;
+	struct L { static Int hi(Int a, Int b) { return a > b ? a : b; } static Int lo(Int a, Int b) { return a < b ? a : b; } };
+	IRegion2D r;
+	r.lo.x = L::hi(cells.lo.x, m_extent.lo.x); r.hi.x = L::lo(cells.hi.x, m_extent.hi.x);
+	r.lo.y = L::hi(cells.lo.y, m_extent.lo.y); r.hi.y = L::lo(cells.hi.y, m_extent.hi.y);
+	if (r.lo.x > r.hi.x || r.lo.y > r.hi.y) return;
+	// working area: two cells around
+	const Int x0 = L::hi(r.lo.x - 2, m_extent.lo.x), x1 = L::lo(r.hi.x + 2, m_extent.hi.x);
+	const Int y0 = L::hi(r.lo.y - 2, m_extent.lo.y), y1 = L::lo(r.hi.y + 2, m_extent.hi.y);
+	const Int w = x1 - x0 + 1, h = y1 - y0 + 1;
+	std::vector<UnsignedByte> type((size_t)w * h), pinched((size_t)w * h, 0);
+	PathfindCell probe;
+	for (Int i = x0; i <= x1; i++) {
+		for (Int j = y0; j <= y1; j++) {
+			classifyMapCell(i, j, &probe);
+			type[(size_t)(i - x0) * h + (j - y0)] = (UnsignedByte)probe.getType();
+		}
+	}
+	const Int cliff = PathfindCell::CELL_CLIFF, clear = PathfindCell::CELL_CLEAR;
+	for (Int pass = 0; pass < 2; ++pass) {
+		for (Int i = 0; i < w; i++) {
+			for (Int j = 0; j < h; j++) {
+				if (!(type[(size_t)i * h + j] & cliff)) continue;
+				for (Int k = i - 1; k <= i + 1; k++) {
+					if (k < 0 || k >= w) continue;
+					for (Int l = j - 1; l <= j + 1; l++) {
+						if (l < 0 || l >= h) continue;
+						if (type[(size_t)k * h + l] == clear) pinched[(size_t)k * h + l] = 1;
+					}
+				}
+			}
+		}
+		if (pass == 0) {
+			for (size_t k = 0; k < type.size(); ++k) {
+				if (pinched[k] && type[k] == clear) type[k] = (UnsignedByte)cliff;
+			}
+		}
+	}
+	for (Int i = r.lo.x; i <= r.hi.x; i++) {
+		for (Int j = r.lo.y; j <= r.hi.y; j++) {
+			const size_t k = (size_t)(i - x0) * h + (j - y0);
+			m_gxTerrain[(size_t)(i - m_extent.lo.x) * H + (j - m_extent.lo.y)] = (UnsignedByte)(type[k] | (pinched[k] ? 8 : 0));
+		}
+	}
+	(void)W;
+}
+
+void Pathfinder::shiftTerrainCache(Int dxCells, Int dyCells)
+{
+	const Int W = m_gxTerrainW, H = m_gxTerrainH;
+	if (W <= 0 || H <= 0 || (Int)m_gxTerrain.size() != W * H) return;
+	if (dxCells <= -W || dxCells >= W || dyCells <= -H || dyCells >= H) {
+		invalidateTerrainCache(nullptr);
+		return;
+	}
+	std::vector<UnsignedByte> moved((size_t)W * H, 0);
+	for (Int i = 0; i < W; i++) {
+		const Int si = i + dxCells;
+		if (si < 0 || si >= W) continue;
+		for (Int j = 0; j < H; j++) {
+			const Int sj = j + dyCells;
+			if (sj < 0 || sj >= H) continue;
+			moved[(size_t)i * H + j] = m_gxTerrain[(size_t)si * H + sj];
+		}
+	}
+	m_gxTerrain.swap(moved);
+	// what came in, and three cells of what it borders (their pinching looks two cells into the new ground)
+	const Int margin = 3;
+	if (dxCells != 0) {
+		IRegion2D r;
+		r.lo.y = m_extent.lo.y; r.hi.y = m_extent.hi.y;
+		if (dxCells > 0) { r.lo.x = m_extent.hi.x - dxCells + 1 - margin; r.hi.x = m_extent.hi.x; }
+		else { r.lo.x = m_extent.lo.x; r.hi.x = m_extent.lo.x - dxCells - 1 + margin; }
+		m_gxTerrainDirty.push_back(r);
+	}
+	if (dyCells != 0) {
+		IRegion2D r;
+		r.lo.x = m_extent.lo.x; r.hi.x = m_extent.hi.x;
+		if (dyCells > 0) { r.lo.y = m_extent.hi.y - dyCells + 1 - margin; r.hi.y = m_extent.hi.y; }
+		else { r.lo.y = m_extent.lo.y; r.hi.y = m_extent.lo.y - dyCells - 1 + margin; }
+		m_gxTerrainDirty.push_back(r);
+	}
+}
+
+void Pathfinder::releaseBridgeLayer(PathfindLayerEnum layer)
+{
+	if (layer > LAYER_GROUND && layer < LAYER_WALL) {
+		m_layers[layer].reset();
+		m_zoneManager.markZonesDirty();
+	}
+}
+
+void Pathfinder::invalidateTerrainCache(const IRegion2D *cells)
+{
+	IRegion2D r;
+	if (cells == nullptr) {
+		r.lo.x = 1; r.hi.x = 0; r.lo.y = 1; r.hi.y = 0;		// everything
+	} else {
+		r.lo.x = cells->lo.x - 3; r.hi.x = cells->hi.x + 3;
+		r.lo.y = cells->lo.y - 3; r.hi.y = cells->hi.y + 3;
+	}
+	m_gxTerrainDirty.push_back(r);
+}
