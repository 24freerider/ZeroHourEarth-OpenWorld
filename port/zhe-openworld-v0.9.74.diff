+void WorldHeightMap::streamWriteHeights(Int x0, Int y0, Int w, Int h, const Real *worldZ)
+{
+	if (m_data == nullptr || worldZ == nullptr) {
+		return;
+	}
+	const Real toSample = 1.0f / MAP_HEIGHT_SCALE;
+	for (Int j = 0; j < h; j++) {
+		const Int y = y0 + j;
+		if (y < 0 || y >= m_height) continue;
+		for (Int i = 0; i < w; i++) {
+			const Int x = x0 + i;
+			if (x < 0 || x >= m_width) continue;
+			Real z = worldZ[j * w + i];
+			if (!(z > -1.0e7f && z < 1.0e7f)) z = 0.0f;	// never NaN into the terrain
+			const HeightSample v = z * toSample;
+			m_data[y * m_width + x] = v;
+			if (v < m_minSample) m_minSample = v;
+			if (v > m_maxSample) m_maxSample = v;
+		}
+	}
+}
