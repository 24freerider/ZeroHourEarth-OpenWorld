+		L"Humvee only: zombies come out of the houses around you. Kill them for money, buy infantry and upgrades from the Humvee.");
+	s_worldView = CodeGuiButton(s_screen, 2 * pad + half, cy, half, row, "GXWorldExplore:WorldView", L"WORLD",
+		L"Revealed: everything visible. Grey: fog everywhere but near your units. Black: what you have not explored yet is black.");
+	cy += row + CodeGuiScaleY(6);
+	s_keyDriving = CodeGuiCheckbox(s_screen, pad, cy, w - 2 * pad, row, "GXWorldExplore:KeyDriving",
+		L"Arrow keys drive the Humvee (camera locked on it): Up ahead, Left / Right steer, Down reverse", s_settings.keyDriving);
+	cy += row + CodeGuiScaleY(6);
+	s_darkLabel =CodeGuiLabel(s_screen, pad, cy, half, row, "GXWorldExplore:DarkLabel", L"", FALSE, 11);
+	s_capLabel = CodeGuiLabel(s_screen, 2 * pad + half, cy, half, row, "GXWorldExplore:CapLabel", L"", FALSE, 11);
+	cy += row;
+	s_darkSlider = CodeGuiHSlider(s_screen, pad, cy, half, row, "GXWorldExplore:Dark", 0, 100);
