+	TheWorldStream->connect();
+
+	const Int w = CodeGuiScaleX(560), h = CodeGuiScaleY(590);
+	const Int x = (CodeGuiScreenW() - w) / 2, y = (CodeGuiScreenH() - h) / 2;
