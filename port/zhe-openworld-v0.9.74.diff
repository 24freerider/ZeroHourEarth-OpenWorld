+struct Chunk
+{
+	Int cx, cy, n;
+	std::vector<std::string> strings;
+	std::vector<ChunkWater> water;
+	std::vector<Real> heights;					///< n * n world z, rows south to north
+	std::vector<UnsignedByte> ground;		///< n * n ground classes
+	std::vector<ChunkLine> lines;
+	std::vector<ChunkObject> objects;
+	Bool applied;												///< its ground is in the window, at the window's current place
+	Bool populated;											///< its objects were queued / created
+	UnsignedInt parkedAt;								///< when it was parked (a serial), for dropping the oldest
+	Bool incomplete;										///< the server lacked some map data (asked again: retryIncomplete)
+	double askedAt;											///< when it came, or was last asked for again
+	size_t cratersDone = 0;							///< the nuke craters (m_craters) already dug into its heights and ground
+	Chunk() :cx(0), cy(0), n(0), applied(FALSE), populated(FALSE), parkedAt(0), incomplete(FALSE), askedAt(0.0) {}
+};
