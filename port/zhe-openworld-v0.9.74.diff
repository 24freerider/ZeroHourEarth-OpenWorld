+
+	bool open(const char *host, int port);							///< blocking connect (a few seconds at most)
+	void close();																				///< safe from another thread: unblocks a pending receive
+	bool isOpen() const { return m_open; }
+	bool sendAll(const void *data, size_t size);
+	bool recvAll(void *data, size_t size);							///< blocks until all of it arrived; false = connection lost
+
+private:
+	GXWorldSocket(const GXWorldSocket &);
+	GXWorldSocket &operator=(const GXWorldSocket &);
+	size_t m_handle;
+	volatile bool m_open;
+};
