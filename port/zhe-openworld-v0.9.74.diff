+void WorldHeightMap::streamWriteGround(Int x0, Int y0, Int w, Int h, const UnsignedByte *cls, const Int *classToTexture, Int numClasses)
+{
+	if (m_tileNdxes == nullptr || cls == nullptr || classToTexture == nullptr) {
+		return;
+	}
+	for (Int j = 0; j < h; j++) {
+		const Int y = y0 + j;
+		if (y < 0 || y >= m_height) continue;
+		for (Int i = 0; i < w; i++) {
+			const Int x = x0 + i;
+			if (x < 0 || x >= m_width) continue;
+			const Int c = cls[j * w + i];
+			const Int tex = c < numClasses ? classToTexture[c] : -1;
+			if (tex < 0 || tex >= m_numTextureClasses) continue;
+			const TXTextureClass &tc = m_textureClasses[tex];
+			if (tc.firstTile < 0 || tc.width <= 0) continue;
+			// The tile of a texture class at a cell, as World Builder lays a texture out: the class is a
+			// width x width grid of tiles, each tile covers 2 x 2 cells.
+			const Int tile = tc.firstTile + ((x >> 1) % tc.width) + tc.width * ((y >> 1) % tc.width);
+			const Int ndx = y * m_width + x;
+			m_tileNdxes[ndx] = (Short)((tile << 2) + 2 * (y & 1) + (x & 1));
+			m_blendTileNdxes[ndx] = 0;
+			m_extraBlendTileNdxes[ndx] = 0;
+			m_cliffInfoNdxes[ndx] = 0;
+		}
+	}
+}
